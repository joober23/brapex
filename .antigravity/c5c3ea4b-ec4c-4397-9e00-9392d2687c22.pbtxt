    content: "            <h2 class=\"serif-title\" style=\"font-size:1.65rem; margin-bottom:12px;\">Pesquise antes de movimentar.</h2>\n            <button class=\"btn-green\" style=\"margin-bottom:12px;\" onclick=\"alert(\'Consulta NCM: Ferro / Insumos \342\200\224 C\303\263digo 7200.00.00 (Al\303\255quota IPI/II conforme acordo Mercosul-Peru).\')\">CONSULTAR NCM</button>\n            <p style=\"font-size:0.82rem; color:var(--text-muted);\">Encontre pontos de partida para as d\303\272vidas mais recorrentes de uma opera\303\247\303\243o internacional.</p>\n        </div>\n\n        <div class=\"form-group\" style=\"margin:0;\">\n            <label>Buscar por produto ou assunto</label>\n            <input type=\"text\" placeholder=\"Ex.: certificado de origem ou alf\303\242ndega Peru\">\n        </div>\n\n        <div class=\"card\" style=\"padding:16px; cursor:pointer;\" onclick=\"navigate(\'screen-docs\')\">\n            <strong style=\"font-size:0.9rem;\">\342\226\270 Documentos de exporta\303\247\303\243o</strong>\n            <p style=\"font-size:0.78rem; color:var(--text-muted); margin-top:4px;\">Documentos comerciais e log\303\255sticos que estruturam a opera\303\247\303\243o.</p>\n        </div>\n\n        <div class=\"card\" style=\"padding:16px; cursor:pointer;\" onclick=\"navigate(\'screen-docs\')\">\n            <strong style=\"font-size:0.9rem;\">\342\226\270 Certificado de origem</strong>\n            <p style=\"font-size:0.78rem; color:var(--text-muted); margin-top:4px;\">Comprova\303\247\303\243o da origem da mercadoria em condi\303\247\303\265es aplic\303\241veis.</p>\n        </div>\n\n        <div class=\"card-dark\" style=\"cursor:pointer;\" onclick=\"navigate(\'screen-perfil\')\">\n            <span class=\"eyebrow\" style=\"color:#A8BDB2;\">MINHA CONTA</span>\n            <h3 class=\"serif-title\" style=\"font-size:1.45rem; margin-bottom:6px;\">Perfil do Usu\303\241rio</h3>\n            <p style=\"font-size:0.8rem; color:#D4DFD9; margin-bottom:14px;\">Gerencie seus dados e prefer\303\252ncias no aplicativo BraPex.</p>\n            <div style=\"background:#F7F1DC; color:#5C4D26; padding:10px 14px; border-radius:10px; font-size:0.76rem; font-weight:600; text-align:center;\">\n                As informa\303\247\303\265es do perfil s\303\243o puxadas automaticamente pelo Gov.\n            </div>\n        </div>\n    </section>\n\n    <!-- TELA 10: PERFIL DO USU\303\201RIO -->\n    <section id=\"screen-perfil\" class=\"screen hidden\" style=\"padding:0;\">\n        <div style=\"background:var(--bg-mint); padding:28px 20px; text-align:center;\">\n            <div style=\"width:68px; height:68px; background:var(--primary-green); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.4rem; font-weight:700; margin:0 auto 12px;\">PA</div>\n            <h3 style=\"font-size:1.1rem;\">Paula Andrades Gomes Oliveira</h3>\n            <p style=\"font-size:0.8rem; color:var(--text-muted);\">paula.andrade@exemplo.com</p>\n        </div>\n\n        <div style=\"padding:20px; display:flex; flex-direction:column; gap:16px;\">\n            <div class=\"card\">\n                <span class=\"eyebrow\" style=\"margin-bottom:12px;\">INFORMA\303\207\303\225ES PESSOAIS</span>\n                <div class=\"form-group\">\n                    <label>Nome completo</label>\n                    <input type=\"text\" value=\"Paula Andrades Gomes oliveira\">\n                </div>\n                <div class=\"form-group\">\n                    <label>E-mail</label>\n                    <input type=\"email\" value=\"paula.andrade@exemplo.com\">\n                </div>\n                <div class=\"form-group\">\n                    <label>CPF/CNPJ</label>\n                    <input type=\"text\" value=\"25478.578.567\">\n                </div>\n                <div class=\"form-group\">\n                    <label>Nome da empresa</label>\n                    <input type=\"text\" placeholder=\"Informe a raz\303\243o social\">\n                </div>\n                <div class=\"form-group\" style=\"margin:0;\">\n                    <label>Localiza\303\247\303\243o</label>\n                    <input type=\"text\" value=\"S\303\243o Paulo, Brasil\">\n                </div>\n            </div>\n\n            <div class=\"card\">\n                <span class=\"eyebrow\" data-i18n=\"profileQuickEyebrow\">ACESSO R\303\201PIDO</span>\n                <div class=\"list-row\" style=\"padding:10px 0; cursor:default; flex-wrap:wrap; gap:10px;\">\n                    <span data-i18n=\"profileChangeLang\">Alterar idioma</span>\n                    <div style=\"display:flex; gap:8px;\">\n                        <button type=\"button\" id=\"btn-lang-pt\" onclick=\"setLanguage(\'pt\')\" style=\"padding:8px 14px; border-radius:10px; border:1px solid var(--primary-dark); background:var(--primary-dark); color:#FFFFFF; font-size:0.8rem; font-weight:600; cursor:pointer;\">Portugu\303\252s</button>\n                        <button type=\"button\" id=\"btn-lang-es\" onclick=\"setLanguage(\'es\')\" style=\"padding:8px 14px; border-radius:10px; border:1px solid var(--border-light); background:#FFFFFF; color:var(--primary-dark); font-size:0.8rem; font-weight:600; cursor:pointer;\">Espanhol</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <footer class=\"app-footer\">\n        <h4>BRAPEX</h4>\n        <p data-i18n=\"footerText\">Demonstra\303\247\303\243o interativa de uma experi\303\252ncia BRAPEX. Consulte especialistas para decis\303\265es operacionais e aduaneiras.</p>\n    </footer>\n\n</div>\n\n<script>\n    let docsAnexados = 0;\n    let brlParaPen = true;\n    let currentLang = \'pt\';\n\n    const I18N_MAP = {\n        pt: {\n            \'Menu BraPex\': \'Menu BraPex\',\n            \'\360\237\217\240 Tela Inicial\': \'\360\237\217\240 Tela Inicial\',\n            \'\360\237\223\212 Intelig\303\252ncia Comercial (Regi\303\243o em Foco)\': \'\360\237\223\212 Intelig\303\252ncia Comercial (Regi\303\243o em Foco)\',\n            \'\360\237\223\246 Produtos de Exporta\303\247\303\243o & Cota\303\247\303\265es\': \'\360\237\223\246 Produtos de Exporta\303\247\303\243o & Cota\303\247\303\265es\',\n            \'\360\237\223\204 Documenta\303\247\303\243o & Fluxo Exporta\303\247\303\243o\': \'\360\237\223\204 Documenta\303\247\303\243o & Fluxo Exporta\303\247\303\243o\',\n            \'\360\237\232\232 Simulador de Frete\': \'\360\237\232\232 Simulador de Frete\',\n            \'\360\237\223\215 Rastreamento & Suporte Chatbot\': \'\360\237\223\215 Rastreamento & Suporte Chatbot\',\n            \'\360\237\223\230 Guia Aduaneiro Digital / NCM\': \'\360\237\223\230 Guia Aduaneiro Digital / NCM\',\n            \'\360\237\221\244 Perfil do Usu\303\241rio (Gov)\': \'\360\237\221\244 Perfil do Usu\303\241rio (Gov)\',\n            \'\360\237\232\252 Sair\': \'\360\237\232\252 Sair\',\n            \'BRAPEX: CONECTANDO SUDOESTE PAULISTA AO FUTURO\': \'BRAPEX: CONECTANDO SUDOESTE PAULISTA AO FUTURO\',\n            \'PORTAL DE OPERA\303\207\303\225ES\': \'PORTAL DE OPERA\303\207\303\225ES\',\n            \'Bem-vindo \303\240 sua rota de confian\303\247a.\': \'Bem-vindo \303\240 sua rota de confian\303\247a.\',\n            \'Do pequeno ao grande empreendedor\': \'Do pequeno ao grande empreendedor\',\n            \'Entrar com o Gov\': \'Entrar com o Gov\',\n            \'Ajuda\': \'Ajuda\',\n            \'Contato\': \'Contato\',\n            \'TELA INICIAL\': \'TELA INICIAL\',\n            \'Ol\303\241, Larissa!\': \'Ol\303\241, Larissa!\',\n            \'DESTAQUE\': \'DESTAQUE\',\n            \'Intelig\303\252ncia Comercial\': \'Intelig\303\252ncia Comercial\',\n            \'Veja quais produtos est\303\243o sendo mais importados e exportados na sua regi\303\243o.\': \'Veja quais produtos est\303\243o sendo mais importados e exportados na sua regi\303\243o.\',\n            \'REFER\303\212NCIA CAMBIAL\': \'REFER\303\212NCIA CAMBIAL\',\n            \'SIMULADO\': \'SIMULADO\',\n            \'Conversor de Moedas\': \'Conversor de Moedas\',\n            \'1 R$ = 0,68 S/. \302\267 taxa simulada de refer\303\252ncia\': \'1 R$ = 0,68 S/. \302\267 taxa simulada de refer\303\252ncia\',\n            \'Converter\': \'Converter\',\n            \'Taxa simulada para demonstra\303\247\303\243o.\': \'Taxa simulada para demonstra\303\247\303\243o.\',\n            \'Radar de Mercado Mundial\': \'Radar de Mercado Mundial\',\n            \'Consulte o PIB, volume de vendas e demandas de produtos por pa\303\255s.\': \'Consulte o PIB, volume de vendas e demandas de produtos por pa\303\255s.\',\n            \'Documenta\303\247\303\243o\': \'Documenta\303\247\303\243o\',\n            \'Consultar documentos necess\303\241rios para exporta\303\247\303\243o e importa\303\247\303\243o.\': \'Consultar documentos necess\303\241rios para exporta\303\247\303\243o e importa\303\247\303\243o.\',\n            \'Rastreamento\': \'Rastreamento\',\n            \'Acompanhar o trajeto do seu produto.\': \'Acompanhar o trajeto do seu produto.\',\n            \'Consulta NCM\': \'Consulta NCM\',\n            \'Classifica\303\247\303\243o fiscal e taxas do produto.\': \'Classifica\303\247\303\243o fiscal e taxas do produto.\',\n            \'Calcule valores entre R$ e S/.\': \'Calcule valores entre R$ e S/.\',\n            \'Simular Frete\': \'Simular Frete\',\n            \'Calcule o custo e a viabilidade por kg.\': \'Calcule o custo e a viabilidade por kg.\',\n            \'RASTREAMENTO\': \'RASTREAMENTO\',\n            \'Sua regi\303\243o em foco\': \'Sua regi\303\243o em foco\',\n            \'Fluxo Brasil (Exporta\303\247\303\243o)\': \'Fluxo Brasil (Exporta\303\247\303\243o)\',\n            \'Fluxo Peru (Importa\303\247\303\243o)\': \'Fluxo Peru (Importa\303\247\303\243o)\',\n            \'Informe sua cidade e seu pa\303\255s\': \'Informe sua cidade e seu pa\303\255s\',\n      