freightOriginLabel: \'Pa\303\255s de origen\',\\n    freightDestLabel: \'Pa\303\255s de destino\',\\n    freightBtn: \'SIMULAR\',\\n    freightWeightError: \'Ingrese el peso del env\303\255o.\',\\n    freightEstimatePrefix: \'Estimaci\303\263n de Flete Internacional:\',\\n    freightEstimateSuffix: \'Plazo estimado: 5 a 7 d\303\255as h\303\241biles (Modal Carretero/Aduanero).\',\\n\\n    // Tela 8\\n    trackEyebrow: \'RASTREO EN TIEMPO REAL\',\\n    trackTitle: \'Visibilidad en cada etapa.\',\\n    trackSub: \'Consulte una l\303\255nea de tiempo demostrativa para seguir el recorrido de una carga.\',\\n    trackTry: \'Pruebe: BRAPEX2026, BR-PE-001 o CARGA123.\',\\n    trackPlaceholder: \'Ingrese el c\303\263digo de rastreo\',\\n    trackBtn: \'Rastrear carga\',\\n    routeEyebrow: \'RUTA ILUSTRATIVA\',\\n    routeTitle: \'Brasil \342\206\222 Per\303\272\',\\n    routeDesc: \'Siga una visualizaci\303\263n demostrativa del desplazamiento internacional de la carga.\',\\n    routeAnimBtn: \'\342\226\267 Animar ruta\',\\n    routePinDest: \'\360\237\223\215 Destino: Per\303\272\',\\n    routePinOrigin: \'\360\237\223\215 Origen: Sudoeste/SP\',\\n    routeReady: \'\342\227\217 Listo para iniciar\',\\n    routeMoving: \'\342\227\217 En tr\303\241nsito...\',\\n    routeArrived: \'\342\227\217 Llegada al destino (Per\303\272)\',\\n    routeFooterNote: \'La ruta est\303\241 lista para animaci\303\263n.\',\\n    chatEyebrow: \'SOPORTE CHATBOT\',\\n    chatTitle: \'Una primera respuesta, cuando la necesita.\',\\n    chatSub: \'Converse con nuestro asistente demostrativo sobre documentaci\303\263n, rastreo, plazos, Per\303\272 y aduana.\',\\n    chatGreeting: \'\302\241Hola! Puedo ayudar con documentaci\303\263n, rastreo y log\303\255stica internacional. \302\277C\303\263mo puedo orientarle?\',\\n    chatPlaceholder: \'Escriba su pregunta\',\\n    chatSendBtn: \'Enviar\',\\n    chatReplyDefault: \'Para operaciones entre el Sudoeste Paulista y Per\303\272, aseg\303\272rese de adjuntar la Factura Comercial y el Certificado de Origen en la pesta\303\261a Documentaci\303\263n.\',\\n    chatReplyDocs: \'Para la ruta Brasil-Per\303\272 se requieren: Factura Comercial, Certificado de Origen ACE 58 y Certificado Fitosanitario MAPA/SENASA.\',\\n    chatReplyPay: \'La tasa oficial es de R$ 245,00 (Tasa de Exportaci\303\263n R$ 180 + Emolumentos R$ 45 + Siscomex R$ 20), pagadera v\303\255a Pix.\',\\n    chatReplyTrack: \'Puede rastrear la carga BRAPEX2026 o Lote BRP-2026-001 directamente en la pesta\303\261a Rastreo con animaci\303\263n del cami\303\263n en el mapa.\',\\n    chatReplyFx: \'La cotizaci\303\263n de referencia es 1 Real (R$) = 0,68 Sol Peruano (S/). Utilice el conversor en la pantalla de inicio.\',\\n\\n    // Tela 9\\n    guideEyebrow: \'GU\303\215A ADUANERA DIGITAL\',\\n    guideTitle: \'Investigue antes de movilizar.\',\\n    guideNcmBtn: \'CONSULTAR NCM\',\\n    guideNcmInfo: \'Consulta NCM: Hierro / Insumos \342\200\224 C\303\263digo 7200.00.00 (Al\303\255cuota IPI/II seg\303\272n acuerdo Mercosur-Per\303\272).\',\\n    guideSub: \'Encuentre puntos de partida para las dudas m\303\241s frecuentes de una operaci\303\263n internacional.\',\\n    guideSearchLabel: \'Buscar por producto o tema\',\\n    guideSearchPlaceholder: \'Ej.: certificado de origen o aduana Per\303\272\',\\n    guideDoc1Title: \'\342\226\270 Documentos de exportaci\303\263n\',\\n    guideDoc1Desc: \'Documentos comerciales y log\303\255sticos que estructuran la operaci\303\263n.\',\\n    guideDoc2Title: \'\342\226\270 Certificado de origen\',\\n    guideDoc2Desc: \'Comprobaci\303\263n del origen de la mercanc\303\255a en condiciones aplicables.\',\\n    guideAccountEyebrow: \'MI CUENTA\',\\n    guideAccountTitle: \'Perfil de Usuario\',\\n    guideAccountDesc: \'Gestione sus datos y preferencias en la aplicaci\303\263n BraPex.\',\\n    guideAccountBanner: \'La informaci\303\263n del perfil se obtiene autom\303\241ticamente desde Gov.\',\\n\\n    // Tela 10\\n    profileInfoEyebrow: \'INFORMACI\303\223N PERSONAL\',\\n    profileNameLabel: \'Nombre completo\',\\n    profileEmailLabel: \'Correo electr\303\263nico\',\\n    profileDocLabel: \'CPF/CNPJ\',\\n    profileCompanyLabel: \'Nombre de la empresa\',\\n    profileCompanyPlaceholder: \'Ingrese la raz\303\263n social\',\\n    profileLocLabel: \'Ubicaci\303\263n\',\\n    profileQuickEyebrow: \'ACCESO R\303\201PIDO\',\\n    profileChangeLang: \'Cambiar idioma\',\\n    btnPortuguese: \'Portugu\303\252s\',\\n    btnSpanish: \'Espanhol\',\\n\\n    // Footer\\n    footerText: \'Demostraci\303\263n interactiva de una experiencia BRAPEX. Consulte a especialistas para decisiones operativas y aduaneras.\'\\n  }\\n} as const;\\n\", \"Description\":\"Create full Portuguese and Spanish translation dictionary for all 10 screens\", \"Overwrite\":true, \"TargetFile\":\"/src/translations.ts\", \"toolAction\":\"Creating translations dictionary\", \"toolSummary\":\"Create src/translations.ts\"}"
