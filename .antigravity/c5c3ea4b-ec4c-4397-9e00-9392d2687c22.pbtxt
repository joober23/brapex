            lines {
              text: "      document.querySelectorAll(\'.nav-btn\').forEach(btn => btn.classList.remove(\'active\'));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const activeBtn = Array.from(document.querySelectorAll(\'.nav-btn\')).find(b => "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        b.getAttribute(\'onclick\')?.includes(screenId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
