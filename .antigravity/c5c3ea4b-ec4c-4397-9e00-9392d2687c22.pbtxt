        replacement_chunks {
          target_content: "            <div class=\"card\">\n                <span class=\"eyebrow\">ACESSO R\303\201PIDO</span>\n                <div class=\"list-row\" style=\"padding:10px 0;\"><span>Alterar idioma</span><span>PT / ES</span></div>\n            </div>\n        </div>\n    </section>\n\n    <footer class=\"app-footer\">\n        <h4>BRAPEX</h4>\n        <p>Demonstra\303\247\303\243o interativa de uma experi\303\252ncia BRAPEX. Consulte especialistas para decis\303\265es operacionais e aduaneiras.</p>\n    </footer>\n\n</div>\n\n<script>\n    let docsAnexados = 0;\n    let brlParaPen = true;\n\n    function navigate(screenId) {\n        document.querySelectorAll(\'.app-shell > section\').forEach(sec => sec.classList.add(\'hidden\'));\n        document.getElementById(screenId).classList.remove(\'hidden\');\n        document.getElementById(\'nav-menu\').classList.add(\'hidden\');\n\n        const navbar = document.getElementById(\'main-navbar\');\n        if (screenId === \'screen-login\') {\n            navbar.classList.add(\'hidden\');\n        } else {\n            navbar.classList.remove(\'hidden\');\n        }\n        window.scrollTo(0, 0);\n    }\n\n    function toggleMenu() {\n        document.getElementById(\'nav-menu\').classList.toggle(\'hidden\');\n    }\n\n    function converterMoeda() {\n        const val = parseFloat(document.getElementById(\'input-brl\').value) || 0;\n        const result = brlParaPen ? (val * 0.68).toFixed(2) + \' S/.\' : \'R$ \' + (val / 0.68).toFixed(2);\n        document.getElementById(\'output-pen\').value = result.replace(\'.\', \',\');\n    }\n\n    function inverterMoeda() {\n        brlParaPen = !brlParaPen;\n        converterMoeda();\n    }\n\n    function setFluxo(btn) {\n        btn.parentElement.querySelectorAll(\'.pill-btn\').forEach(b => b.classList.remove(\'active\'));\n        btn.classList.add(\'active\');\n    }\n\n    function anexarDoc(num, nomeArquivo) {\n        const fileEl = document.getElementById(\'file-\' + num);\n        const badgeEl = document.getElementById(\'badge-\' + num);\n        if (fileEl.innerText === \'Nenhum arquivo selecionado\') {\n            fileEl.innerText = nomeArquivo;\n            badgeEl.innerText = \'Anexado\';\n            badgeEl.style.background = \'#E6F2EB\';\n            badgeEl.style.color = \'#2B4C3B\';\n            docsAnexados++;\n            document.getElementById(\'doc-counter\').innerText = docsAnexados + \' de 3 documentos anexados\';\n            if (docsAnexados === 3) {\n                const glob = document.getElementById(\'doc-global-status\');\n                glob.innerText = \'Conclu\303\255do\';\n                glob.style.background = \'#E6F2EB\';\n                glob.style.color = \'#2B4C3B\';\n            }\n        }\n    }\n\n    function calcularFrete() {\n        const peso = parseFloat(document.getElementById(\'frete-peso\').value) || 0;\n        const res = document.getElementById(\'frete-resultado\');\n        if (peso <= 0) {\n            alert(\'Informe o peso da encomenda.\');\n            return;\n        }\n        const estimativa = (peso * 1.45 + 320).toFixed(2).replace(\'.\', \',\');\n        res.classList.remove(\'hidden\');\n        res.innerHTML = `<strong>Estimativa de Frete Internacional:</strong> R$ ${estimativa} <br><span style=\"font-size:0.75rem; color:#5C6660;\">Prazo estimado: 5 a 7 dias \303\272teis (Modal Rodovi\303\241rio/Aduaneiro).</span>`;\n    }\n\n    function animarRota() {\n        const truck = document.getElementById(\'truck-el\');\n        const status = document.getElementById(\'route-status\');\n        truck.style.left = \'55px\';\n        truck.style.bottom = \'45px\';\n        status.innerText = \'\342\227\217 Em tr\303\242nsito...\';\n        setTimeout(() => {\n            truck.style.left = \'215px\';\n            truck.style.bottom = \'135px\';\n        }, 150);\n        setTimeout(() => {\n            status.innerText = \'\342\227\217 Chegada ao destino (Peru)\';\n        }, 2300);\n    }\n\n    function enviarChat() {\n        const input = document.getElementById(\'chat-msg-input\');\n        const history = document.getElementById(\'chat-history\');\n        if (!input.value.trim()) return;\n\n        const userBubble = document.createElement(\'div\');\n        userBubble.style.cssText = \'background:#1A3026; color:white; padding:10px 12px; border-radius:12px; font-size:0.8rem; align-self:flex-end; max-width:85%;\';\n        userBubble.innerText = input.value;\n        history.appendChild(userBubble);\n\n        input.value = \'\';\n        history.scrollTop = history.scrollHeight;\n\n        setTimeout(() => {\n            const botBubble = document.createElement(\'div\');\n            botBubble.style.cssText = \'background:#FFFFFF; padding:10px 12px; border-radius:12px; font-size:0.8rem; max-width:85%;\';\n            botBubble.innerText = \'Para opera\303\247\303\265es entre o Sudoeste Paulista e o Peru, certifique-se de anexar a Invoice Comercial e o Certificado de Origem na aba Documenta\303\247\303\243o.\';\n            history.appendChild(botBubble);\n            history.scrollTop = history.scrollHeight;\n        }, 600);\n    }\n</script>\n\n</body>\n</html>"
          replacement_content: "            <div class=\"card\">\n                <span class=\"eyebrow\" data-i18n=\"profileQuickEyebrow\">ACESSO R\303\201PIDO</span>\n                <div class=\"list-row\" style=\"padding:10px 0; cursor:default; flex-wrap:wrap; gap:10px;\">\n                    <span data-i18n=\"profileChangeLang\">Alterar idioma</span>\n                    <div style=\"display:flex; gap:8px;\">\n                        <button type=\"button\" id=\"btn-lang-pt\" onclick=\"setLanguage(\'pt\')\" style=\"padding:8px 14px; border-radius:10px; border:1px solid var(--primary-dark); background:var(--primary-dark); color:#FFFFFF; font-size:0.8rem; font-weight:600; cursor:pointer;\">Portugu\303\252s</button>\n                        <button type=\"button\" id=\"btn-lang-es\" onclick=\"setLanguage(\'es\')\" style=\"padding:8px 14px; border-radius:10px; border:1px solid var(--border-light); background:#FFFFFF; color:var(--primary-dark); font-size:0.8rem; font-weight:600; cursor:pointer;\">Espanhol</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <footer class=\"app-footer\">\n        <h4>BRAPEX</h4>\n        <p data-i18n=\"footerText\">Demonstra\303\247\303\243o interativa de uma experi\303\252ncia BRAPEX. Consulte especialistas para decis\303\265es operacionais e aduaneiras.</p>\n    </footer>\n\n</div>\n\n<script>\n    let docsAnexados = 0;\n    let brlParaPen = true;\n    let currentLang = \'pt\';\n\n    const I18N_MAP = {\n        pt: {\n            \'Menu BraPex\': \'Menu BraPex\',\n            \'\360\237\217\240 Tela Inicial\': \'\360\237\217\240 Tela Inicial\',\n            \'\360\237\223\212 Intelig\303\252ncia Comercial (Regi\303\243o em Foco)\': \'\360\237\223\212 Intelig\303\252ncia Comercial (Regi\303\243o em Foco)\',\n            \'\360\237\223\246 Produtos de Exporta\303\247\303\243o & Cota\303\247\303\265es\': \'\360\237\223\246 Produtos de Exporta\303\247\303\243o & Cota\