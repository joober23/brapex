        replacement_chunks {
          target_content: "    function converterMoeda() {\n        const val = parseFloat(document.getElementById(\'input-brl\').value) || 0;\n        const result = brlParaPen ? (val * 0.68).toFixed(2) + \' S/.\' : \'R$ \' + (val / 0.68).toFixed(2);\n        document.getElementById(\'output-pen\').value = result.replace(\'.\', \',\');\n    }\n\n    function inverterMoeda() {\n        brlParaPen = !brlParaPen;\n        converterMoeda();\n    }"
          replacement_content: "    let fxRate = 0.68;\n    let fxIsLive = false;\n\n    function parseCurrencyAmount(raw) {\n        const cleaned = String(raw || \'\').trim().replace(/[^\\d.,]/g, \'\');\n        if (!cleaned) return 0;\n        if (cleaned.includes(\',\') && cleaned.includes(\'.\')) {\n            if (cleaned.lastIndexOf(\',\') > cleaned.lastIndexOf(\'.\')) {\n                return parseFloat(cleaned.replace(/\\./g, \'\').replace(\',\', \'.\')) || 0;\n            }\n            return parseFloat(cleaned.replace(/,/g, \'\')) || 0;\n        }\n        if (cleaned.includes(\',\')) {\n            return parseFloat(cleaned.replace(\',\', \'.\')) || 0;\n        }\n        return parseFloat(cleaned) || 0;\n    }\n\n    function formatBrNumber(num, decimals) {\n        const d = typeof decimals === \'number\' ? decimals : 2;\n        return num.toLocaleString(\'pt-BR\', { minimumFractionDigits: d, maximumFractionDigits: d });\n    }\n\n    function formatFxOutput(val) {\n        return brlParaPen ? formatBrNumber(val * fxRate, 2) + \' S/.\' : \'R$ \' + formatBrNumber(val / fxRate, 2);\n    }\n\n    function updateFxTexts() {\n        const badge = document.getElementById(\'fx-badge\');\n        const sub = document.getElementById(\'fx-subtitle\');\n        const fromLbl = document.getElementById(\'fx-label-from\');\n        const toLbl = document.getElementById(\'fx-label-to\');\n        const note = document.getElementById(\'fx-note\');\n        const dec = fxIsLive ? 4 : 2;\n        if (badge) {\n            badge.innerText = fxIsLive ? (currentLang === \'es\' ? \'ACTUALIZADO\' : \'ATUALIZADO\') : \'SIMULADO\';\n        }\n        if (sub) {\n            const pair = brlParaPen\n                ? \'1 R$ = \' + formatBrNumber(fxRate, dec) + \' S/.\'\n                : \'1 S/. = R$ \' + formatBrNumber(1 / fxRate, dec);\n            const desc = fxIsLive\n                ? (currentLang === \'es\' ? \'cotizaci\303\263n de mercado\' : \'cota\303\247\303\243o de mercado\')\n                : (currentLang === \'es\' ? \'tasa de referencia\' : \'taxa de refer\303\252ncia\');\n            sub.innerText = pair + \' \302\267 \' + desc;\n        }\n        if (fromLbl && toLbl) {\n            fromLbl.innerText = brlParaPen ? \'Real (R$)\' : \'Sol Peruano (S/.)\';\n            toLbl.innerText = brlParaPen ? \'Sol Peruano (S/.)\' : \'Real (R$)\';\n        }\n        if (note) {\n            note.innerText = fxIsLive\n                ? (currentLang === \'es\' ? \'Cotizaci\303\263n actualizada en tiempo real (BRL \342\206\224 PEN).\' : \'Cota\303\247\303\243o atualizada em tempo real (BRL \342\206\224 PEN).\')\n                : (currentLang === \'es\' ? \'Tasa de referencia para demostraci\303\263n.\' : \'Taxa de refer\303\252ncia para demonstra\303\247\303\243o.\');\n        }\n    }\n\n    function handleBrlInput() {\n        const val = parseCurrencyAmount(document.getElementById(\'input-brl\').value);\n        document.getElementById(\'output-pen\').value = formatFxOutput(val);\n        const box = document.getElementById(\'fx-result-box\');\n        if (box && !box.classList.contains(\'hidden\')) {\n            converterMoeda();\n        }\n    }\n\n    function converterMoeda() {\n        const val = parseCurrencyAmount(document.getElementById(\'input-brl\').value);\n        const box = document.getElementById(\'fx-result-box\');\n        if (val <= 0) {\n            document.getElementById(\'output-pen\').value = brlParaPen ? \'0,00 S/.\' : \'R$ 0,00\';\n            if (box) {\n                box.classList.remove(\'hidden\');\n                box.style.background = \'rgba(253,240,230,0.14)\';\n                box.style.borderColor = \'rgba(255,190,140,0.45)\';\n                box.innerHTML = \'<span style=\"color:#FFD8B8; font-size:0.78rem; font-weight:600;\">\' +\n                    (currentLang === \'es\' ? \'Ingrese un monto mayor que cero para convertir.\' : \'Informe um valor maior que zero para converter.\') +\n                    \'</span>\';\n            }\n            return;\n        }\n        const out = formatFxOutput(val);\n        document.getElementById(\'output-pen\').value = out;\n        if (box) {\n            const fromText = brlParaPen ? \'R$ \' + formatBrNumber(val, 2) : \'S/. \' + formatBrNumber(val, 2);\n            const label = brlParaPen\n                ? (currentLang === \'es\' ? \'Convertido a Sol Peruano:\' : \'Convertido para Sol Peruano:\')\n                : (currentLang === \'es\' ? \'Convertido a Real:\' : \'Convertido para Real:\');\n            box.classList.remove(\'hidden\');\n            box.style.background = \'rgba(230,236,231,0.14)\';\n            box.style.borderColor = \'rgba(168,189,178,0.45)\';\n            box.innerHTML = \'<div style=\"display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap;\">\' +\n                \'<span style=\"color:#D4DFD9; font-size:0.76rem;\">\' + label + \'</span>\' +\n                \'<strong style=\"font-size:0.96rem; color:#FFFFFF;\">\' + fromText + \' = \' + out + \'</strong></div>\';\n        }\n    }\n\n    function inverterMoeda() {\n        brlParaPen = !brlParaPen;\n        updateFxTexts();\n        const val = parseCurrencyAmount(document.getElementById(\'input-brl\').value);\n        document.getElementById(\'output-pen\').value = formatFxOutput(val);\n        const box = document.getElementById(\'fx-result-box\');\n        if (box && !box.classList.contains(\'hidden\')) {\n            converterMoeda();\n        }\n    }\n\n    (function loadLiveFxRate() {\n        fetch(\'https://open.er-api.com/v6/latest/BRL\')\n            .then(r => r.ok ? r.json() : null)\n            .then(d => {\n                const pen = Number(d && d.rates && d.rates.PEN);\n                if (Number.isFinite(pen) && pen > 0) {\n                    fxRate = pen;\n                    fxIsLive = true;\n                    updateFxTexts();\n                    handleBrlInput();\n                    return true;\n                }\n                return false;\n            })\n            .catch(() => false)\n            .then(ok => {\n                if (ok) return;\n                return fetch(\'https://economia.awesomeapi.com.br/json/last/BRL-PEN\')\n                    .then(r => r.ok ? r.json() : null)\n                    .then(d => {\n                        const pen2 = Number(d && d.BRLPEN && d.BRLPEN.bid);\n                        if (Number.isFinite(pen2) && pen2 > 0) {\n                            fxRate = pen2;\n                            fxIsLive = true;\n                            updateFxTexts();\n                            handleBrlInput();\n                        }\n                    })\n                    .catch(() => {});\n            });\n    })();"
          start_line: 1139
          end_line: 1150
        }
      }
    }
