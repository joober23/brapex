        instruction: "export interface ProductItem {\n  id: string;\n  name: string;\n  category: \'minerios\' | \'agro\' | \'pesca\' | \'industria\';\n  origin: string;\n  destination: string;\n  supplier: string;\n  location: string;\n  ncm: string;\n  ncmDescription: string;\n  pricePerUnit: number;\n  unit: string;\n  currency: \'USD\' | \'BRL\';\n  minOrder: number;\n  stockStatus: string;\n  leadTimeDays: number;\n  routeType: \'PE_TO_ITP\' | \'ITP_TO_PE\';\n  description: string;\n  taxBenefit: string;\n}\n\nexport interface TrackingShipment {\n  code: string;\n  title: string;\n  route: string;\n  origin: string;\n  destination: string;\n  status: \'EM_TRANSITO\' | \'DESEMBARACO\' | \'ENTREGUE\' | \'EMBARCANDO\';\n  statusLabel: string;\n  progressPercent: number;\n  carrier: string;\n  transportMode: \'RODOVIARIO\' | \'MARITIMO\';\n  eta: string;\n  updatedAt: string;\n  currentLocation: string;\n  coordinates: { lat: number; lng: number };\n  telemetry: {\n    temperature?: string;\n    speed?: string;\n    lastCheckpoint: string;\n  };\n  events: {\n    date: string;\n    time: string;\n    location: string;\n    description: string;\n    completed: boolean;\n  }[];\n}\n\nexport const PRODUCTS_CATALOG: ProductItem[] = [\n  {\n    id: \'prod-1\',\n    name: \'Ferro & Insumos Minerais Concentrados\',\n    category: \'minerios\',\n    origin: \'San Juan de Marcona, Peru\',\n    destination: \'Itapetininga, SP - Brasil\',\n    supplier: \'Shougang Hierro Per\303\272 S.A.A.\',\n    location: \'Ica / Porto de San Nicol\303\241s, Peru\',\n    ncm: \'7201.10.00\',\n    ncmDescription: \'Ferro fundido bruto n\303\243o ligado, com teor de f\303\263sforo \342\211\244 0,5% em peso\',\n    pricePerUnit: 850,\n    unit: \'tonelada\',\n    currency: \'USD\',\n    minOrder: 25,\n    stockStatus: \'Dispon\303\255vel em lote para embarque imediato\',\n    leadTimeDays: 16,\n    routeType: \'PE_TO_ITP\',\n    description: \'Min\303\251rio de ferro de alta pureza (Fe 66.5%),