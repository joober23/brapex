            }
            lines {
              text: "    chatReplyPay: \'La tasa oficial es de R$ 245,00 (Tasa de Exportaci\303\263n R$ 180 + Emolumentos R$ 45 + Siscomex R$ 20), pagadera v\303\255a Pix.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chatReplyTrack: \'Puede rastrear la carga BRAPEX2026 o Lote BRP-2026-001 directamente en la pesta\303\261a Rastreo con animaci\303\263n del cami\303\263n en el mapa.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chatReplyFx: \'La cotizaci\303\263n de referencia es 1 Real (R$) = 0,68 Sol Peruano (S/). Utilice el conversor en la pantalla de inicio.\',"
