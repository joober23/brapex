            }
            lines {
              text: "    response: \'As taxas governamentais padr\303\243o para o tr\303\242mite aduaneiro simplificado s\303\243o: Taxa de Exporta\303\247\303\243o (R$ 180,00), Emolumentos GOV (R$ 45,00) e Taxa de Servi\303\247o Siscomex (R$ 20,00), totalizando R$ 245,00. O pagamento pode ser feito via Pix instant\303\242neo, QR Code ou GRU/Boleto Banc\303\241rio diretamente pelo portal.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
