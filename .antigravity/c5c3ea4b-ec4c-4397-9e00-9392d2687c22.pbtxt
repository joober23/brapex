              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          botBubble.innerText = \'Entendido. Nossa equipe em Itapetininga e os operadores aduaneiros est\303\243o dispon\303\255veis para dar suporte completo \303\240 sua opera\303\247\303\243o.\';"
