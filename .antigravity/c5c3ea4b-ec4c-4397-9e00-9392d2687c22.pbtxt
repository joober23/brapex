              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const result = brlParaPen ? (val * 0.68).toFixed(2) + \' S/.\' : \'R$ \' + (val / 0.68).toFixed(2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        document.getElementById(\'output-pen\').value = result.replace(\'.\', \',\');"
