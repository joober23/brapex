  planner_response {
    thinking: "**Defining App Structure**\n\nI\'m currently focused on defining the exact structure of `src/App.tsx`. I\'m meticulously ensuring it replicates the specified 10 screens and layout, adhering precisely to the provided HTML, classes, typography, text, and colors, starting with the app shell using the provided max-width.\n\n\n**Outlining Key App Screens**\n\nI\'m now outlining the key app screens and their content. I\'ve defined the modal/menu overlay and navbar components. I\'m moving on to `screen-login`, and I\'m listing all the screen components, typography and content. I am currently fleshing out the remaining screens and their components, including the dashboard and intelligence screens.\n\n\n**Mapping New Screens**\n\nI am currently working on `screen-docs`, outlining the \"GEST\303\203O DE DOCUMENTA\303\207\303\203O\" checklist, including the export process specifics and dynamic counters and the \"IR PARA PAGAMENTO\" button. Moving on, I\'m defining `screen-pagamento` with its payment methods (Pix, QR Code, Boleto), focusing on the Pix card with a copyable code. Finally, I\'m detailing the `screen-frete` simulator and the `screen-rastreamento` components, including the animated route map.\n\n\n"
    tool_calls {
      id: "call_99500724522176525"
      name: "write_to_file"
      arguments_json: "{\"Append\":false, \"CodeContent\":\"import React, { useState } from \'react\';\\n\\nexport default function App() {\\n  const [currentScreen, setCurrentScreen] = useState<string>(\'screen-login\');\\n  const [isMenuOpen, setIsMenuOpen] = useState<boolean>(false);\\n  \\n  // Conversor de Moedas\\n  const [brlVal, setBrlVal] = useState<string>(\'100\');\\n  const [penVal, setPenVal] = useState<string>(\'68,00 S/.\');\\n  const [brlParaPen, setBrlParaPen] = useState<boolean>(true);\\n\\n  // Intelig\303\252ncia Comercial\\n  const [fluxoBrasil, setFluxoBrasil] = useState<boolean>(true);\\n  const [selectedItems, setSelectedItems] = useState<Record<string, boolean>>({});\\n\\n  // Documenta\303\247\303\243o e Anexos\\n  const [doc1Attached, setDoc1Attached] = useState<boolean>(false);\\n  const [doc2Attached, setDoc2Attached] = useState<boolean>(false);\\n  const [doc3Attached, setDoc3Attached] = useState<boolean>(false);\\n\\n  // Frete\\n  const [freteProd, setFreteProd] = useState<string>(\'\');\\n  const [freteValor, setFreteValor] = useState<string>(\'\');\\n  const [fretePeso, setFretePeso] = useState<string>(\'\');\\n  const [freteOrigem, setFreteOrigem] = useState<string>(\'Brasil\');\\n  const [freteDestino, setFreteDestino] = useState<string>(\'Peru\');\\n  const [freteResultado, setFreteResultado] = useState<string | null>(null);\\n\\n  // Rastreamento e Rota\\n  const [trackCode, setTrackCode] = useState<string>(\'BRAPEX2026\');\\n  const [truckPos, setTruckPos] = useState<{ left: string; bottom: string }>({ left: \'55px\', bottom: \'45px\' });\\n  const [routeStatus, setRouteStatus] = useState<string>(\'\342\227\217 Pronto para iniciar\');\\n\\n  // Chatbot\\n  const [chatMessages, setChatMessages] = useState<Array<{ sender: \'bot\' | \'user\'; text: string }>>([\\n    {\\n      sender: \'bot\',\\n      text: \'Ol\303\241! Posso ajudar com documenta\303\247\303\243o, rastreamento e log\303\255stica internacional. Como posso orientar voc\303\252?\'\\n    }\\n  ]);\\n  const [chatInput, setChatInput] = useState<string>(\'\');\\n\\n  // Total docs\\n  const totalDocs = (doc1Attached ? 1 : 0) + (doc2Attached ? 1 : 0) + (doc3Attached ? 1 : 0);\\n\\n  // Navega\303\247\303\243o\\n  const navigate = (screenId: string) => {\\n    setCurrentScreen(screenId);\\n    setIsMenuOpen(false);\\n    window.scrollTo(0, 0);\\n  };\\n\\n  const toggleMenu = () => {\\n    setIsMenuOpen(!isMenuOpen);\\n  };\\n\\n  // Fun\303\247\303\265es de C\303\242mbio\\n  const handleBrlChange = (valStr: string) => {\\n    setBrlVal(valStr);\\n    const val = parseFloat(valStr) || 0;\\n    if (brlParaPen) {\\n      setPenVal((val * 0.68).toFixed(2).replace(\'.\', \',\') + \' S/.\');\\n    } else {\\n      setPenVal(\'R$ \' + (val / 0.68).toFixed(2).replace(\'.\', \',\'));\\n    }\\n  };\\n\\n  const inverterMoeda = () => {\\n    const nextMode = !brlParaPen;\\n    setBrlParaPen(nextMode);\\n    const val = parseFloat(brlVal) || 0;\\n    if (nextMode) {\\n      setPenVal((val * 0.68).toFixed(2).replace(\'.\', \',\') + \' S/.\');\\n    } else {\\n      setPenVal(\'R$ \' + (val / 0.68).toFixed(2).replace(\'.\', \',\'));\\n    }\\n  };\\n\\n  const converterMoeda = () => {\\n    const val = parseFloat(brlVal) || 0;\\n    if (brlParaPen) {\\n      setPenVal((val * 0.68).toFixed(2).replace(\'.\', \',\') + \' S/.\');\\n    } else {\\n      setPenVal(\'R$ \' + (val / 0.68).toFixed(2).replace(\'.\', \',\'));\\n    }\\n  };\\n\\n  // Frete\\n  const calcularFrete = () => {\\n    const peso = parseFloat(fretePeso) || 0;\\n    if (peso <= 0) {\\n      alert(\'Informe o peso da encomenda.\');\\n      return;\\n    }\\n    const estimativa = (peso * 1.45 + 320).toFixed(2).replace(\'.\', \',\');\\n    setFreteResultado(\\n      `Estimativa de Frete Internacional: R$ ${estimativa} | Prazo estimado: 5 a 7 dias \303\272teis (Modal Rodovi\303\241rio/Aduaneiro).`\\n    );\\n  };\\n\\n  // Anima\303\247\303\243o de Rota\\n  const animarRota = () => {\\n    setTruckPos({ left: \'55px\', bottom: \'45px\' });\\n    setRouteStatus(\'\342\227\217 Em tr\303\242nsito...\');\\n    setTimeout(() => {\\n      setTruckPos({ left: \'215px\', bottom: \'135px\' });\\n    }, 150);\\n    setTimeout(() => {\\n      setRouteStatus(\'\342\227\217 Chegada ao destino (Peru)\');\\n    }, 2300);\\n  };\\n\\n  // Enviar Chat\\n  const enviarChat = () => {\\n    if (!chatInput.trim()) return;\\n    const text = chatInput.trim();\\n    setChatMessages((prev) => [...prev, { sender: \'user\', text }]);\\n    setChatInput(\'\');\\n\\n    setTimeout(() => {\\n      let reply = \'Para opera\303\247\303\265es entre o Sudoeste Paulista e o Peru, certifique-se de anexar a Invoice Comercial e o Certificado de Origem na aba Documenta\303\247\303\243o.\';\\n      const q = text.toLowerCase();\\n      if (q.includes(\'document\') || q.includes(\'invoice\') || q.includes(\'origem\')) {\\n        reply = \'Para a rota Brasil-Peru s\303\243o exigidos: Invoice Comercial, Certificado de Origem ACE 58 e Laudo Fitossanit\303\241rio MAPA/SENASA.\';\\n      } else if (q.includes(\'taxa\') || q.includes(\'pix\') || q.includes(\'245\')) {\\n        reply = \'A taxa oficial \303\251 de R$ 245,00 (Taxa Exporta\303\247\303\243o R$ 180 + Emolumentos R$ 45 + Siscomex R$ 20), pag\303\241vel via Pix.\';\\n      } else if (q.includes(\'rastreio\') || q.includes(\'brapex2026\') || q.includes(\'lote\')) {\\n        reply = \'Voc\303\252 pode rastrear a carga BRAPEX2026 ou Lote BRP-2026-001 diretamente na aba Rastreamento com anima\303\247\303\243o do caminh\303\243o no mapa.\';\\n      } else if (q.includes(\'moeda\') || q.includes(\'sol\') || q.includes(\'cambio\')) {\\n        reply = \'A cota\303\247\303\243o de refer\303\252ncia \303\251 1 Real (R$) = 0,68 Sol Peruano (S/). Utilize o conversor na tela inicial.\';\\n      }\\n\\n      setChatMessages((prev) => [...prev, { sender: \'bot\', text: reply }]);\\n    }, 600);\\n  };\\n\\n  const copyPix = () => {\\n    navigator.clipboard?.writeText(\'00020126580014br.gov.bcb.pix0136brapex-receita-gov@tesouro.gov.br5204000053039865406245.005802BR5925BRAPEX LOGISTICA ITAPETI6009SAO PAULO62140510BRAPEX2026\');\\n    alert(\'C\303\263digo Pix Copia e Cola copiado!\');\\n  };\\n\\n  return (\\n    <div className=\\\"app-shell\\\">\\n      \\n      {/* MENU OVERLAY */}\\n      {isMenuOpen && (\\n        <div id=\\\"nav-menu\\\" className=\\\"menu-overlay\\\" onClick={toggleMenu}>\\n          <div className=\\\"menu-panel\\\" onClick={(e) => e.stopPropagation()}>\\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', marginBottom: \'10px\' }}>\\n              <strong style={{ fontSize: \'1.1rem\' }}>Menu BraPex</strong>\\n              <button className=\\\"icon-btn\\\" onClick={toggleMenu}>\342\234\225</button>\\n            </div>\\n            <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-dashboard\')}>\360\237\217\240 Tela Inicial</button>\\n            <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-inteligencia\')}>\360\237\223\212 Intelig\303\252ncia Comercial (Regi\303\243o em Foco)</button>\\n            <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-produtos\')}>\360\237\223\246 Produtos de Exporta\303\247\303\243o & Cota\303\247\303\265es</button>\\n            <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-docs\')}>\360\237\223\204 Documenta\303\247\303\243o & Fluxo Exporta\303\247\303\243o</button>\\n            <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-frete\')}>\360\237\232\232 Simulador de Frete</button>\\n            <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-rastreamento\')}>\360\237\223\215 Rastreamento & Suporte Chatbot</button>\\n            <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-guia\')}>\360\237\223\230 Guia Aduaneiro Digital / NCM</button>\\n            <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-perfil\')}>\360\237\221\244 Perfil do Usu\303\241rio (Gov)</button>\\n            <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\', color: \'#A33\' }} onClick={() => navigate(\'screen-login\')}>\360\237\232\252 Sair</button>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* NAVBAR */}\\n      {currentScreen !== \'screen-login\' && (\\n        <header id=\\\"main-navbar\\\" className=\\\"navbar\\\">\\n          <span className=\\\"brand-logo\\\" onClick={() => navigate(\'screen-dashboard\')}>BraPex</span>\\n          <div className=\\\"nav-actions\\\">\\n            <button className=\\\"icon-btn\\\" title=\\\"Perfil do Usu\303\241rio\\\" onClick={() => navigate(\'screen-perfil\')}>\360\237\221\244</button>\\n            <button className=\\\"icon-btn\\\" title=\\\"Menu\\\" onClick={toggleMenu}>\342\230\260</button>\\n          </div>\\n        </header>\\n      )}\\n\\n      {/* TELA 1: ENTRADA / LOGIN */}\\n      {currentScreen === \'screen-login\' && (\\n        <section id=\\\"screen-login\\\" style={{ display: \'flex\', flexDirection: \'column\', flex: 1 }}>\\n          <div className=\\\"login-hero\\\">\\n            <h1>BRAPEX: CONECTANDO SUDOESTE PAULISTA AO FUTURO</h1>\\n          </div>\\n          <div style={{ padding: \'20px\', marginTop: \'-24px\' }}>\\n            <div style={{ width: \'44px\', height: \'44px\', background: \'var(--primary-dark)\', color: \'white\', borderRadius: \'12px\', display: \'flex\', alignItems: \'center\', justifyContent: \'center\', marginBottom: \'16px\', fontWeight: \'bold\' }}>\\n              \342\207\204\\n            </div>\\n            <div className=\\\"card\\\" style={{ textAlign: \'center\' }}>\\n              <span className=\\\"eyebrow\\\">PORTAL DE OPERA\303\207\303\225ES</span>\\n              <h2 className=\\\"serif-title\\\" style={{ fontSize: \'1.65rem\', marginBottom: \'10px\' }}>Bem-vindo \303\240 sua rota de confian\303\247a.</h2>\\n              <p style={{ fontSize: \'0.88rem\', color: \'var(--text-muted)\', marginBottom: \'22px\' }}>Do pequeno ao grande empreendedor</p>\\n              <button className=\\\"btn-primary\\\" style={{ marginBottom: \'14px\' }} onClick={() => navigate(\'screen-dashboard\')}>\\n                Entrar com o Gov\\n              </button>\\n              <div style={{ display: \'flex\', gap: \'10px\' }}>\\n                <button className=\\\"btn-outline\\\" onClick={() => navigate(\'screen-guia\')}>Ajuda</button>\\n                <button className=\\\"btn-outline\\\" onClick={() => navigate(\'screen-rastreamento\')}>Contato</button>\\n              </div>\\n            </div>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* TELA 2: DASHBOARD INICIAL */}\\n      {currentScreen === \'screen-dashboard\' && (\\n        <section id=\\\"screen-dashboard\\\" className=\\\"screen\\\" style={{ background: \'var(--bg-mint)\' }}>\\n          <div>\\n            <span className=\\\"eyebrow\\\">TELA INICIAL</span>\\n            <h2 className=\\\"serif-title\\\" style={{ fontSize: \'1.85rem\' }}>Ol\303\241, Larissa!</h2>\\n          </div>\\n\\n          <div className=\\\"card-dark\\\" style={{ cursor: \'pointer\' }} onClick={() => navigate(\'screen-inteligencia\')}>\\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'flex-start\' }}>\\n              <div>\\n                <span className=\\\"eyebrow\\\" style={{ color: \'#A8BDB2\' }}>DESTAQUE</span>\\n                <h3 style={{ fontSize: \'1.1rem\', marginBottom: \'6px\' }}>Intelig\303\252ncia Comercial</h3>\\n                <p style={{ fontSize: \'0.8rem\', color: \'#D4DFD9\', lineHeight: 1.4 }}>Veja quais produtos est\303\243o sendo mais importados e exportados na sua regi\303\243o.</p>\\n              </div>\\n              <span style={{ fontSize: \'1.2rem\' }}>\342\206\227</span>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"card-dark\\\">\\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', marginBottom: \'6px\' }}>\\n              <span className=\\\"eyebrow\\\" style={{ color: \'#A8BDB2\', margin: 0 }}>REFER\303\212NCIA CAMBIAL</span>\\n              <span style={{ background: \'#FFFFFF\', color: \'var(--primary-dark)\', fontSize: \'0.65rem\', fontWeight: 800, padding: \'4px 10px\', borderRadius: \'20px\' }}>SIMULADO</span>\\n            </div>\\n            <h3 style={{ fontSize: \'1.1rem\', marginBottom: \'4px\' }}>Conversor de Moedas</h3>\\n            <p style={{ fontSize: \'0.8rem\', color: \'#D4DFD9\', marginBottom: \'14px\' }}>1 R$ = 0,68 S/. \302\267 taxa simulada de refer\303\252ncia</p>\\n            <div style={{ display: \'flex\', alignItems: \'center\', gap: \'8px\', marginBottom: \'12px\' }}>\\n              <input type=\\\"number\\\" id=\\\"input-brl\\\" value={brlVal} onChange={(e) => handleBrlChange(e.target.value)} placeholder=\\\"0,00\\\" />\\n              <button onClick={inverterMoeda} style={{ background: \'#EAE7DF\', border: \'none\', borderRadius: \'10px\', padding: \'10px\', cursor: \'pointer\', fontWeight: \'bold\' }}>\342\207\204</button>\\n              <input type=\\\"text\\\" id=\\\"output-pen\\\" value={penVal} readOnly style={{ background: \'#F4F4F4\' }} />\\n            </div>\\n            <button className=\\\"btn-outline\\\" style={{ width: \'100%\', border: \'none\' }} onClick={converterMoeda}>Converter</button>\\n            <p style={{ fontSize: \'0.7rem\', color: \'#A8BDB2\', marginTop: \'10px\' }}>Taxa simulada para demonstra\303\247\303\243o.</p>\\n          </div>\\n\\n          <div className=\\\"card-dark\\\" style={{ cursor: \'pointer\' }} onClick={() => navigate(\'screen-produtos\')}>\\n            <div style={{ display: \'flex\', alignItems: \'center\', gap: \'14px\' }}>\\n              <div style={{ background: \'#EAE7DF\', color: \'var(--primary-dark)\', width: \'42px\', height: \'42px\', borderRadius: \'12px\', display: \'flex\', alignItems: \'center\', justifyContent: \'center\', fontSize: \'1.2rem\', flexShrink: 0 }}>\360\237\214\220</div>\\n              <div style={{ flex: 1 }}>\\n                <span className=\\\"eyebrow\\\" style={{ color: \'#A8BDB2\' }}>DESTAQUE</span>\\n                <h3 style={{ fontSize: \'1rem\', marginBottom: \'4px\' }}>Radar de Mercado Mundial</h3>\\n                <p style={{ fontSize: \'0.76rem\', color: \'#D4DFD9\' }}>Consulte o PIB, volume de vendas e demandas de produtos por pa\303\255s.</p>\\n              </div>\\n              <span>\342\206\222</span>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"shortcut-grid\\\">\\n            <div className=\\\"shortcut-card\\\" onClick={() => navigate(\'screen-docs\')}>\\n              <span style={{ fontSize: \'1.4rem\' }}>\360\237\223\204</span>\\n              <h4>Documenta\303\247\303\243o</h4>\\n              <p>Consultar documentos necess\303\241rios para exporta\303\247\303\243o e importa\303\247\303\243o.</p>\\n            </div>\\n            <div className=\\\"shortcut-card\\\" onClick={() => navigate(\'screen-rastreamento\')}>\\n              <span style={{ fontSize: \'1.4rem\' }}>\360\237\224\215</span>\\n              <h4>Rastreamento</h4>\\n              <p>Acompanhar o trajeto do seu produto.</p>\\n            </div>\\n            <div className=\\\"shortcut-card\\\" onClick={() => navigate(\'screen-guia\')}>\\n              <span style={{ fontSize: \'1.4rem\' }}>\360\237\247\276</span>\\n              <h4>Consulta NCM</h4>\\n              <p>Classifica\303\247\303\243o fiscal e taxas do produto.</p>\\n            </div>\\n            <div className=\\\"shortcut-card\\\" onClick={() => {\\n              const el = document.getElementById(\'input-brl\');\\n              el?.focus();\\n            }}>\\n              <span style={{ fontSize: \'1.4rem\' }}>\342\207\204</span>\\n              <h4>Conversor de Moedas</h4>\\n              <p>Calcule valores entre R$ e S/.</p>\\n            </div>\\n            <div className=\\\"shortcut-card\\\" onClick={() => navigate(\'screen-frete\')}>\\n              <span style={{ fontSize: \'1.4rem\' }}>\360\237\232\232</span>\\n              <h4>Simular Frete</h4>\\n              <p>Calcule o custo e a viabilidade por kg.</p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"card-mint\\\" style={{ border: \'1px solid #C8D6CD\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-rastreamento\')}>\\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', marginBottom: \'8px\' }}>\\n              <span className=\\\"eyebrow\\\" style={{ margin: 0 }}>RASTREAMENTO</span>\\n              <span>\342\206\227</span>\\n            </div>\\n            <p style={{ fontSize: \'0.85rem\', fontWeight: 700, marginBottom: \'10px\' }}>\360\237\232\232 Pedido realizado &nbsp; \360\237\232\232 Em rota</p>\\n            <div style={{ display: \'grid\', gridTemplateColumns: \'1fr 1fr\', gap: \'6px\', fontSize: \'0.78rem\' }}>\\n              <div><strong>Lote:</strong> BRP-2026-001</div>\\n              <div><strong>Produto:</strong> Madeira</div>\\n              <div><strong>Localiza\303\247\303\243o:</strong> Em rota para o Peru</div>\\n              <div><strong>Chegada:</strong> 5 dias</div>\\n            </div>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* TELA 3: INTELIG\303\212NCIA COMERCIAL */}\\n      {currentScreen === \'screen-inteligencia\' && (\\n        <section id=\\\"screen-inteligencia\\\" className=\\\"screen\\\" style={{ background: \'var(--bg-mint)\' }}>\\n          <div className=\\\"card\\\">\\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\' }}>\\n              <span className=\\\"eyebrow\\\" style={{ margin: 0 }}>INTELIG\303\212NCIA COMERCIAL</span>\\n              <span style={{ background: \'#E6F2EB\', color: \'#2B4C3B\', fontSize: \'0.65rem\', fontWeight: 700, padding: \'4px 10px\', borderRadius: \'20px\' }}>ATIVO</span>\\n            </div>\\n            <h2 className=\\\"serif-title\\\" style={{ fontSize: \'1.65rem\', margin: \'6px 0 16px\' }}>Sua regi\303\243o em foco</h2>\\n\\n            <div className=\\\"pill-switch\\\">\\n              <button \\n                className={`pill-btn ${fluxoBrasil ? \'active\' : \'\'}`} \\n                onClick={() => setFluxoBrasil(true)}\\n              >\\n                Fluxo Brasil (Exporta\303\247\303\243o)\\n              </button>\\n              <button \\n                className={`pill-btn ${!fluxoBrasil ? \'active\' : \'\'}`} \\n                onClick={() => setFluxoBrasil(false)}\\n              >\\n                Fluxo Peru (Importa\303\247\303\243o)\\n              </button>\\n            </div>\\n\\n            <div className=\\\"form-group\\\">\\n              <label>Informe sua cidade e seu pa\303\255s</label>\\n              <input type=\\\"text\\\" placeholder=\\\"Ex.: Itapetininga, Brasil\\\" defaultValue=\\\"Itapetininga, Brasil\\\" />\\n            </div>\\n\\n            <div className=\\\"form-group\\\">\\n              <label>Pesquisar produtos</label>\\n              <input type=\\\"text\\\" placeholder=\\\"Busque por produto\\\" />\\n            </div>\\n\\n            <div style={{ border: \'1px solid var(--border-light)\', borderRadius: \'14px\', overflow: \'hidden\', marginBottom: \'10px\' }}>\\n              {[\\n                \'Min\303\251rio e Adubos Minerais\',\\n                \'Zinco e C\303\241todos de Cobre\',\\n                \'Milho\',\\n                \'Equipamentos Industriais\'\\n              ].map((item) => (\\n                <div \\n                  key={item} \\n                  className={`list-row ${selectedItems[item] ? \'selected\' : \'\'}`}\\n                  onClick={() => setSelectedItems((prev) => ({ ...prev, [item]: !prev[item] }))}\\n                >\\n                  <span>{item}</span>\\n                  <span>{selectedItems[item] ? \'\342\234\223\' : \'+\'}</span>\\n                </div>\\n              ))}\\n            </div>\\n            <p style={{ fontSize: \'0.75rem\', color: \'var(--text-muted)\', marginBottom: \'14px\' }}>Selecione um ou mais produtos.</p>\\n\\n            <button className=\\\"btn-green\\\" onClick={() => navigate(\'screen-produtos\')}>Pesquisar</button>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* TELA 4: PRODUTOS DE EXPORTA\303\207\303\203O */}\\n      {currentScreen === \'screen-produtos\' && (\\n        <section id=\\\"screen-produtos\\\" className=\\\"screen\\\">\\n          <div>\\n            <span className=\\\"eyebrow\\\">PRODUTOS</span>\\n            <h2 className=\\\"serif-title\\\" style={{ fontSize: \'1.65rem\' }}>Produtos de Exporta\303\247\303\243o</h2>\\n            <p style={{ fontSize: \'0.85rem\', color: \'var(--text-muted)\' }}>Principais mercadorias da regi\303\243o</p>\\n          </div>\\n\\n          <div className=\\\"form-group\\\" style={{ margin: 0 }}>\\n            <label>Pesquise um produto</label>\\n            <input type=\\\"text\\\" placeholder=\\\"Pesquise um produto\\\" />\\n          </div>\\n\\n          <div style={{ display: \'flex\', gap: \'8px\' }}>\\n            <button className=\\\"btn-primary\\\" style={{ fontSize: \'0.78rem\', padding: \'12px\' }}>De: Peru \342\206\222 Para: Itapetininga</button>\\n            <button className=\\\"btn-outline\\\" style={{ fontSize: \'0.78rem\', padding: \'12px\' }}>De: Itapetininga \342\206\222 Para: Peru</button>\\n          </div>\\n\\n          <div style={{ display: \'grid\', gridTemplateColumns: \'1fr 1.1fr\', gap: \'10px\' }}>\\n            <div className=\\\"card-mint\\\" style={{ border: \'1px solid var(--primary-dark)\', display: \'flex\', flexDirection: \'column\', justifyContent: \'center\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-docs\')}>\\n              <strong style={{ fontSize: \'0.9rem\' }}>\360\237\247\261 Ferro / Insumos</strong>\\n              <span style={{ fontSize: \'0.72rem\', color: \'var(--text-muted)\', marginTop: \'6px\' }}>Clique para iniciar processo \342\206\222</span>\\n            </div>\\n\\n            <div className=\\\"card\\\" style={{ padding: \'14px\' }}>\\n              <strong style={{ fontSize: \'0.82rem\', display: \'block\', marginBottom: \'4px\' }}>Fornecedores peruanos</strong>\\n              <p style={{ fontSize: \'0.68rem\', color: \'var(--text-muted)\', marginBottom: \'10px\' }}>Pre\303\247os indicativos, n\303\243o s\303\243o cota\303\247\303\265es ao vivo.</p>\\n              \\n              <div style={{ borderBottom: \'1px solid var(--border-light)\', paddingBottom: \'8px\', marginBottom: \'8px\', fontSize: \'0.76rem\' }}>\\n                <strong>Shougang Hierro Per\303\272</strong> \360\237\207\265\360\237\207\252<br />\\n                <span style={{ color: \'var(--primary-green)\', fontWeight: 700 }}>US$ 850 / ton</span>\\n              </div>\\n              <div style={{ fontSize: \'0.76rem\' }}>\\n                <strong>Empresa Sider\303\272rgica del Per\303\272 (SIDERPERU)</strong> \360\237\207\265\360\237\207\252<br />\\n                <span style={{ color: \'var(--primary-green)\', fontWeight: 700 }}>US$ 890 / ton</span>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"shortcut-grid\\\">\\n            <div className=\\\"card\\\" style={{ padding: \'14px\', fontWeight: 600, fontSize: \'0.85rem\' }}>\360\237\237\240 Cobre</div>\\n            <div className=\\\"card\\\" style={{ padding: \'14px\', fontWeight: 600, fontSize: \'0.85rem\' }}>\360\237\247\204 Alho Peruano</div>\\n            <div className=\\\"card\\\" style={{ padding: \'14px\', fontWeight: 600, fontSize: \'0.85rem\' }}>\360\237\220\237 Farinha de Peixe</div>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* TELA 5: FLUXO DOCUMENTAL E ANEXOS */}\\n      {currentScreen === \'screen-docs\' && (\\n        <section id=\\\"screen-docs\\\" className=\\\"screen\\\">\\n          <div className=\\\"card-dark\\\">\\n            <span className=\\\"eyebrow\\\" style={{ color: \'#A8BDB2\' }}>GEST\303\203O DE DOCUMENTA\303\207\303\203O</span>\\n            <h2 className=\\\"serif-title\\\" style={{ fontSize: \'1.55rem\', marginBottom: \'8px\' }}>Tudo certo antes de seguir viagem.</h2>\\n            <p style={{ fontSize: \'0.8rem\', color: \'#D4DFD9\', marginBottom: \'16px\' }}>Use este checklist como apoio para estruturar a documenta\303\247\303\243o de uma opera\303\247\303\243o de exporta\303\247\303\243o ou importa\303\247\303\243o.</p>\\n            \\n            <div style={{ background: \'#FFFFFF\', color: \'var(--text-dark)\', borderRadius: \'16px\', padding: \'16px\' }}>\\n              <strong style={{ fontSize: \'0.9rem\', display: \'block\', marginBottom: \'10px\' }}>Checklist da opera\303\247\303\243o</strong>\\n              <label style={{ fontSize: \'0.78rem\', display: \'block\', marginBottom: \'6px\' }}>Qual produto voc\303\252 deseja exportar/importar?</label>\\n              <select style={{ marginBottom: \'10px\' }} defaultValue=\\\"Ferro / Insumos (NCM 7200.00.00)\\\">\\n                <option>Ferro / Insumos (NCM 7200.00.00)</option>\\n                <option>Cobre</option>\\n                <option>Madeira</option>\\n                <option>Milho</option>\\n              </select>\\n              <button className=\\\"btn-outline\\\" style={{ width: \'100%\' }}>Confirmar Produto</button>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"card\\\">\\n            <span className=\\\"eyebrow\\\">FLUXO DOCUMENTAL DEMONSTRATIVO</span>\\n            <h3 className=\\\"serif-title\\\" style={{ fontSize: \'1.3rem\', marginBottom: \'8px\' }}>Processo de Exporta\303\247\303\243o \342\200\224 Item: Ferro / Insumos</h3>\\n            <span style={{ background: \'var(--bg-mint)\', padding: \'5px 10px\', borderRadius: \'8px\', fontSize: \'0.75rem\', fontWeight: 600, display: \'inline-block\', marginBottom: \'14px\' }}>\\n              C\303\263digo NCM Vinculado: 7200.00.00\\n            </span>\\n\\n            <div className=\\\"form-group\\\">\\n              <label>Quantidade para Exporta\303\247\303\243o ou Importa\303\247\303\243o (kg)</label>\\n              <input type=\\\"number\\\" id=\\\"doc-kg\\\" placeholder=\\\"Ex: 1000\\\" defaultValue=\\\"1000\\\" />\\n            </div>\\n            <div className=\\\"form-group\\\">\\n              <label>Pa\303\255s de Origem do produto</label>\\n              <input type=\\\"text\\\" defaultValue=\\\"Brasil\\\" />\\n            </div>\\n            <div className=\\\"form-group\\\">\\n              <label>Pa\303\255s de destino</label>\\n              <input type=\\\"text\\\" defaultValue=\\\"Peru\\\" />\\n            </div>\\n\\n            <div style={{ background: \'#FAF3E3\', padding: \'12px\', borderRadius: \'12px\', fontSize: \'0.75rem\', color: \'#7A5C20\', marginBottom: \'14px\' }}>\\n              Os requisitos s\303\243o orientativos e devem ser confirmados com despachante aduaneiro, MAPA ou autoridade competente.\\n            </div>\\n\\n            <div style={{ display: \'flex\', flexDirection: \'column\', gap: \'10px\', marginBottom: \'16px\' }}>\\n              <div className=\\\"card\\\" style={{ padding: \'14px\' }}>\\n                <div style={{ display: \'flex\', justifyContent: \'space-between\', marginBottom: \'6px\' }}>\\n                  <strong style={{ fontSize: \'0.88rem\' }}>Invoice Comercial</strong>\\n                  <span id=\\\"badge-1\\\" style={{ \\n                    background: doc1Attached ? \'#E6F2EB\' : \'var(--badge-orange-bg)\', \\n                    color: doc1Attached ? \'#2B4C3B\' : \'var(--badge-orange-text)\', \\n                    fontSize: \'0.7rem\', padding: \'3px 8px\', borderRadius: \'12px\', fontWeight: 600 \\n                  }}>\\n                    {doc1Attached ? \'Anexado\' : \'Pendente\'}\\n                  </span>\\n                </div>\\n                <p id=\\\"file-1\\\" style={{ fontSize: \'0.75rem\', color: \'var(--text-muted)\', marginBottom: \'10px\' }}>\\n                  {doc1Attached ? \'invoice_comercial.pdf\' : \'Nenhum arquivo selecionado\'}\\n                </p>\\n                <button className=\\\"btn-green\\\" style={{ width: \'auto\', padding: \'8px 14px\', fontSize: \'0.8rem\' }} onClick={() => setDoc1Attached(true)}>\\n                  Anexar arquivo\\n                </button>\\n              </div>\\n\\n              <div className=\\\"card\\\" style={{ padding: \'14px\' }}>\\n                <div style={{ display: \'flex\', justifyContent: \'space-between\', marginBottom: \'6px\' }}>\\n                  <strong style={{ fontSize: \'0.88rem\' }}>Certificado de Origem</strong>\\n                  <span id=\\\"badge-2\\\" style={{ \\n                    background: doc2Attached ? \'#E6F2EB\' : \'var(--badge-orange-bg)\', \\n                    color: doc2Attached ? \'#2B4C3B\' : \'var(--badge-orange-text)\', \\n                    fontSize: \'0.7rem\', padding: \'3px 8px\', borderRadius: \'12px\', fontWeight: 600 \\n                  }}>\\n                    {doc2Attached ? \'Anexado\' : \'Pendente\'}\\n                  </span>\\n                </div>\\n                <p id=\\\"file-2\\\" style={{ fontSize: \'0.75rem\', color: \'var(--text-muted)\', marginBottom: \'10px\' }}>\\n                  {doc2Attached ? \'certificado_origem.pdf\' : \'Nenhum arquivo selecionado\'}\\n                </p>\\n                <button className=\\\"btn-green\\\" style={{ width: \'auto\', padding: \'8px 14px\', fontSize: \'0.8rem\' }} onClick={() => setDoc2Attached(true)}>\\n                  Anexar arquivo\\n                </button>\\n              </div>\\n\\n              <div className=\\\"card\\\" style={{ padding: \'14px\' }}>\\n                <div style={{ display: \'flex\', justifyContent: \'space-between\', marginBottom: \'6px\' }}>\\n                  <strong style={{ fontSize: \'0.88rem\' }}>Certificado de Qualidade</strong>\\n                  <span id=\\\"badge-3\\\" style={{ \\n                    background: doc3Attached ? \'#E6F2EB\' : \'var(--badge-orange-bg)\', \\n                    color: doc3Attached ? \'#2B4C3B\' : \'var(--badge-orange-text)\', \\n                    fontSize: \'0.7rem\', padding: \'3px 8px\', borderRadius: \'12px\', fontWeight: 600 \\n                  }}>\\n                    {doc3Attached ? \'Anexado\' : \'Pendente\'}\\n                  </span>\\n                </div>\\n                <p id=\\\"file-3\\\" style={{ fontSize: \'0.75rem\', color: \'var(--text-muted)\', marginBottom: \'10px\' }}>\\n                  {doc3Attached ? \'certificado_qualidade.pdf\' : \'Nenhum arquivo selecionado\'}\\n                </p>\\n                <button className=\\\"btn-green\\\" style={{ width: \'auto\', padding: \'8px 14px\', fontSize: \'0.8rem\' }} onClick={() => setDoc3Attached(true)}>\\n                  Anexar arquivo\\n                </button>\\n              </div>\\n            </div>\\n\\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', marginBottom: \'12px\', fontSize: \'0.82rem\' }}>\\n              <strong id=\\\"doc-counter\\\">{totalDocs} de 3 documentos anexados</strong>\\n              <span id=\\\"doc-global-status\\\" style={{ \\n                background: totalDocs === 3 ? \'#E6F2EB\' : \'#E6EEF8\', \\n                color: totalDocs === 3 ? \'#2B4C3B\' : \'#2C5E9E\', \\n                padding: \'3px 10px\', borderRadius: \'12px\', fontSize: \'0.72rem\', fontWeight: 600 \\n              }}>\\n                {totalDocs === 3 ? \'Conclu\303\255do\' : \'Pendente\'}\\n              </span>\\n            </div>\\n\\n            <button className=\\\"btn-green\\\" onClick={() => navigate(\'screen-pagamento\')}>IR PARA PAGAMENTO (GOV.BR)</button>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* TELA 6: PAGAMENTO PIX */}\\n      {currentScreen === \'screen-pagamento\' && (\\n        <section id=\\\"screen-pagamento\\\" className=\\\"screen\\\" style={{ background: \'var(--bg-mint)\' }}>\\n          <div style={{ background: \'var(--primary-green)\', color: \'white\', padding: \'22px\', borderRadius: \'20px\' }}>\\n            <h2 style={{ fontSize: \'1.35rem\', marginBottom: \'6px\' }}>Pagamento</h2>\\n            <p style={{ fontSize: \'0.8rem\', opacity: 0.9 }}>Documentos aprovados! Finalize o pagamento para emitir o certificado. A aprova\303\247\303\243o \303\251 apenas demonstrativa e local.</p>\\n          </div>\\n\\n          <div className=\\\"card\\\">\\n            <h3 style={{ fontSize: \'1.05rem\', marginBottom: \'14px\' }}>Resumo do valor</h3>\\n            <div style={{ display: \'flex\', flexDirection: \'column\', gap: \'10px\', fontSize: \'0.88rem\', marginBottom: \'16px\' }}>\\n              <div style={{ display: \'flex\', justifyContent: \'space-between\' }}><span style={{ color: \'var(--text-muted)\' }}>Taxa de Exporta\303\247\303\243o</span><strong>R$ 180,00</strong></div>\\n              <div style={{ display: \'flex\', justifyContent: \'space-between\' }}><span style={{ color: \'var(--text-muted)\' }}>Emolumentos GOV</span><strong>R$ 45,00</strong></div>\\n              <div style={{ display: \'flex\', justifyContent: \'space-between\' }}><span style={{ color: \'var(--text-muted)\' }}>Taxa de Servi\303\247o</span><strong>R$ 20,00</strong></div>\\n              <hr style={{ border: \'none\', borderTop: \'1px solid var(--border-light)\' }} />\\n              <div style={{ display: \'flex\', justifyContent: \'space-between\', fontSize: \'1rem\' }}><strong>Total</strong><strong>R$ 245,00</strong></div>\\n            </div>\\n\\n            <div style={{ display: \'flex\', flexDirection: \'column\', gap: \'8px\', marginBottom: \'16px\' }}>\\n              <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\', border: \'2px solid var(--primary-dark)\' }}>Pix</button>\\n              <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\' }}>QR Code</button>\\n              <button className=\\\"btn-outline\\\" style={{ textAlign: \'left\' }}>Boleto Banc\303\241rio</button>\\n            </div>\\n\\n            <div className=\\\"card\\\" style={{ textAlign: \'center\', background: \'#FAF9F6\' }}>\\n              <span className=\\\"eyebrow\\\">PAGAMENTO PIX</span>\\n              <h4 style={{ fontSize: \'1.1rem\', marginBottom: \'14px\' }}>Pague com Pix</h4>\\n              \\n              <div style={{ background: \'white\', padding: \'16px\', borderRadius: \'16px\', display: \'inline-block\', boxShadow: \'0 2px 10px rgba(0,0,0,0.05)\', marginBottom: \'14px\' }}>\\n                <svg width=\\\"140\\\" height=\\\"140\\\" viewBox=\\\"0 0 100 100\\\" fill=\\\"#1A3026\\\">\\n                  <rect x=\\\"5\\\" y=\\\"5\\\" width=\\\"25\\\" height=\\\"25\\\" fill=\\\"none\\\" stroke=\\\"#1A3026\\\" strokeWidth=\\\"5\\\"/>\\n                  <rect x=\\\"12\\\" y=\\\"12\\\" width=\\\"11\\\" height=\\\"11\\\"/>\\n                  <rect x=\\\"70\\\" y=\\\"5\\\" width=\\\"25\\\" height=\\\"25\\\" fill=\\\"none\\\" stroke=\\\"#1A3026\\\" strokeWidth=\\\"5\\\"/>\\n                  <rect x=\\\"77\\\" y=\\\"12\\\" width=\\\"11\\\" height=\\\"11\\\"/>\\n                  <rect x=\\\"5\\\" y=\\\"70\\\" width=\\\"25\\\" height=\\\"25\\\" fill=\\\"none\\\" stroke=\\\"#1A3026\\\" strokeWidth=\\\"5\\\"/>\\n                  <rect x=\\\"12\\\" y=\\\"77\\\" width=\\\"11\\\" height=\\\"11\\\"/>\\n                  <rect x=\\\"40\\\" y=\\\"10\\\" width=\\\"8\\\" height=\\\"8\\\"/><rect x=\\\"52\\\" y=\\\"22\\\" width=\\\"8\\\" height=\\\"8\\\"/>\\n                  <rect x=\\\"38\\\" y=\\\"40\\\" width=\\\"12\\\" height=\\\"12\\\"/><rect x=\\\"58\\\" y=\\\"45\\\" width=\\\"8\\\" height=\\\"16\\\"/>\\n                  <rect x=\\\"10\\\" y=\\\"42\\\" width=\\\"14\\\" height=\\\"8\\\"/><rect x=\\\"42\\\" y=\\\"68\\\" width=\\\"10\\\" height=\\\"10\\\"/>\\n                  <rect x=\\\"65\\\" y=\\\"72\\\" width=\\\"20\\\" height=\\\"8\\\"/><rect x=\\\"75\\\" y=\\\"85\\\" width=\\\"15\\\" height=\\\"8\\\"/>\\n                </svg>\\n              </div>\\n\\n              <div style={{ fontSize: \'1.25rem\', fontWeight: 700, marginBottom: \'4px\' }}>R$ 245,00</div>\\n              <p style={{ fontSize: \'0.78rem\', color: \'var(--text-muted)\', marginBottom: \'14px\' }}>Copie o c\303\263digo Pix para concluir o pagamento.</p>\\n              <button className=\\\"btn-outline\\\" style={{ width: \'100%\' }} onClick={copyPix}>Copiar C\303\263digo Pix</button>\\n            </div>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* TELA 7: SIMULADOR DE FRETE */}\\n      {currentScreen === \'screen-frete\' && (\\n        <section id=\\\"screen-frete\\\" className=\\\"screen\\\">\\n          <div className=\\\"card\\\">\\n            <span className=\\\"eyebrow\\\">SIMULADOR DE FRETE</span>\\n            <h2 className=\\\"serif-title\\\" style={{ fontSize: \'1.65rem\', marginBottom: \'8px\' }}>Simular Frete</h2>\\n            <p style={{ fontSize: \'0.82rem\', color: \'var(--text-muted)\', marginBottom: \'18px\' }}>Informe os dados da sua encomenda para estimar o frete de forma simples e r\303\241pida.</p>\\n\\n            <div className=\\\"form-group\\\">\\n              <label>Produto</label>\\n              <select id=\\\"frete-prod\\\" value={freteProd} onChange={(e) => setFreteProd(e.target.value)}>\\n                <option value=\\\"\\\">Selecione um produto</option>\\n                <option value=\\\"ferro\\\">Ferro / Insumos</option>\\n                <option value=\\\"cobre\\\">Cobre</option>\\n                <option value=\\\"madeira\\\">Madeira</option>\\n              </select>\\n            </div>\\n            <div className=\\\"form-group\\\">\\n              <label>Valor do produto (R$)</label>\\n              <input type=\\\"number\\\" id=\\\"frete-valor\\\" placeholder=\\\"Ex: 5000\\\" value={freteValor} onChange={(e) => setFreteValor(e.target.value)} />\\n            </div>\\n            <div className=\\\"form-group\\\">\\n              <label>Peso (kg)</label>\\n              <input type=\\\"number\\\" id=\\\"frete-peso\\\" placeholder=\\\"Ex: 1200\\\" value={fretePeso} onChange={(e) => setFretePeso(e.target.value)} />\\n            </div>\\n            <div className=\\\"form-group\\\">\\n              <label>Pa\303\255s de origem</label>\\n              <input type=\\\"text\\\" value={freteOrigem} onChange={(e) => setFreteOrigem(e.target.value)} />\\n            </div>\\n            <div className=\\\"form-group\\\">\\n              <label>Pa\303\255s de destino</label>\\n              <input type=\\\"text\\\" placeholder=\\\"Ex: Peru\\\" value={freteDestino} onChange={(e) => setFreteDestino(e.target.value)} />\\n            </div>\\n\\n            <button className=\\\"btn-green\\\" onClick={calcularFrete}>SIMULAR</button>\\n            {freteResultado && (\\n              <div id=\\\"frete-resultado\\\" style={{ marginTop: \'14px\', padding: \'14px\', background: \'var(--bg-mint)\', borderRadius: \'12px\', fontSize: \'0.85rem\' }}>\\n                {freteResultado}\\n              </div>\\n            )}\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* TELA 8: RASTREAMENTO + CHATBOT */}\\n      {currentScreen === \'screen-rastreamento\' && (\\n        <section id=\\\"screen-rastreamento\\\" className=\\\"screen\\\">\\n          <div>\\n            <span className=\\\"eyebrow\\\">RASTREAMENTO EM TEMPO REAL</span>\\n            <h2 className=\\\"serif-title\\\" style={{ fontSize: \'1.65rem\', marginBottom: \'6px\' }}>Visibilidade para cada etapa.</h2>\\n            <p style={{ fontSize: \'0.82rem\', color: \'var(--text-muted)\', marginBottom: \'8px\' }}>Consulte uma linha do tempo demonstrativa para acompanhar o percurso de uma carga.</p>\\n            <p style={{ fontSize: \'0.8rem\', fontWeight: 700 }}>Experimente: BRAPEX2026, BR-PE-001 ou CARGA123.</p>\\n          </div>\\n\\n          <div className=\\\"card\\\">\\n            <input \\n              type=\\\"text\\\" \\n              id=\\\"track-code\\\" \\n              placeholder=\\\"Digite o c\303\263digo de rastreamento\\\" \\n              value={trackCode} \\n              onChange={(e) => setTrackCode(e.target.value)}\\n              style={{ marginBottom: \'10px\' }} \\n            />\\n            <button className=\\\"btn-green\\\" onClick={animarRota}>Rastrear carga</button>\\n          </div>\\n\\n          <div className=\\\"card\\\">\\n            <span className=\\\"eyebrow\\\">ROTA ILUSTRATIVA</span>\\n            <h3 style={{ fontSize: \'1.1rem\', marginBottom: \'4px\' }}>Brasil \342\206\222 Peru</h3>\\n            <p style={{ fontSize: \'0.8rem\', color: \'var(--text-muted)\', marginBottom: \'12px\' }}>Acompanhe uma visualiza\303\247\303\243o demonstrativa do deslocamento internacional da carga.</p>\\n            \\n            <button className=\\\"btn-green\\\" style={{ width: \'auto\', padding: \'10px 18px\', marginBottom: \'10px\' }} onClick={animarRota}>\342\226\267 Animar rota</button>\\n\\n            <div className=\\\"map-canvas\\\">\\n              <svg width=\\\"100%\\\" height=\\\"100%\\\" viewBox=\\\"0 0 300 200\\\">\\n                <path d=\\\"M 55 155 Q 140 110 235 45\\\" stroke=\\\"#1A3026\\\" strokeWidth=\\\"3\\\" strokeDasharray=\\\"5,5\\\" fill=\\\"none\\\"/>\\n              </svg>\\n              <div className=\\\"map-pin\\\" style={{ top: \'18px\', right: \'18px\', color: \'#A33\' }}>\360\237\223\215 Destino: Peru</div>\\n              <div id=\\\"truck-el\\\" className=\\\"truck-marker\\\" style={{ left: truckPos.left, bottom: truckPos.bottom }}>\360\237\232\232</div>\\n              <div className=\\\"map-pin\\\" style={{ bottom: \'18px\', left: \'18px\', color: \'#2B4C3B\' }}>\360\237\223\215 Origem: Sudoeste/PR</div>\\n              <span id=\\\"route-status\\\" style={{ position: \'absolute\', bottom: \'12px\', right: \'14px\', fontSize: \'0.7rem\', color: \'var(--text-muted)\' }}>\\n                {routeStatus}\\n              </span>\\n            </div>\\n            <p style={{ fontSize: \'0.78rem\', color: \'var(--text-muted)\' }}>A rota est\303\241 pronta para anima\303\247\303\243o.</p>\\n          </div>\\n\\n          <div className=\\\"card-mint\\\">\\n            <span className=\\\"eyebrow\\\">SUPORTE CHATBOT</span>\\n            <h2 className=\\\"serif-title\\\" style={{ fontSize: \'1.55rem\', marginBottom: \'8px\' }}>Uma primeira resposta, quando voc\303\252 precisa.</h2>\\n            <p style={{ fontSize: \'0.8rem\', color: \'var(--text-muted)\', marginBottom: \'14px\' }}>Converse com nosso assistente demonstrativo sobre documenta\303\247\303\243o, rastreamento, prazos, Peru e alf\303\242ndega.</p>\\n\\n            <div className=\\\"card\\\" style={{ padding: \'14px\' }}>\\n              <div id=\\\"chat-history\\\" style={{ background: \'var(--bg-mint)\', borderRadius: \'12px\', padding: \'12px\', minHeight: \'140px\', maxHeight: \'220px\', overflowY: \'auto\', display: \'flex\', flexDirection: \'column\', gap: \'8px\', marginBottom: \'10px\' }}>\\n                {chatMessages.map((msg, i) => (\\n                  <div\\n                    key={i}\\n                    style={{\\n                      background: msg.sender === \'user\' ? \'#1A3026\' : \'#FFFFFF\',\\n                      color: msg.sender === \'user\' ? \'white\' : \'inherit\',\\n                      padding: \'10px 12px\',\\n                      borderRadius: \'12px\',\\n                      fontSize: \'0.8rem\',\\n                      lineHeight: 1.4,\\n                      maxWidth: \'85%\',\\n                      alignSelf: msg.sender === \'user\' ? \'flex-end\' : \'flex-start\'\\n                    }}\\n                  >\\n                    {msg.text}\\n                  </div>\\n                ))}\\n              </div>\\n              <input \\n                type=\\\"text\\\" \\n                id=\\\"chat-msg-input\\\" \\n                placeholder=\\\"Digite sua pergunta\\\" \\n                value={chatInput} \\n                onChange={(e) => setChatInput(e.target.value)}\\n                onKeyDown={(e) => { if (e.key === \'Enter\') enviarChat(); }}\\n                style={{ marginBottom: \'8px\' }} \\n              />\\n              <button className=\\\"btn-green\\\" onClick={enviarChat}>Enviar</button>\\n            </div>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* TELA 9: GUIA ADUANEIRO DIGITAL */}\\n      {currentScreen === \'screen-guia\' && (\\n        <section id=\\\"screen-guia\\\" className=\\\"screen\\\">\\n          <div>\\n            <span className=\\\"eyebrow\\\">GUIA ADUANEIRO DIGITAL</span>\\n            <h2 className=\\\"serif-title\\\" style={{ fontSize: \'1.65rem\', marginBottom: \'12px\' }}>Pesquise antes de movimentar.</h2>\\n            <button className=\\\"btn-green\\\" style={{ marginBottom: \'12px\' }} onClick={() => alert(\'Consulta NCM: Ferro / Insumos \342\200\224 C\303\263digo 7200.00.00 (Al\303\255quota IPI/II conforme acordo Mercosul-Peru).\')}>\\n              CONSULTAR NCM\\n            </button>\\n            <p style={{ fontSize: \'0.82rem\', color: \'var(--text-muted)\' }}>Encontre pontos de partida para as d\303\272vidas mais recorrentes de uma opera\303\247\303\243o internacional.</p>\\n          </div>\\n\\n          <div className=\\\"form-group\\\" style={{ margin: 0 }}>\\n            <label>Buscar por produto ou assunto</label>\\n            <input type=\\\"text\\\" placeholder=\\\"Ex.: certificado de origem ou alf\303\242ndega Peru\\\" />\\n          </div>\\n\\n          <div className=\\\"card\\\" style={{ padding: \'16px\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-docs\')}>\\n            <strong style={{ fontSize: \'0.9rem\' }}>\342\226\270 Documentos de exporta\303\247\303\243o</strong>\\n            <p style={{ fontSize: \'0.78rem\', color: \'var(--text-muted)\', marginTop: \'4px\' }}>Documentos comerciais e log\303\255sticos que estruturam a opera\303\247\303\243o.</p>\\n          </div>\\n\\n          <div className=\\\"card\\\" style={{ padding: \'16px\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-docs\')}>\\n            <strong style={{ fontSize: \'0.9rem\' }}>\342\226\270 Certificado de origem</strong>\\n            <p style={{ fontSize: \'0.78rem\', color: \'var(--text-muted)\', marginTop: \'4px\' }}>Comprova\303\247\303\243o da origem da mercadoria em condi\303\247\303\265es aplic\303\241veis.</p>\\n          </div>\\n\\n          <div className=\\\"card-dark\\\" style={{ cursor: \'pointer\' }} onClick={() => navigate(\'screen-perfil\')}>\\n            <span className=\\\"eyebrow\\\" style={{ color: \'#A8BDB2\' }}>MINHA CONTA</span>\\n            <h3 className=\\\"serif-title\\\" style={{ fontSize: \'1.45rem\', marginBottom: \'6px\' }}>Perfil do Usu\303\241rio</h3>\\n            <p style={{ fontSize: \'0.8rem\', color: \'#D4DFD9\', marginBottom: \'14px\' }}>Gerencie seus dados e prefer\303\252ncias no aplicativo BraPex.</p>\\n            <div style={{ background: \'#F7F1DC\', color: \'#5C4D26\', padding: \'10px 14px\', borderRadius: \'10px\', fontSize: \'0.76rem\', fontWeight: 600, textAlign: \'center\' }}>\\n              As informa\303\247\303\265es do perfil s\303\243o puxadas automaticamente pelo Gov.\\n            </div>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* TELA 10: PERFIL DO USU\303\201RIO */}\\n      {currentScreen === \'screen-perfil\' && (\\n        <section id=\\\"screen-perfil\\\" className=\\\"screen\\\" style={{ padding: 0 }}>\\n          <div style={{ background: \'var(--bg-mint)\', padding: \'28px 20px\', textAlign: \'center\' }}>\\n            <div style={{ width: \'68px\', height: \'68px\', background: \'var(--primary-green)\', color: \'white\', borderRadius: \'50%\', display: \'flex\', alignItems: \'center\', justifyContent: \'center\', fontSize: \'1.4rem\', fontWeight: 700, margin: \'0 auto 12px\' }}>\\n              PA\\n            </div>\\n            <h3 style={{ fontSize: \'1.1rem\' }}>Paula Andrades Gomes Oliveira</h3>\\n            <p style={{ fontSize: \'0.8rem\', color: \'var(--text-muted)\' }}>paula.andrade@exemplo.com</p>\\n          </div>\\n\\n          <div style={{ padding: \'20px\', display: \'flex\', flexDirection: \'column\', gap: \'16px\' }}>\\n            <div className=\\\"card\\\">\\n              <span className=\\\"eyebrow\\\" style={{ marginBottom: \'12px\' }}>INFORMA\303\207\303\225ES PESSOAIS</span>\\n              <div className=\\\"form-group\\\">\\n                <label>Nome completo</label>\\n                <input type=\\\"text\\\" defaultValue=\\\"Paula Andrades Gomes oliveira\\\" />\\n              </div>\\n              <div className=\\\"form-group\\\">\\n                <label>E-mail</label>\\n                <input type=\\\"email\\\" defaultValue=\\\"paula.andrade@exemplo.com\\\" />\\n              </div>\\n              <div className=\\\"form-group\\\">\\n                <label>CPF/CNPJ</label>\\n                <input type=\\\"text\\\" defaultValue=\\\"25478.578.567\\\" />\\n              </div>\\n              <div className=\\\"form-group\\\">\\n                <label>Nome da empresa</label>\\n                <input type=\\\"text\\\" placeholder=\\\"Informe a raz\303\243o social\\\" />\\n              </div>\\n              <div className=\\\"form-group\\\" style={{ margin: 0 }}>\\n                <label>Localiza\303\247\303\243o</label>\\n                <input type=\\\"text\\\" defaultValue=\\\"S\303\243o Paulo, Brasil\\\" />\\n              </div>\\n            </div>\\n\\n            <div className=\\\"card\\\">\\n              <span className=\\\"eyebrow\\\">ACESSO R\303\201PIDO</span>\\n              <div className=\\\"list-row\\\" style={{ padding: \'10px 0\' }}>\\n                <span>Alterar idioma</span>\\n                <span>PT / ES</span>\\n              </div>\\n            </div>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* FOOTER */}\\n      <footer className=\\\"app-footer\\\">\\n        <h4>BRAPEX</h4>\\n        <p>Demonstra\303\247\303\243o interativa de uma experi\303\252ncia BRAPEX. Consulte especialistas para decis\303\265es operacionais e aduaneiras.</p>\\n      </footer>\\n\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Implement App.tsx matching exactly the 10 screens, layout, styling, and interactivity from user base code\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Writing App.tsx\", \"toolSummary\":\"Write exact App.tsx implementation\"}"
