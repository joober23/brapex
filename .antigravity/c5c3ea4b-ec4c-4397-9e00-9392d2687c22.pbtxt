              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <span className=\"text-[#697E72]\">Taxa Refer\303\252ncia:</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <span className=\"font-bold\">1 R$ = {exchangeRate.toFixed(2)} S/</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <span className=\"text-[#9BAEA4]\">|</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <span className=\"font-bold\">1 S/ = {(1 / exchangeRate).toFixed(2)} R$</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
