    content: "export type Language = \'pt\' | \'es\';\n\nexport const TRANSLATIONS = {\n  pt: {\n    menuTitle: \'Menu BraPex\',\n    menuDashboard: \'\360\237\217\240 Tela Inicial\',\n    menuIntel: \'\360\237\223\212 Intelig\303\252ncia Comercial (Regi\303\243o em Foco)\',\n    menuProducts: \'\360\237\223\246 Produtos de Exporta\303\247\303\243o & Cota\303\247\303\265es\',\n    menuDocs: \'\360\237\223\204 Documenta\303\247\303\243o & Fluxo Exporta\303\247\303\243o\',\n    menuFreight: \'\360\237\232\232 Simulador de Frete\',\n    menuTracking: \'\360\237\223\215 Rastreamento & Suporte Chatbot\',\n    menuGuide: \'\360\237\223\230 Guia Aduaneiro Digital / NCM\',\n    menuProfile: \'\360\237\221\244 Perfil do Usu\303\241rio (Gov)\',\n    menuLogout: \'\360\237\232\252 Sair\',\n    navProfileTitle: \'Perfil do Usu\303\241rio\',\n    navMenuTitle: \'Menu\',\n\n    // Tela 1\n    loginHero: \'BRAPEX: CONECTANDO SUDOESTE PAULISTA AO FUTURO\',\n    loginEyebrow: \'PORTAL DE OPERA\303\207\303\225ES\',\n    loginTitle: \'Bem-vindo \303\240 sua rota de confian\303\247a.\',\n    loginSub: \'Do pequeno ao grande empreendedor\',\n    loginGovBtn: \'Entrar com o Gov\',\n    loginHelpBtn: \'Ajuda\',\n    loginContactBtn: \'Contato\',\n\n    // Tela 2\n    dashEyebrow: \'TELA INICIAL\',\n    dashHello: \'Ol\303\241, Larissa!\',\n    highlightTag: \'DESTAQUE\',\n    intelTitle: \'Intelig\303\252ncia Comercial\',\n    intelDesc: \'Veja quais produtos est\303\243o sendo mais importados e exportados na sua regi\303\243o.\',\n    fxTag: \'REFER\303\212NCIA CAMBIAL\',\n    fxBadge: \'SIMULADO\',\n    fxTitle: \'Conversor de Moedas\',\n    fxSub: \'1 R$ = 0,68 S/. \302\267 taxa simulada de refer\303\252ncia\',\n    fxBtn: \'Converter\',\n    fxNote: \'Taxa simulada para demonstra\303\247\303\243o.\',\n    radarTitle: \'Radar de Mercado Mundial\',\n    radarDesc: \'Consulte o PIB, volume de vendas e demandas de produtos por pa\303\255s.\',\n    shortDocsTitle: \'Documenta\303\247\303\2