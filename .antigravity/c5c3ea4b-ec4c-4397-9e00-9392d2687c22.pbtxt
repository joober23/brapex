            }
            lines {
              text: "          <div className=\"md:col-span-5 bg-[#F2F0EB] border border-[#DDD9D0] rounded-xl p-4\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div className=\"flex items-center justify-between text-xs text-[#697E72] mb-1\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <span>{direction === \'BRL_TO_PEN\' ? \'Voc\303\252 recebe / Cota\303\247\303\243o (Sol Peruano)\' : \'Voc\303\252 recebe / Cota\303\247\303\243o (Real)\'}</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
