  view_file {
    absolute_path_uri: "file:///public/brapex_portal.html"
    start_line: 699
    end_line: 985
    content: "\n                <div style=\"font-size:1.25rem; font-weight:700; margin-bottom:4px;\">R$ 245,00</div>\n                <p style=\"font-size:0.78rem; color:var(--text-muted); margin-bottom:14px;\">Copie o c\303\263digo Pix para concluir o pagamento.</p>\n                <button class=\"btn-outline\" style=\"width:100%;\" onclick=\"alert(\'C\303\263digo Pix Copia e Cola copiado!\')\">Copiar C\303\263digo Pix</button>\n            </div>\n        </div>\n    </section>\n\n    <!-- TELA 7: SIMULADOR DE FRETE -->\n    <section id=\"screen-frete\" class=\"screen hidden\">\n        <div class=\"card\">\n            <span class=\"eyebrow\">SIMULADOR DE FRETE</span>\n            <h2 class=\"serif-title\" style=\"font-size:1.65rem; margin-bottom:8px;\">Simular Frete</h2>\n            <p style=\"font-size:0.82rem; color:var(--text-muted); margin-bottom:18px;\">Informe os dados da sua encomenda para estimar o frete de forma simples e r\303\241pida.</p>\n\n            <div class=\"form-group\">\n                <label>Produto</label>\n                <select id=\"frete-prod\">\n                    <option value=\"\">Selecione um produto</option>\n                    <option value=\"ferro\">Ferro / Insumos</option>\n                    <option value=\"cobre\">Cobre</option>\n                    <option value=\"madeira\">Madeira</option>\n                </select>\n            </div>\n            <div class=\"form-group\">\n                <label>Valor do produto (R$)</label>\n                <input type=\"number\" id=\"frete-valor\" placeholder=\"Ex: 5000\">\n            </div>\n            <div class=\"form-group\">\n                <label>Peso (kg)</label>\n                <input type=\"number\" id=\"frete-peso\" placeholder=\"Ex: 1200\">\n            </div>\n            <div class=\"form-group\">\n                <label>Pa\303\255s de origem</label>\n                <input type=\"text\" value=\"Brasil\">\n            </div>\n            <div class=\"form-group\">\n                <label>Pa\303\255s de destino</label>\n                <input type=\"text\" placeholder=\"Ex: Peru\" value=\"Peru\">\n            </div>\n\n            <button class=\"btn-green\" onclick=\"calcularFrete()\">SIMULAR</button>\n            <div id=\"frete-resultado\" class=\"hidden\" style=\"margin-top:14px; padding:14px; background:var(--bg-mint); border-radius:12px; font-size:0.85rem;\"></div>\n        </div>\n    </section>\n\n    <!-- TELA 8: RASTREAMENTO + CHATBOT -->\n    <section id=\"screen-rastreamento\" class=\"screen hidden\">\n        <div>\n            <span class=\"eyebrow\">RASTREAMENTO EM TEMPO REAL</span>\n            <h2 class=\"serif-title\" style=\"font-size:1.65rem; margin-bottom:6px;\">Visibilidade para cada etapa.</h2>\n            <p style=\"font-size:0.82rem; color:var(--text-muted); margin-bottom:8px;\">Consulte uma linha do tempo demonstrativa para acompanhar o percurso de uma carga.</p>\n            <p style=\"font-size:0.8rem; font-weight:700;\">Experimente: BRAPEX2026, BR-PE-001 ou CARGA123.</p>\n        </div>\n\n        <div class=\"card\">\n            <input type=\"text\" id=\"track-code\" placeholder=\"Digite o c\303\263digo de rastreamento\" value=\"BRAPEX2026\" style=\"margin-bottom:10px;\">\n            <button class=\"btn-green\" onclick=\"animarRota()\">Rastrear carga</button>\n        </div>\n\n        <div class=\"card\">\n            <span class=\"eyebrow\">ROTA ILUSTRATIVA</span>\n            <h3 style=\"font-size:1.1rem; margin-bottom:4px;\">Brasil \342\206\222 Peru</h3>\n            <p style=\"font-size:0.8rem; color:var(--text-muted); margin-bottom:12px;\">Acompanhe uma visualiza\303\247\303\243o demonstrativa do deslocamento internacional da carga.</p>\n            \n            <button class=\"btn-green\" style=\"width:auto; padding:10px 18px;\" onclick=\"animarRota()\">\342\226\267 Animar rota</button>\n\n            <div class=\"map-canvas\">\n                <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 300 200\">\n                    <path d=\"M 55 155 Q 140 110 235 45\" stroke=\"#1A3026\" stroke-width=\"3\" stroke-dasharray=\"5,5\" fill=\"none\"/>\n                </svg>\n                <div class=\"map-pin\" style=\"top:18px; right:18px; color:#A33;\">\360\237\223\215 Destino: Peru</div>\n                <div id=\"truck-el\" class=\"truck-marker\">\360\237\232\232</div>\n                <div class=\"map-pin\" style=\"bottom:18px; left:18px; color:#2B4C3B;\">\360\237\223\215 Origem: Sudoeste/PR</div>\n                <span id=\"route-status\" style=\"position:absolute; bottom:12px; right:14px; font-size:0.7rem; color:var(--text-muted);\">\342\227\217 Pronto para iniciar</span>\n            </div>\n            <p style=\"font-size:0.78rem; color:var(--text-muted);\">A rota est\303\241 pronta para anima\303\247\303\243o.</p>\n        </div>\n\n        <div class=\"card-mint\">\n            <span class=\"eyebrow\">SUPORTE CHATBOT</span>\n            <h2 class=\"serif-title\" style=\"font-size:1.55rem; margin-bottom:8px;\">Uma primeira resposta, quando voc\303\252 precisa.</h2>\n            <p style=\"font-size:0.8rem; color:var(--text-muted); margin-bottom:14px;\">Converse com nosso assistente demonstrativo sobre documenta\303\247\303\243o, rastreamento, prazos, Peru e alf\303\242ndega.</p>\n\n            <div class=\"card\" style=\"padding:14px;\">\n                <div id=\"chat-history\" style=\"background:var(--bg-mint); border-radius:12px; padding:12px; min-height:140px; max-height:220px; overflow-y:auto; display:flex; flex-direction:column; gap:8px; margin-bottom:10px;\">\n                    <div style=\"background:#FFFFFF; padding:10px 12px; border-radius:12px; font-size:0.8rem; line-height:1.4; max-width:85%;\">\n                        Ol\303\241! Posso ajudar com documenta\303\247\303\243o, rastreamento e log\303\255stica internacional. Como posso orientar voc\303\252?\n                    </div>\n                </div>\n                <input type=\"text\" id=\"chat-msg-input\" placeholder=\"Digite sua pergunta\" style=\"margin-bottom:8px;\">\n                <button class=\"btn-green\" onclick=\"enviarChat()\">Enviar</button>\n            </div>\n        </div>\n    </section>\n\n    <!-- TELA 9: GUIA ADUANEIRO DIGITAL -->\n    <section id=\"screen-guia\" class=\"screen hidden\">\n        <div>\n            <span class=\"eyebrow\">GUIA ADUANEIRO DIGITAL</span>\n            <h2 class=\"serif-title\" style=\"font-size:1.65rem; margin-bottom:12px;\">Pesquise antes de movimentar.</h2>\n            <button class=\"btn-green\" style=\"margin-bottom:12px;\" onclick=\"alert(\'Consulta NCM: Ferro / Insumos \342\200\224 C\303\263digo 7200.00.00 (Al\303\255quota IPI/II conforme acordo Mercosul-Peru).\')\">CONSULTAR NCM</button>\n            <p style=\"font-size:0.82rem; color:var(--text-muted);\">Encontre pontos de partida para as d\303\272vidas mais recorrentes de uma opera\303\247\303\243o internacional.</p>\n        </div>\n\n        <div class=\"form-group\" style=\"margin:0;\">\n            <label>Buscar por produto ou assunto</label>\n            <input type=\"text\" placeholder=\"Ex.: certificado de origem ou alf\303\242ndega Peru\">\n        </div>\n\n        <div class=\"card\" style=\"padding:16px; cursor:pointer;\" onclick=\"navigate(\'screen-docs\')\">\n            <strong style=\"font-size:0.9rem;\">\342\226\270 Documentos de exporta\303\247\303\243o</strong>\n            <p style=\"font-size:0.78rem; color:var(--text-muted); margin-top:4px;\">Documentos comerciais e log\303\255sticos que estruturam a opera\303\247\303\243o.</p>\n        </div>\n\n        <div class=\"card\" style=\"padding:16px; cursor:pointer;\" onclick=\"navigate(\'screen-docs\')\">\n            <strong style=\"font-size:0.9rem;\">\342\226\270 Certificado de origem</strong>\n            <p style=\"font-size:0.78rem; color:var(--text-muted); margin-top:4px;\">Comprova\303\247\303\243o da origem da mercadoria em condi\303\247\303\265es aplic\303\241veis.</p>\n        </div>\n\n        <div class=\"card-dark\" style=\"cursor:pointer;\" onclick=\"navigate(\'screen-perfil\')\">\n            <span class=\"eyebrow\" style=\"color:#A8BDB2;\">MINHA CONTA</span>\n            <h3 class=\"serif-title\" style=\"font-size:1.45rem; margin-bottom:6px;\">Perfil do Usu\303\241rio</h3>\n            <p style=\"font-size:0.8rem; color:#D4DFD9; margin-bottom:14px;\">Gerencie seus dados e prefer\303\252ncias no aplicativo BraPex.</p>\n            <div style=\"background:#F7F1DC; color:#5C4D26; padding:10px 14px; border-radius:10px; font-size:0.76rem; font-weight:600; text-align:center;\">\n                As informa\303\247\303\265es do perfil s\303\243o puxadas automaticamente pelo Gov.\n            </div>\n        </div>\n    </section>\n\n    <!-- TELA 10: PERFIL DO USU\303\201RIO -->\n    <section id=\"screen-perfil\" class=\"screen hidden\" style=\"padding:0;\">\n        <div style=\"background:var(--bg-mint); padding:28px 20px; text-align:center;\">\n            <div style=\"width:68px; height:68px; background:var(--primary-green); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.4rem; font-weight:700; margin:0 auto 12px;\">PA</div>\n            <h3 style=\"font-size:1.1rem;\">Paula Andrades Gomes Oliveira</h3>\n            <p style=\"font-size:0.8rem; color:var(--text-muted);\">paula.andrade@exemplo.com</p>\n        </div>\n\n        <div style=\"padding:20px; display:flex; flex-direction:column; gap:16px;\">\n            <div class=\"card\">\n                <span class=\"eyebrow\" style=\"margin-bottom:12px;\">INFORMA\303\207\303\225ES PESSOAIS</span>\n                <div class=\"form-group\">\n                    <label>Nome completo</label>\n                    <input type=\"text\" value=\"Paula Andrades Gomes oliveira\">\n                </div>\n                <div class=\"form-group\">\n                    <label>E-mail</label>\n                    <input type=\"email\" value=\"paula.andrade@exemplo.com\">\n                </div>\n                <div class=\"form-group\">\n                    <label>CPF/CNPJ</label>\n                    <input type=\"text\" value=\"25478.578.567\">\n                </div>\n                <div class=\"form-group\">\n                    <label>Nome da empresa</label>\n                    <input type=\"text\" placeholder=\"Informe a raz\303\243o social\">\n                </div>\n                <div class=\"form-group\" style=\"margin:0;\">\n                    <label>Localiza\303\247\303\243o</label>\n                    <input type=\"text\" value=\"S\303\243o Paulo, Brasil\">\n                </div>\n            </div>\n\n            <div class=\"card\">\n                <span class=\"eyebrow\">ACESSO R\303\201PIDO</span>\n                <div class=\"list-row\" style=\"padding:10px 0;\"><span>Alterar idioma</span><span>PT / ES</span></div>\n            </div>\n        </div>\n    </section>\n\n    <footer class=\"app-footer\">\n        <h4>BRAPEX</h4>\n        <p>Demonstra\303\247\303\243o interativa de uma experi\303\252ncia BRAPEX. Consulte especialistas para decis\303\265es operacionais e aduaneiras.</p>\n    </footer>\n\n</div>\n\n<script>\n    let docsAnexados = 0;\n    let brlParaPen = true;\n\n    function navigate(screenId) {\n        document.querySelectorAll(\'.app-shell > section\').forEach(sec => sec.classList.add(\'hidden\'));\n        document.getElementById(screenId).classList.remove(\'hidden\');\n        document.getElementById(\'nav-menu\').classList.add(\'hidden\');\n\n        const navbar = document.getElementById(\'main-navbar\');\n        if (screenId === \'screen-login\') {\n            navbar.classList.add(\'hidden\');\n        } else {\n            navbar.classList.remove(\'hidden\');\n        }\n        window.scrollTo(0, 0);\n    }\n\n    function toggleMenu() {\n        document.getElementById(\'nav-menu\').classList.toggle(\'hidden\');\n    }\n\n    function converterMoeda() {\n        const val = parseFloat(document.getElementById(\'input-brl\').value) || 0;\n        const result = brlParaPen ? (val * 0.68).toFixed(2) + \' S/.\' : \'R$ \' + (val / 0.68).toFixed(2);\n        document.getElementById(\'output-pen\').value = result.replace(\'.\', \',\');\n    }\n\n    function inverterMoeda() {\n        brlParaPen = !brlParaPen;\n        converterMoeda();\n    }\n\n    function setFluxo(btn) {\n        btn.parentElement.querySelectorAll(\'.pill-btn\').forEach(b => b.classList.remove(\'active\'));\n        btn.classList.add(\'active\');\n    }\n\n    function anexarDoc(num, nomeArquivo) {\n        const fileEl = document.getElementById(\'file-\' + num);\n        const badgeEl = document.getElementById(\'badge-\' + num);\n        if (fileEl.innerText === \'Nenhum arquivo selecionado\') {\n            fileEl.innerText = nomeArquivo;\n            badgeEl.innerText = \'Anexado\';\n            badgeEl.style.background = \'#E6F2EB\';\n            badgeEl.style.color = \'#2B4C3B\';\n            docsAnexados++;\n            document.getElementById(\'doc-counter\').innerText = docsAnexados + \' de 3 documentos anexados\';\n            if (docsAnexados === 3) {\n                const glob = document.getElementById(\'doc-global-status\');\n                glob.innerText = \'Conclu\303\255do\';\n                glob.style.background = \'#E6F2EB\';\n                glob.style.color = \'#2B4C3B\';\n            }\n        }\n    }\n\n    function calcularFrete() {\n        const peso = parseFloat(document.getElementById(\'frete-peso\').value) || 0;\n        const res = document.getElementById(\'frete-resultado\');\n        if (peso <= 0) {\n            alert(\'Informe o peso da encomenda.\');\n            return;\n        }\n        const estimativa = (peso * 1.45 + 320).toFixed(2).replace(\'.\', \',\');\n        res.classList.remove(\'hidden\');\n        res.innerHTML = `<strong>Estimativa de Frete Internacional:</strong> R$ ${estimativa} <br><span style=\"font-size:0.75rem; color:#5C6660;\">Prazo estimado: 5 a 7 dias \303\272teis (Modal Rodovi\303\241rio/Aduaneiro).</span>`;\n    }\n\n    function animarRota() {\n        const truck = document.getElementById(\'truck-el\');\n        const status = document.getElementById(\'route-status\');\n        truck.style.left = \'55px\';\n        truck.style.bottom = \'45px\';\n        status.innerText = \'\342\227\217 Em tr\303\242nsito...\';\n        setTimeout(() => {\n            truck.style.left = \'215px\';\n            truck.style.bottom = \'135px\';\n        }, 150);\n        setTimeout(() => {\n            status.innerText = \'\342\227\217 Chegada ao destino (Peru)\';\n        }, 2300);\n    }\n\n    function enviarChat() {\n        const input = document.getElementById(\'chat-msg-input\');\n        const history = document.getElementById(\'chat-history\');\n        if (!input.value.trim()) return;\n\n        const userBubble = document.createElement(\'div\');\n        userBubble.style.cssText = \'background:#1A3026; color:white; padding:10px 12px; border-radius:12px; font-size:0.8rem; align-self:flex-end; max-width:85%;\';\n        userBubble.innerText = input.value;\n        history.appendChild(userBubble);\n\n        input.value = \'\';\n        history.scrollTop = history.scrollHeight;\n\n        setTimeout(() => {\n            const botBubble = document.createElement(\'div\');\n            botBubble.style.cssText = \'background:#FFFFFF; padding:10px 12px; border-radius:12px; font-size:0.8rem; max-width:85%;\';\n            botBubble.innerText = \'Para opera\303\247\303\265es entre o Sudoeste Paulista e o Peru, certifique-se de anexar a Invoice Comercial e o Certificado de Origem na aba Documenta\303\247\303\243o.\';\n            history.appendChild(botBubble);\n            history.scrollTop = history.scrollHeight;\n        }, 600);\n    }\n</script>\n\n</body>\n</html>\n"
    num_lines: 986
    num_bytes: 47482
    line_range_bytes: 14723
  }
}
