              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    keywords: [\'ncm\', \'classificacao\', \'fiscal\', \'codigo\', \'aliquota\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    response: \'O c\303\263digo NCM (Nomenclatura Comum do Mercosul) classifica a mercadoria para fins aduaneiros e fiscais. Gra\303\247as ao Acordo de Complementa\303\247\303\243o Econ\303\264mica ACE 58 entre Brasil e Peru, mais de 98% dos produtos possuem al\303\255quota 0% de Imposto de Importa\303\247\303\243o! Voc\303\252 pode consultar qualquer NCM na ferramenta \"Consulta NCM\" no menu acima.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    keywords: [\'rastreio\', \'rastreamento\', \'onde esta\', \'codigo\', \'brapex2026\', \'prazo\', \'tempo\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    response: \'Voc\303\252 pode rastrear qualquer carga digitando o c\303\263digo na aba \"Rastreamento\". Experimente testar com BRAPEX2026 (Cobre no Porto de Santos) ou BR-PE-001 (Alho Peruano no Corredor Bioce\303\242nico). Nossos prazos m\303\251dios s\303\243o: 10 a 14 dias para o modal Rodovi\303\241rio Transoce\303\242nico e 18 a 22 dias para o modal Mar\303\255timo Santos-Callao.\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
