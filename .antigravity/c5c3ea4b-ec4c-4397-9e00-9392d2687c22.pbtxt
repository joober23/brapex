            }
            lines {
              text: "        const btnEs = document.getElementById(\'btn-lang-es\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (btnPt && btnEs) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            btnPt.style.background = lang === \'pt\' ? \'var(--primary-dark)\' : \'#FFFFFF\';"
