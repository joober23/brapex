  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { TRANSLATIONS, Language } from \'./translations\';\n\nexport default function App() {\n  const [lang, setLang] = useState<Language>(\'pt\');\n  const t = TRANSLATIONS[lang];\n\n  const [currentScreen, setCurrentScreen] = useState<string>(\'screen-login\');\n  const [isMenuOpen, setIsMenuOpen] = useState<boolean>(false);\n  \n  // Conversor de Moedas\n  const [brlVal, setBrlVal] = useState<string>(\'100\');\n  const [penVal, setPenVal] = useState<string>(\'68,00 S/.\');\n  const [brlParaPen, setBrlParaPen] = useState<boolean>(true);\n\n  // Intelig\303\252ncia Comercial\n  const [fluxoBrasil, setFluxoBrasil] = useState<boolean>(true);\n  const [selectedItems, setSelectedItems] = useState<Record<number, boolean>>({});\n\n  // Produtos (altern\303\242ncia de rota)\n  const [routePeToItp, setRoutePeToItp] = useState<boolean>(true);\n\n  // Documenta\303\247\303\243o e Anexos\n  const [doc1Attached, setDoc1Attached] = useState<boolean>(false);\n  const [doc2Attached, setDoc2Attached] = useState<boolean>(false);\n  const [doc3Attached, setDoc3Attached] = useState<boolean>(false);\n\n  // Pagamento\n  const [paymentMethod, setPaymentMethod] = useState<\'pix\' | \'qr\' | \'boleto\'>(\'pix\');\n  const [pixCopied, setPixCopied] = useState<boolean>(false);\n\n  // Frete\n  const [freteProd, setFreteProd] = useState<string>(\'\');\n  const [freteValor, setFreteValor] = useState<string>(\'\');\n  const [fretePeso, setFretePeso] = useState<string>(\'\');\n  const [freteOrigem, setFreteOrigem] = useState<string>(\'Brasil\');\n  const [freteDestino, setFreteDestino] = useState<string>(\'Peru\');\n  const [freteResultado, setFreteResultado] = useState<{ type: \'ok\' | \'err\'; value?: string } | null>(null);\n\n  // Rastreamento e Rota\n  const [trackCode, setTrackCode] = useState<string>(\'BRAPEX2026\');\n  const [truckPos, setTruckPos] = useState<{ left: string; bottom: string }>({ left: \'55px\', bottom: \'45px\' });\n  const [routeStage, setRouteStage] = useState<\'ready\' | \'moving\' | \'arrived\'>(\'ready\');\n\n  // Guia Aduaneiro NCM inline feedback\n  const [showNcmInfo, setShowNcmInfo] = useState<boolean>(false);\n\n  // Chatbot\n  const [chatMessages, setChatMessages] = useState<Array<{ sender: \'bot\' | \'user\'; key?: \'greeting\' | \'docs\' | \'pay\' | \'track\' | \'fx\' | \'default\'; text?: string }>>([\n    { sender: \'bot\', key: \'greeting\' }\n  ]);\n  const [chatInput, setChatInput] = useState<string>(\'\');\n\n  // Sync document language attribute\n  useEffect(() => {\n    document.documentElement.lang = lang === \'pt\' ? \'pt-BR\' : \'es\';\n  }, [lang]);\n\n  // Total docs\n  const totalDocs = (doc1Attached ? 1 : 0) + (doc2Attached ? 1 : 0) + (doc3Attached ? 1 : 0);\n\n  // Navega\303\247\303\243o\n  const navigate = (screenId: string) => {\n    setCurrentScreen(screenId);\n    setIsMenuOpen(false);\n    window.scrollTo(0, 0);\n  };\n\n  const toggleMenu = () => {\n    setIsMenuOpen(!isMenuOpen);\n  };\n\n  // Fun\303\247\303\265es de C\303\242mbio\n  const handleBrlChange = (valStr: string) => {\n    setBrlVal(valStr);\n    const val = parseFloat(valStr) || 0;\n    if (brlParaPen) {\n      setPenVal((val * 0.68).toFixed(2).replace(\'.\', \',\') + \' S/.\');\n    } else {\n      setPenVal(\'R$ \' + (val / 0.68).toFixed(2).replace(\'.\', \',\'));\n    }\n  };\n\n  const inverterMoeda = () => {\n    const nextMode = !brlParaPen;\n    setBrlParaPen(nextMode);\n    const val = parseFloat(brlVal) || 0;\n    if (nextMode) {\n      setPenVal((val * 0.68).toFixed(2).replace(\'.\', \',\') + \' S/.\');\n    } else {\n      setPenVal(\'R$ \' + (val / 0.68).toFixed(2).replace(\'.\', \',\'));\n    }\n  };\n\n  const converterMoeda = () => {\n    const val = parseFloat(brlVal) || 0;\n    if (brlParaPen) {\n      setPenVal((val * 0.68).toFixed(2).replace(\'.\', \',\') + \' S/.\');\n    } else {\n      setPenVal(\'R$ \' + (val / 0.68).toFixed(2).replace(\'.\', \',\'));\n    }\n  };\n\n  // Frete\n  const calcularFrete = () => {\n    const peso = parseFloat(fretePeso) || 0;\n    if (peso <= 0) {\n      setFreteResultado({ type: \'err\' });\n      return;\n    }\n    const estimativa = (peso * 1.45 + 320).toFixed(2).replace(\'.\', \',\');\n    setFreteResultado({ type: \'ok\', value: estimativa });\n  };\n\n  // Anima\303\247\303\243o de Rota\n  const animarRota = () => {\n    setTruckPos({ left: \'55px\', bottom: \'45px\' });\n    setRouteStage(\'moving\');\n    setTimeout(() => {\n      setTruckPos({ left: \'215px\', bottom: \'135px\' });\n    }, 150);\n    setTimeout(() => {\n      setRouteStage(\'arrived\');\n    }, 2300);\n  };\n\n  // Enviar Chat\n  const enviarChat = () => {\n    if (!chatInput.trim()) return;\n    const text = chatInput.trim();\n    setChatMessages((prev) => [...prev, { sender: \'user\', text }]);\n    setChatInput(\'\');\n\n    setTimeout(() => {\n      let key: \'docs\' | \'pay\' | \'track\' | \'fx\' | \'default\' = \'default\';\n      const q = text.toLowerCase();\n      if (q.includes(\'document\') || q.includes(\'invoice\') || q.includes(\'factura\') || q.includes(\'origem\') || q.includes(\'origen\')) {\n        key = \'docs\';\n      } else if (q.includes(\'taxa\') || q.includes(\'tasa\') || q.includes(\'pix\') || q.includes(\'245\') || q.includes(\'pago\')) {\n        key = \'pay\';\n      } else if (q.includes(\'rastrei\') || q.includes(\'rastreo\') || q.includes(\'brapex2026\') || q.includes(\'lote\')) {\n        key = \'track\';\n      } else if (q.includes(\'moeda\') || q.includes(\'moneda\') || q.includes(\'sol\') || q.includes(\'cambio\')) {\n        key = \'fx\';\n      }\n\n      setChatMessages((prev) => [...prev, { sender: \'bot\', key }]);\n    }, 600);\n  };\n\n  const copyPix = () => {\n    navigator.clipboard?.writeText(\'00020126580014br.gov.bcb.pix0136brapex-receita-gov@tesouro.gov.br5204000053039865406245.005802BR5925BRAPEX LOGISTICA ITAPETI6009SAO PAULO62140510BRAPEX2026\');\n    setPixCopied(true);\n    setTimeout(() => setPixCopied(false), 3000);\n  };\n\n  const getBotText = (msg: { key?: \'greeting\' | \'docs\' | \'pay\' | \'track\' | \'fx\' | \'default\'; text?: string }) => {\n    if (msg.text) return msg.text;\n    switch (msg.key) {\n      case \'greeting\': return t.chatGreeting;\n      case \'docs\': return t.chatReplyDocs;\n      case \'pay\': return t.chatReplyPay;\n      case \'track\': return t.chatReplyTrack;\n      case \'fx\': return t.chatReplyFx;\n      default: return t.chatReplyDefault;\n    }\n  };\n\n  const routeStatusText =\n    routeStage === \'ready\' ? t.routeReady : routeStage === \'moving\' ? t.routeMoving : t.routeArrived;\n\n  return (\n    <div className=\"app-shell\">\n      \n      {/* MENU OVERLAY */}\n      {isMenuOpen && (\n        <div id=\"nav-menu\" className=\"menu-overlay\" onClick={toggleMenu}>\n          <div className=\"menu-panel\" onClick={(e) => e.stopPropagation()}>\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', marginBottom: \'10px\' }}>\n              <strong style={{ fontSize: \'1.1rem\' }}>{t.menuTitle}</strong>\n              <button className=\"icon-btn\" onClick={toggleMenu}>\342\234\225</button>\n            </div>\n            <button className=\"btn-outline\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-dashboard\')}>{t.menuDashboard}</button>\n            <button className=\"btn-outline\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-inteligencia\')}>{t.menuIntel}</button>\n            <button className=\"btn-outline\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-produtos\')}>{t.menuProducts}</button>\n            <button className=\"btn-outline\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-docs\')}>{t.menuDocs}</button>\n            <button className=\"btn-outline\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-frete\')}>{t.menuFreight}</button>\n            <button className=\"btn-outline\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-rastreamento\')}>{t.menuTracking}</button>\n            <button className=\"btn-outline\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-guia\')}>{t.menuGuide}</button>\n            <button className=\"btn-outline\" style={{ textAlign: \'left\' }} onClick={() => navigate(\'screen-perfil\')}>{t.menuProfile}</button>\n            <button className=\"btn-outline\" style={{ textAlign: \'left\', color: \'#A33\' }} onClick={() => navigate(\'screen-login\')}>{t.menuLogout}</button>\n          </div>\n        </div>\n      )}\n\n      {/* NAVBAR */}\n      {currentScreen !== \'screen-login\' && (\n        <header id=\"main-navbar\" className=\"navbar\">\n          <span className=\"brand-logo\" onClick={() => navigate(\'screen-dashboard\')}>BraPex</span>\n          <div className=\"nav-actions\">\n            <button className=\"icon-btn\" title={t.navProfileTitle} onClick={() => navigate(\'screen-perfil\')}>\360\237\221\244</button>\n            <button className=\"icon-btn\" title={t.navMenuTitle} onClick={toggleMenu}>\342\230\260</button>\n          </div>\n        </header>\n      )}\n\n      {/* TELA 1: ENTRADA / LOGIN */}\n      {currentScreen === \'screen-login\' && (\n        <section id=\"screen-login\" style={{ display: \'flex\', flexDirection: \'column\', flex: 1 }}>\n          <div className=\"login-hero\">\n            <h1>{t.loginHero}</h1>\n          </div>\n          <div style={{ padding: \'20px\', marginTop: \'-24px\' }}>\n            <div style={{ width: \'44px\', height: \'44px\', background: \'var(--primary-dark)\', color: \'white\', borderRadius: \'12px\', display: \'flex\', alignItems: \'center\', justifyContent: \'center\', marginBottom: \'16px\', fontWeight: \'bold\' }}>\n              \342\207\204\n            </div>\n            <div className=\"card\" style={{ textAlign: \'center\' }}>\n              <span className=\"eyebrow\">{t.loginEyebrow}</span>\n              <h2 className=\"serif-title\" style={{ fontSize: \'1.65rem\', marginBottom: \'10px\' }}>{t.loginTitle}</h2>\n              <p style={{ fontSize: \'0.88rem\', color: \'var(--text-muted)\', marginBottom: \'22px\' }}>{t.loginSub}</p>\n              <button className=\"btn-primary\" style={{ marginBottom: \'14px\' }} onClick={() => navigate(\'screen-dashboard\')}>\n                {t.loginGovBtn}\n              </button>\n              <div style={{ display: \'flex\', gap: \'10px\' }}>\n                <button className=\"btn-outline\" onClick={() => navigate(\'screen-guia\')}>{t.loginHelpBtn}</button>\n                <button className=\"btn-outline\" onClick={() => navigate(\'screen-rastreamento\')}>{t.loginContactBtn}</button>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* TELA 2: DASHBOARD INICIAL */}\n      {currentScreen === \'screen-dashboard\' && (\n        <section id=\"screen-dashboard\" className=\"screen\" style={{ background: \'var(--bg-mint)\' }}>\n          <div>\n            <span className=\"eyebrow\">{t.dashEyebrow}</span>\n            <h2 className=\"serif-title\" style={{ fontSize: \'1.85rem\' }}>{t.dashHello}</h2>\n          </div>\n\n          <div className=\"card-dark\" style={{ cursor: \'pointer\' }} onClick={() => navigate(\'screen-inteligencia\')}>\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'flex-start\' }}>\n              <div>\n                <span className=\"eyebrow\" style={{ color: \'#A8BDB2\' }}>{t.highlightTag}</span>\n                <h3 style={{ fontSize: \'1.1rem\', marginBottom: \'6px\' }}>{t.intelTitle}</h3>\n                <p style={{ fontSize: \'0.8rem\', color: \'#D4DFD9\', lineHeight: 1.4 }}>{t.intelDesc}</p>\n              </div>\n              <span style={{ fontSize: \'1.2rem\' }}>\342\206\227</span>\n            </div>\n          </div>\n\n          <div className=\"card-dark\">\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', marginBottom: \'6px\' }}>\n              <span className=\"eyebrow\" style={{ color: \'#A8BDB2\', margin: 0 }}>{t.fxTag}</span>\n              <span style={{ background: \'#FFFFFF\', color: \'var(--primary-dark)\', fontSize: \'0.65rem\', fontWeight: 800, padding: \'4px 10px\', borderRadius: \'20px\' }}>{t.fxBadge}</span>\n            </div>\n            <h3 style={{ fontSize: \'1.1rem\', marginBottom: \'4px\' }}>{t.fxTitle}</h3>\n            <p style={{ fontSize: \'0.8rem\', color: \'#D4DFD9\', marginBottom: \'14px\' }}>{t.fxSub}</p>\n            <div style={{ display: \'flex\', alignItems: \'center\', gap: \'8px\', marginBottom: \'12px\' }}>\n              <input type=\"number\" id=\"input-brl\" value={brlVal} onChange={(e) => handleBrlChange(e.target.value)} placeholder=\"0,00\" />\n              <button onClick={inverterMoeda} style={{ background: \'#EAE7DF\', border: \'none\', borderRadius: \'10px\', padding: \'10px\', cursor: \'pointer\', fontWeight: \'bold\' }}>\342\207\204</button>\n              <input type=\"text\" id=\"output-pen\" value={penVal} readOnly style={{ background: \'#F4F4F4\' }} />\n            </div>\n            <button className=\"btn-outline\" style={{ width: \'100%\', border: \'none\' }} onClick={converterMoeda}>{t.fxBtn}</button>\n            <p style={{ fontSize: \'0.7rem\', color: \'#A8BDB2\', marginTop: \'10px\' }}>{t.fxNote}</p>\n          </div>\n\n          <a\n            href=\"https://comexstat.mdic.gov.br/pt/home\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"card-dark\"\n            style={{ cursor: \'pointer\', display: \'block\', textDecoration: \'none\', color: \'#FFFFFF\' }}\n          >\n            <div style={{ display: \'flex\', alignItems: \'center\', gap: \'14px\' }}>\n              <div style={{ background: \'#EAE7DF\', color: \'var(--primary-dark)\', width: \'42px\', height: \'42px\', borderRadius: \'12px\', display: \'flex\', alignItems: \'center\', justifyContent: \'center\', fontSize: \'1.2rem\', flexShrink: 0 }}>\360\237\214\220</div>\n              <div style={{ flex: 1 }}>\n                <span className=\"eyebrow\" style={{ color: \'#A8BDB2\' }}>{t.highlightTag}</span>\n                <h3 style={{ fontSize: \'1rem\', marginBottom: \'4px\' }}>{t.radarTitle}</h3>\n                <p style={{ fontSize: \'0.76rem\', color: \'#D4DFD9\' }}>{t.radarDesc}</p>\n              </div>\n              <span>\342\206\222</span>\n            </div>\n          </a>\n\n          <div className=\"shortcut-grid\">\n            <div className=\"shortcut-card\" onClick={() => navigate(\'screen-docs\')}>\n              <span style={{ fontSize: \'1.4rem\' }}>\360\237\223\204</span>\n              <h4>{t.shortDocsTitle}</h4>\n              <p>{t.shortDocsDesc}</p>\n            </div>\n            <div className=\"shortcut-card\" onClick={() => navigate(\'screen-rastreamento\')}>\n              <span style={{ fontSize: \'1.4rem\' }}>\360\237\224\215</span>\n              <h4>{t.shortTrackTitle}</h4>\n              <p>{t.shortTrackDesc}</p>\n            </div>\n            <div className=\"shortcut-card\" onClick={() => navigate(\'screen-guia\')}>\n              <span style={{ fontSize: \'1.4rem\' }}>\360\237\247\276</span>\n              <h4>{t.shortNcmTitle}</h4>\n              <p>{t.shortNcmDesc}</p>\n            </div>\n            <div className=\"shortcut-card\" onClick={() => {\n              const el = document.getElementById(\'input-brl\');\n              el?.focus();\n            }}>\n              <span style={{ fontSize: \'1.4rem\' }}>\342\207\204</span>\n              <h4>{t.shortFxTitle}</h4>\n              <p>{t.shortFxDesc}</p>\n            </div>\n            <div className=\"shortcut-card\" onClick={() => navigate(\'screen-frete\')}>\n              <span style={{ fontSize: \'1.4rem\' }}>\360\237\232\232</span>\n              <h4>{t.shortFreightTitle}</h4>\n              <p>{t.shortFreightDesc}</p>\n            </div>\n          </div>\n\n          <div className=\"card-mint\" style={{ border: \'1px solid #C8D6CD\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-rastreamento\')}>\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', marginBottom: \'8px\' }}>\n              <span className=\"eyebrow\" style={{ margin: 0 }}>{t.trackCardEyebrow}</span>\n              <span>\342\206\227</span>\n            </div>\n            <p style={{ fontSize: \'0.85rem\', fontWeight: 700, marginBottom: \'10px\' }}>{t.trackCardSteps}</p>\n            <div style={{ display: \'grid\', gridTemplateColumns: \'1fr 1fr\', gap: \'6px\', fontSize: \'0.78rem\' }}>\n              <div><strong>{t.trackLotLabel}</strong> BRP-2026-001</div>\n              <div><strong>{t.trackProdLabel}</strong> {t.trackProdVal}</div>\n              <div><strong>{t.trackLocLabel}</strong> {t.trackLocVal}</div>\n              <div><strong>{t.trackEtaLabel}</strong> {t.trackEtaVal}</div>\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* TELA 3: INTELIG\303\212NCIA COMERCIAL */}\n      {currentScreen === \'screen-inteligencia\' && (\n        <section id=\"screen-inteligencia\" className=\"screen\" style={{ background: \'var(--bg-mint)\' }}>\n          <div className=\"card\">\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\' }}>\n              <span className=\"eyebrow\" style={{ margin: 0 }}>{t.intelTitle.toUpperCase()}</span>\n              <span style={{ background: \'#E6F2EB\', color: \'#2B4C3B\', fontSize: \'0.65rem\', fontWeight: 700, padding: \'4px 10px\', borderRadius: \'20px\' }}>{t.intelActive}</span>\n            </div>\n            <h2 className=\"serif-title\" style={{ fontSize: \'1.65rem\', margin: \'6px 0 16px\' }}>{t.intelHeading}</h2>\n\n            <div className=\"pill-switch\">\n              <button \n                className={`pill-btn ${fluxoBrasil ? \'active\' : \'\'}`} \n                onClick={() => setFluxoBrasil(true)}\n              >\n                {t.intelFlowBr}\n              </button>\n              <button \n                className={`pill-btn ${!fluxoBrasil ? \'active\' : \'\'}`} \n                onClick={() => setFluxoBrasil(false)}\n              >\n                {t.intelFlowPe}\n              </button>\n            </div>\n\n            <div className=\"form-group\">\n              <label>{t.intelCityLabel}</label>\n              <input type=\"text\" placeholder={t.intelCityPlaceholder} defaultValue=\"Itapetininga, Brasil\" />\n            </div>\n\n            <div className=\"form-group\">\n              <label>{t.intelSearchLabel}</label>\n              <input type=\"text\" placeholder={t.intelSearchPlaceholder} />\n            </div>\n\n            <div style={{ border: \'1px solid var(--border-light)\', borderRadius: \'14px\', overflow: \'hidden\', marginBottom: \'10px\' }}>\n              {t.intelItems.map((item, idx) => (\n                <div \n                  key={idx} \n                  className={`list-row ${selectedItems[idx] ? \'selected\' : \'\'}`}\n                  onClick={() => setSelectedItems((prev) => ({ ...prev, [idx]: !prev[idx] }))}\n                >\n                  <span>{item}</span>\n                  <span>{selectedItems[idx] ? \'\342\234\223\' : \'+\'}</span>\n                </div>\n              ))}\n            </div>\n            <p style={{ fontSize: \'0.75rem\', color: \'var(--text-muted)\', marginBottom: \'14px\' }}>{t.intelHint}</p>\n\n            <button className=\"btn-green\" onClick={() => navigate(\'screen-produtos\')}>{t.intelSearchBtn}</button>\n          </div>\n        </section>\n      )}\n\n      {/* TELA 4: PRODUTOS DE EXPORTA\303\207\303\203O */}\n      {currentScreen === \'screen-produtos\' && (\n        <section id=\"screen-produtos\" className=\"screen\">\n          <div>\n            <span className=\"eyebrow\">{t.prodEyebrow}</span>\n            <h2 className=\"serif-title\" style={{ fontSize: \'1.65rem\' }}>{t.prodTitle}</h2>\n            <p style={{ fontSize: \'0.85rem\', color: \'var(--text-muted)\' }}>{t.prodSub}</p>\n          </div>\n\n          <div className=\"form-group\" style={{ margin: 0 }}>\n            <label>{t.prodSearchLabel}</label>\n            <input type=\"text\" placeholder={t.prodSearchPlaceholder} />\n          </div>\n\n          <div style={{ display: \'flex\', gap: \'8px\' }}>\n            <button \n              className={routePeToItp ? \'btn-primary\' : \'btn-outline\'} \n              style={{ fontSize: \'0.78rem\', padding: \'12px\' }}\n              onClick={() => setRoutePeToItp(true)}\n            >\n              {t.prodRoutePeToItp}\n            </button>\n            <button \n              className={!routePeToItp ? \'btn-primary\' : \'btn-outline\'} \n              style={{ fontSize: \'0.78rem\', padding: \'12px\' }}\n              onClick={() => setRoutePeToItp(false)}\n            >\n              {t.prodRouteItpToPe}\n            </button>\n          </div>\n\n          <div style={{ display: \'grid\', gridTemplateColumns: \'1fr 1.1fr\', gap: \'10px\' }}>\n            <div className=\"card-mint\" style={{ border: \'1px solid var(--primary-dark)\', display: \'flex\', flexDirection: \'column\', justifyContent: \'center\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-docs\')}>\n              <strong style={{ fontSize: \'0.9rem\' }}>{t.prodIron}</strong>\n              <span style={{ fontSize: \'0.72rem\', color: \'var(--text-muted)\', marginTop: \'6px\' }}>{t.prodClickStart}</span>\n            </div>\n\n            <div className=\"card\" style={{ padding: \'14px\' }}>\n              <strong style={{ fontSize: \'0.82rem\', display: \'block\', marginBottom: \'4px\' }}>{t.prodSuppliersTitle}</strong>\n              <p style={{ fontSize: \'0.68rem\', color: \'var(--text-muted)\', marginBottom: \'10px\' }}>{t.prodSuppliersNote}</p>\n              \n              <div style={{ borderBottom: \'1px solid var(--border-light)\', paddingBottom: \'8px\', marginBottom: \'8px\', fontSize: \'0.76rem\' }}>\n                <strong>Shougang Hierro Per\303\272</strong> \360\237\207\265\360\237\207\252<br />\n                <span style={{ color: \'var(--primary-green)\', fontWeight: 700 }}>US$ 850 / ton</span>\n              </div>\n              <div style={{ fontSize: \'0.76rem\' }}>\n                <strong>Empresa Sider\303\272rgica del Per\303\272 (SIDERPERU)</strong> \360\237\207\265\360\237\207\252<br />\n                <span style={{ color: \'var(--primary-green)\', fontWeight: 700 }}>US$ 890 / ton</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"shortcut-grid\">\n            <div className=\"card\" style={{ padding: \'14px\', fontWeight: 600, fontSize: \'0.85rem\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-docs\')}>{t.prodCopper}</div>\n            <div className=\"card\" style={{ padding: \'14px\', fontWeight: 600, fontSize: \'0.85rem\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-docs\')}>{t.prodGarlic}</div>\n            <div className=\"card\" style={{ padding: \'14px\', fontWeight: 600, fontSize: \'0.85rem\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-docs\')}>{t.prodFishmeal}</div>\n          </div>\n        </section>\n      )}\n\n      {/* TELA 5: FLUXO DOCUMENTAL E ANEXOS */}\n      {currentScreen === \'screen-docs\' && (\n        <section id=\"screen-docs\" className=\"screen\">\n          <div className=\"card-dark\">\n            <span className=\"eyebrow\" style={{ color: \'#A8BDB2\' }}>{t.docsEyebrow}</span>\n            <h2 className=\"serif-title\" style={{ fontSize: \'1.55rem\', marginBottom: \'8px\' }}>{t.docsTitle}</h2>\n            <p style={{ fontSize: \'0.8rem\', color: \'#D4DFD9\', marginBottom: \'16px\' }}>{t.docsSub}</p>\n            \n            <div style={{ background: \'#FFFFFF\', color: \'var(--text-dark)\', borderRadius: \'16px\', padding: \'16px\' }}>\n              <strong style={{ fontSize: \'0.9rem\', display: \'block\', marginBottom: \'10px\' }}>{t.docsChecklistTitle}</strong>\n              <label style={{ fontSize: \'0.78rem\', display: \'block\', marginBottom: \'6px\' }}>{t.docsChecklistLabel}</label>\n              <select style={{ marginBottom: \'10px\' }} defaultValue=\"iron\">\n                <option value=\"iron\">{t.docsOptIron}</option>\n                <option value=\"copper\">{t.docsOptCopper}</option>\n                <option value=\"wood\">{t.docsOptWood}</option>\n                <option value=\"corn\">{t.docsOptCorn}</option>\n              </select>\n              <button className=\"btn-outline\" style={{ width: \'100%\' }}>{t.docsConfirmBtn}</button>\n            </div>\n          </div>\n\n          <div className=\"card\">\n            <span className=\"eyebrow\">{t.docsFlowEyebrow}</span>\n            <h3 className=\"serif-title\" style={{ fontSize: \'1.3rem\', marginBottom: \'8px\' }}>{t.docsFlowTitle}</h3>\n            <span style={{ background: \'var(--bg-mint)\', padding: \'5px 10px\', borderRadius: \'8px\', fontSize: \'0.75rem\', fontWeight: 600, display: \'inline-block\', marginBottom: \'14px\' }}>\n              {t.docsNcmBadge}\n            </span>\n\n            <div className=\"form-group\">\n              <label>{t.docsQtyLabel}</label>\n              <input type=\"number\" id=\"doc-kg\" placeholder={t.docsQtyPlaceholder} defaultValue=\"1000\" />\n            </div>\n            <div className=\"form-group\">\n              <label>{t.docsOriginLabel}</label>\n              <input type=\"text\" defaultValue={t.docsOriginDefault} />\n            </div>\n            <div className=\"form-group\">\n              <label>{t.docsDestLabel}</label>\n              <input type=\"text\" defaultValue={t.docsDestDefault} />\n            </div>\n\n            <div style={{ background: \'#FAF3E3\', padding: \'12px\', borderRadius: \'12px\', fontSize: \'0.75rem\', color: \'#7A5C20\', marginBottom: \'14px\' }}>\n              {t.docsNotice}\n            </div>\n\n            <div style={{ display: \'flex\', flexDirection: \'column\', gap: \'10px\', marginBottom: \'16px\' }}>\n              <div className=\"card\" style={{ padding: \'14px\' }}>\n                <div style={{ display: \'flex\', justifyContent: \'space-between\', marginBottom: \'6px\' }}>\n                  <strong style={{ fontSize: \'0.88rem\' }}>{t.doc1Title}</strong>\n                  <span id=\"badge-1\" style={{ \n                    background: doc1Attached ? \'#E6F2EB\' : \'var(--badge-orange-bg)\', \n                    color: doc1Attached ? \'#2B4C3B\' : \'var(--badge-orange-text)\', \n                    fontSize: \'0.7rem\', padding: \'3px 8px\', borderRadius: \'12px\', fontWeight: 600 \n                  }}>\n                    {doc1Attached ? t.docAttached : t.docPending}\n                  </span>\n                </div>\n                <p id=\"file-1\" style={{ fontSize: \'0.75rem\', color: \'var(--text-muted)\', marginBottom: \'10px\' }}>\n                  {doc1Attached ? \'invoice_comercial.pdf\' : t.docNoFile}\n                </p>\n                <button className=\"btn-green\" style={{ width: \'auto\', padding: \'8px 14px\', fontSize: \'0.8rem\' }} onClick={() => setDoc1Attached(true)}>\n                  {t.docAttachBtn}\n                </button>\n              </div>\n\n              <div className=\"card\" style={{ padding: \'14px\' }}>\n                <div style={{ display: \'flex\', justifyContent: \'space-between\', marginBottom: \'6px\' }}>\n                  <strong style={{ fontSize: \'0.88rem\' }}>{t.doc2Title}</strong>\n                  <span id=\"badge-2\" style={{ \n                    background: doc2Attached ? \'#E6F2EB\' : \'var(--badge-orange-bg)\', \n                    color: doc2Attached ? \'#2B4C3B\' : \'var(--badge-orange-text)\', \n                    fontSize: \'0.7rem\', padding: \'3px 8px\', borderRadius: \'12px\', fontWeight: 600 \n                  }}>\n                    {doc2Attached ? t.docAttached : t.docPending}\n                  </span>\n                </div>\n                <p id=\"file-2\" style={{ fontSize: \'0.75rem\', color: \'var(--text-muted)\', marginBottom: \'10px\' }}>\n                  {doc2Attached ? \'certificado_origem.pdf\' : t.docNoFile}\n                </p>\n                <button className=\"btn-green\" style={{ width: \'auto\', padding: \'8px 14px\', fontSize: \'0.8rem\' }} onClick={() => setDoc2Attached(true)}>\n                  {t.docAttachBtn}\n                </button>\n              </div>\n\n              <div className=\"card\" style={{ padding: \'14px\' }}>\n                <div style={{ display: \'flex\', justifyContent: \'space-between\', marginBottom: \'6px\' }}>\n                  <strong style={{ fontSize: \'0.88rem\' }}>{t.doc3Title}</strong>\n                  <span id=\"badge-3\" style={{ \n                    background: doc3Attached ? \'#E6F2EB\' : \'var(--badge-orange-bg)\', \n                    color: doc3Attached ? \'#2B4C3B\' : \'var(--badge-orange-text)\', \n                    fontSize: \'0.7rem\', padding: \'3px 8px\', borderRadius: \'12px\', fontWeight: 600 \n                  }}>\n                    {doc3Attached ? t.docAttached : t.docPending}\n                  </span>\n                </div>\n                <p id=\"file-3\" style={{ fontSize: \'0.75rem\', color: \'var(--text-muted)\', marginBottom: \'10px\' }}>\n                  {doc3Attached ? \'certificado_qualidade.pdf\' : t.docNoFile}\n                </p>\n                <button className=\"btn-green\" style={{ width: \'auto\', padding: \'8px 14px\', fontSize: \'0.8rem\' }} onClick={() => setDoc3Attached(true)}>\n                  {t.docAttachBtn}\n                </button>\n              </div>\n            </div>\n\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', marginBottom: \'12px\', fontSize: \'0.82rem\' }}>\n              <strong id=\"doc-counter\">{totalDocs} {t.docCounterSuffix}</strong>\n              <span id=\"doc-global-status\" style={{ \n                background: totalDocs === 3 ? \'#E6F2EB\' : \'#E6EEF8\', \n                color: totalDocs === 3 ? \'#2B4C3B\' : \'#2C5E9E\', \n                padding: \'3px 10px\', borderRadius: \'12px\', fontSize: \'0.72rem\', fontWeight: 600 \n              }}>\n                {totalDocs === 3 ? t.docCompleted : t.docPending}\n              </span>\n            </div>\n\n            <button className=\"btn-green\" onClick={() => navigate(\'screen-pagamento\')}>{t.docsPayBtn}</button>\n          </div>\n        </section>\n      )}\n\n      {/* TELA 6: PAGAMENTO PIX */}\n      {currentScreen === \'screen-pagamento\' && (\n        <section id=\"screen-pagamento\" className=\"screen\" style={{ background: \'var(--bg-mint)\' }}>\n          <div style={{ background: \'var(--primary-green)\', color: \'white\', padding: \'22px\', borderRadius: \'20px\' }}>\n            <h2 style={{ fontSize: \'1.35rem\', marginBottom: \'6px\' }}>{t.payTitle}</h2>\n            <p style={{ fontSize: \'0.8rem\', opacity: 0.9 }}>{t.paySub}</p>\n          </div>\n\n          <div className=\"card\">\n            <h3 style={{ fontSize: \'1.05rem\', marginBottom: \'14px\' }}>{t.paySummaryTitle}</h3>\n            <div style={{ display: \'flex\', flexDirection: \'column\', gap: \'10px\', fontSize: \'0.88rem\', marginBottom: \'16px\' }}>\n              <div style={{ display: \'flex\', justifyContent: \'space-between\' }}><span style={{ color: \'var(--text-muted)\' }}>{t.payFeeExport}</span><strong>R$ 180,00</strong></div>\n              <div style={{ display: \'flex\', justifyContent: \'space-between\' }}><span style={{ color: \'var(--text-muted)\' }}>{t.payFeeGov}</span><strong>R$ 45,00</strong></div>\n              <div style={{ display: \'flex\', justifyContent: \'space-between\' }}><span style={{ color: \'var(--text-muted)\' }}>{t.payFeeService}</span><strong>R$ 20,00</strong></div>\n              <hr style={{ border: \'none\', borderTop: \'1px solid var(--border-light)\' }} />\n              <div style={{ display: \'flex\', justifyContent: \'space-between\', fontSize: \'1rem\' }}><strong>{t.payTotal}</strong><strong>R$ 245,00</strong></div>\n            </div>\n\n            <div style={{ display: \'flex\', flexDirection: \'column\', gap: \'8px\', marginBottom: \'16px\' }}>\n              <button \n                className=\"btn-outline\" \n                style={{ textAlign: \'left\', border: paymentMethod === \'pix\' ? \'2px solid var(--primary-dark)\' : undefined }}\n                onClick={() => setPaymentMethod(\'pix\')}\n              >\n                {t.payMethodPix}\n              </button>\n              <button \n                className=\"btn-outline\" \n                style={{ textAlign: \'left\', border: paymentMethod === \'qr\' ? \'2px solid var(--primary-dark)\' : undefined }}\n                onClick={() => setPaymentMethod(\'qr\')}\n              >\n                {t.payMethodQr}\n              </button>\n              <button \n                className=\"btn-outline\" \n                style={{ textAlign: \'left\', border: paymentMethod === \'boleto\' ? \'2px solid var(--primary-dark)\' : undefined }}\n                onClick={() => setPaymentMethod(\'boleto\')}\n              >\n                {t.payMethodBoleto}\n              </button>\n            </div>\n\n            <div className=\"card\" style={{ textAlign: \'center\', background: \'#FAF9F6\' }}>\n              <span className=\"eyebrow\">{t.payPixEyebrow}</span>\n              <h4 style={{ fontSize: \'1.1rem\', marginBottom: \'14px\' }}>{t.payPixTitle}</h4>\n              \n              <div style={{ background: \'white\', padding: \'16px\', borderRadius: \'16px\', display: \'inline-block\', boxShadow: \'0 2px 10px rgba(0,0,0,0.05)\', marginBottom: \'14px\' }}>\n                <svg width=\"140\" height=\"140\" viewBox=\"0 0 100 100\" fill=\"#1A3026\">\n                  <rect x=\"5\" y=\"5\" width=\"25\" height=\"25\" fill=\"none\" stroke=\"#1A3026\" strokeWidth=\"5\"/>\n                  <rect x=\"12\" y=\"12\" width=\"11\" height=\"11\"/>\n                  <rect x=\"70\" y=\"5\" width=\"25\" height=\"25\" fill=\"none\" stroke=\"#1A3026\" strokeWidth=\"5\"/>\n                  <rect x=\"77\" y=\"12\" width=\"11\" height=\"11\"/>\n                  <rect x=\"5\" y=\"70\" width=\"25\" height=\"25\" fill=\"none\" stroke=\"#1A3026\" strokeWidth=\"5\"/>\n                  <rect x=\"12\" y=\"77\" width=\"11\" height=\"11\"/>\n                  <rect x=\"40\" y=\"10\" width=\"8\" height=\"8\"/><rect x=\"52\" y=\"22\" width=\"8\" height=\"8\"/>\n                  <rect x=\"38\" y=\"40\" width=\"12\" height=\"12\"/><rect x=\"58\" y=\"45\" width=\"8\" height=\"16\"/>\n                  <rect x=\"10\" y=\"42\" width=\"14\" height=\"8\"/><rect x=\"42\" y=\"68\" width=\"10\" height=\"10\"/>\n                  <rect x=\"65\" y=\"72\" width=\"20\" height=\"8\"/><rect x=\"75\" y=\"85\" width=\"15\" height=\"8\"/>\n                </svg>\n              </div>\n\n              <div style={{ fontSize: \'1.25rem\', fontWeight: 700, marginBottom: \'4px\' }}>R$ 245,00</div>\n              <p style={{ fontSize: \'0.78rem\', color: \'var(--text-muted)\', marginBottom: \'14px\' }}>{t.payPixDesc}</p>\n              <button className=\"btn-outline\" style={{ width: \'100%\' }} onClick={copyPix}>\n                {pixCopied ? `\342\234\223 ${t.payCopiedFeedback}` : t.payCopyBtn}\n              </button>\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* TELA 7: SIMULADOR DE FRETE */}\n      {currentScreen === \'screen-frete\' && (\n        <section id=\"screen-frete\" className=\"screen\">\n          <div className=\"card\">\n            <span className=\"eyebrow\">{t.freightEyebrow}</span>\n            <h2 className=\"serif-title\" style={{ fontSize: \'1.65rem\', marginBottom: \'8px\' }}>{t.freightTitle}</h2>\n            <p style={{ fontSize: \'0.82rem\', color: \'var(--text-muted)\', marginBottom: \'18px\' }}>{t.freightSub}</p>\n\n            <div className=\"form-group\">\n              <label>{t.freightProdLabel}</label>\n              <select id=\"frete-prod\" value={freteProd} onChange={(e) => setFreteProd(e.target.value)}>\n                <option value=\"\">{t.freightProdPlaceholder}</option>\n                <option value=\"ferro\">{t.freightProdIron}</option>\n                <option value=\"cobre\">{t.freightProdCopper}</option>\n                <option value=\"madeira\">{t.freightProdWood}</option>\n              </select>\n            </div>\n            <div className=\"form-group\">\n              <label>{t.freightValLabel}</label>\n              <input type=\"number\" id=\"frete-valor\" placeholder=\"Ex: 5000\" value={freteValor} onChange={(e) => setFreteValor(e.target.value)} />\n            </div>\n            <div className=\"form-group\">\n              <label>{t.freightWeightLabel}</label>\n              <input type=\"number\" id=\"frete-peso\" placeholder=\"Ex: 1200\" value={fretePeso} onChange={(e) => setFretePeso(e.target.value)} />\n            </div>\n            <div className=\"form-group\">\n              <label>{t.freightOriginLabel}</label>\n              <input type=\"text\" value={freteOrigem} onChange={(e) => setFreteOrigem(e.target.value)} />\n            </div>\n            <div className=\"form-group\">\n              <label>{t.freightDestLabel}</label>\n              <input type=\"text\" placeholder={lang === \'pt\' ? \'Ex: Peru\' : \'Ej: Per\303\272\'} value={freteDestino} onChange={(e) => setFreteDestino(e.target.value)} />\n            </div>\n\n            <button className=\"btn-green\" onClick={calcularFrete}>{t.freightBtn}</button>\n            {freteResultado && (\n              <div id=\"frete-resultado\" style={{ marginTop: \'14px\', padding: \'14px\', background: freteResultado.type === \'err\' ? \'#FDF0E6\' : \'var(--bg-mint)\', borderRadius: \'12px\', fontSize: \'0.85rem\', color: freteResultado.type === \'err\' ? \'#C66A2C\' : \'inherit\' }}>\n                {freteResultado.type === \'err\' ? (\n                  <strong>{t.freightWeightError}</strong>\n                ) : (\n                  <>\n                    <strong>{t.freightEstimatePrefix}</strong> R$ {freteResultado.value}\n                    <br />\n                    <span style={{ fontSize: \'0.75rem\', color: \'#5C6660\' }}>{t.freightEstimateSuffix}</span>\n                  </>\n                )}\n              </div>\n            )}\n          </div>\n        </section>\n      )}\n\n      {/* TELA 8: RASTREAMENTO + CHATBOT */}\n      {currentScreen === \'screen-rastreamento\' && (\n        <section id=\"screen-rastreamento\" className=\"screen\">\n          <div>\n            <span className=\"eyebrow\">{t.trackEyebrow}</span>\n            <h2 className=\"serif-title\" style={{ fontSize: \'1.65rem\', marginBottom: \'6px\' }}>{t.trackTitle}</h2>\n            <p style={{ fontSize: \'0.82rem\', color: \'var(--text-muted)\', marginBottom: \'8px\' }}>{t.trackSub}</p>\n            <p style={{ fontSize: \'0.8rem\', fontWeight: 700 }}>{t.trackTry}</p>\n          </div>\n\n          <div className=\"card\">\n            <input \n              type=\"text\" \n              id=\"track-code\" \n              placeholder={t.trackPlaceholder} \n              value={trackCode} \n              onChange={(e) => setTrackCode(e.target.value)}\n              style={{ marginBottom: \'10px\' }} \n            />\n            <button className=\"btn-green\" onClick={animarRota}>{t.trackBtn}</button>\n          </div>\n\n          <div className=\"card\">\n            <span className=\"eyebrow\">{t.routeEyebrow}</span>\n            <h3 style={{ fontSize: \'1.1rem\', marginBottom: \'4px\' }}>{t.routeTitle}</h3>\n            <p style={{ fontSize: \'0.8rem\', color: \'var(--text-muted)\', marginBottom: \'12px\' }}>{t.routeDesc}</p>\n            \n            <button className=\"btn-green\" style={{ width: \'auto\', padding: \'10px 18px\', marginBottom: \'10px\' }} onClick={animarRota}>{t.routeAnimBtn}</button>\n\n            <div className=\"map-canvas\">\n              <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 300 200\">\n                <path d=\"M 55 155 Q 140 110 235 45\" stroke=\"#1A3026\" strokeWidth=\"3\" strokeDasharray=\"5,5\" fill=\"none\"/>\n              </svg>\n              <div className=\"map-pin\" style={{ top: \'18px\', right: \'18px\', color: \'#A33\' }}>{t.routePinDest}</div>\n              <div id=\"truck-el\" className=\"truck-marker\" style={{ left: truckPos.left, bottom: truckPos.bottom }}>\360\237\232\232</div>\n              <div className=\"map-pin\" style={{ bottom: \'18px\', left: \'18px\', color: \'#2B4C3B\' }}>{t.routePinOrigin}</div>\n              <span id=\"route-status\" style={{ position: \'absolute\', bottom: \'12px\', right: \'14px\', fontSize: \'0.7rem\', color: \'var(--text-muted)\' }}>\n                {routeStatusText}\n              </span>\n            </div>\n            <p style={{ fontSize: \'0.78rem\', color: \'var(--text-muted)\' }}>{t.routeFooterNote}</p>\n          </div>\n\n          <div className=\"card-mint\">\n            <span className=\"eyebrow\">{t.chatEyebrow}</span>\n            <h2 className=\"serif-title\" style={{ fontSize: \'1.55rem\', marginBottom: \'8px\' }}>{t.chatTitle}</h2>\n            <p style={{ fontSize: \'0.8rem\', color: \'var(--text-muted)\', marginBottom: \'14px\' }}>{t.chatSub}</p>\n\n            <div className=\"card\" style={{ padding: \'14px\' }}>\n              <div id=\"chat-history\" style={{ background: \'var(--bg-mint)\', borderRadius: \'12px\', padding: \'12px\', minHeight: \'140px\', maxHeight: \'220px\', overflowY: \'auto\', display: \'flex\', flexDirection: \'column\', gap: \'8px\', marginBottom: \'10px\' }}>\n                {chatMessages.map((msg, i) => (\n                  <div\n                    key={i}\n                    style={{\n                      background: msg.sender === \'user\' ? \'#1A3026\' : \'#FFFFFF\',\n                      color: msg.sender === \'user\' ? \'white\' : \'inherit\',\n                      padding: \'10px 12px\',\n                      borderRadius: \'12px\',\n                      fontSize: \'0.8rem\',\n                      lineHeight: 1.4,\n                      maxWidth: \'85%\',\n                      alignSelf: msg.sender === \'user\' ? \'flex-end\' : \'flex-start\'\n                    }}\n                  >\n                    {getBotText(msg)}\n                  </div>\n                ))}\n              </div>\n              <input \n                type=\"text\" \n                id=\"chat-msg-input\" \n                placeholder={t.chatPlaceholder} \n                value={chatInput} \n                onChange={(e) => setChatInput(e.target.value)}\n                onKeyDown={(e) => { if (e.key === \'Enter\') enviarChat(); }}\n                style={{ marginBottom: \'8px\' }} \n              />\n              <button className=\"btn-green\" onClick={enviarChat}>{t.chatSendBtn}</button>\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* TELA 9: GUIA ADUANEIRO DIGITAL */}\n      {currentScreen === \'screen-guia\' && (\n        <section id=\"screen-guia\" className=\"screen\">\n          <div>\n            <span className=\"eyebrow\">{t.guideEyebrow}</span>\n            <h2 className=\"serif-title\" style={{ fontSize: \'1.65rem\', marginBottom: \'12px\' }}>{t.guideTitle}</h2>\n            <button className=\"btn-green\" style={{ marginBottom: \'12px\' }} onClick={() => setShowNcmInfo((v) => !v)}>\n              {t.guideNcmBtn}\n            </button>\n            {showNcmInfo && (\n              <div style={{ background: \'var(--bg-mint)\', border: \'1px solid var(--primary-green)\', padding: \'12px\', borderRadius: \'12px\', fontSize: \'0.8rem\', marginBottom: \'12px\' }}>\n                {t.guideNcmInfo}\n              </div>\n            )}\n            <p style={{ fontSize: \'0.82rem\', color: \'var(--text-muted)\' }}>{t.guideSub}</p>\n          </div>\n\n          <div className=\"form-group\" style={{ margin: 0 }}>\n            <label>{t.guideSearchLabel}</label>\n            <input type=\"text\" placeholder={t.guideSearchPlaceholder} />\n          </div>\n\n          <div className=\"card\" style={{ padding: \'16px\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-docs\')}>\n            <strong style={{ fontSize: \'0.9rem\' }}>{t.guideDoc1Title}</strong>\n            <p style={{ fontSize: \'0.78rem\', color: \'var(--text-muted)\', marginTop: \'4px\' }}>{t.guideDoc1Desc}</p>\n          </div>\n\n          <div className=\"card\" style={{ padding: \'16px\', cursor: \'pointer\' }} onClick={() => navigate(\'screen-docs\')}>\n            <strong style={{ fontSize: \'0.9rem\' }}>{t.guideDoc2Title}</strong>\n            <p style={{ fontSize: \'0.78rem\', color: \'var(--text-muted)\', marginTop: \'4px\' }}>{t.guideDoc2Desc}</p>\n          </div>\n\n          <div className=\"card-dark\" style={{ cursor: \'pointer\' }} onClick={() => navigate(\'screen-perfil\')}>\n            <span className=\"eyebrow\" style={{ color: \'#A8BDB2\' }}>{t.guideAccountEyebrow}</span>\n            <h3 className=\"serif-title\" style={{ fontSize: \'1.45rem\', marginBottom: \'6px\' }}>{t.guideAccountTitle}</h3>\n            <p style={{ fontSize: \'0.8rem\', color: \'#D4DFD9\', marginBottom: \'14px\' }}>{t.guideAccountDesc}</p>\n            <div style={{ background: \'#F7F1DC\', color: \'#5C4D26\', padding: \'10px 14px\', borderRadius: \'10px\', fontSize: \'0.76rem\', fontWeight: 600, textAlign: \'center\' }}>\n              {t.guideAccountBanner}\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* TELA 10: PERFIL DO USU\303\201RIO */}\n      {currentScreen === \'screen-perfil\' && (\n        <section id=\"screen-perfil\" className=\"screen\" style={{ padding: 0 }}>\n          <div style={{ background: \'var(--bg-mint)\', padding: \'28px 20px\', textAlign: \'center\' }}>\n            <div style={{ width: \'68px\', height: \'68px\', background: \'var(--primary-green)\', color: \'white\', borderRadius: \'50%\', display: \'flex\', alignItems: \'center\', justifyContent: \'center\', fontSize: \'1.4rem\', fontWeight: 700, margin: \'0 auto 12px\' }}>\n              PA\n            </div>\n            <h3 style={{ fontSize: \'1.1rem\' }}>Paula Andrades Gomes Oliveira</h3>\n            <p style={{ fontSize: \'0.8rem\', color: \'var(--text-muted)\' }}>paula.andrade@exemplo.com</p>\n          </div>\n\n          <div style={{ padding: \'20px\', display: \'flex\', flexDirection: \'column\', gap: \'16px\' }}>\n            <div className=\"card\">\n              <span className=\"eyebrow\" style={{ marginBottom: \'12px\' }}>{t.profileInfoEyebrow}</span>\n              <div className=\"form-group\">\n                <label>{t.profileNameLabel}</label>\n                <input type=\"text\" defaultValue=\"Paula Andrades Gomes oliveira\" />\n              </div>\n              <div className=\"form-group\">\n                <label>{t.profileEmailLabel}</label>\n                <input type=\"email\" defaultValue=\"paula.andrade@exemplo.com\" />\n              </div>\n              <div className=\"form-group\">\n                <label>{t.profileDocLabel}</label>\n                <input type=\"text\" defaultValue=\"25478.578.567\" />\n              </div>\n              <div className=\"form-group\">\n                <label>{t.profileCompanyLabel}</label>\n                <input type=\"text\" placeholder={t.profileCompanyPlaceholder} />\n              </div>\n              <div className=\"form-group\" style={{ margin: 0 }}>\n                <label>{t.profileLocLabel}</label>\n                <input type=\"text\" defaultValue=\"S\303\243o Paulo, Brasil\" />\n              </div>\n            </div>\n\n            <div className=\"card\">\n              <span className=\"eyebrow\">{t.profileQuickEyebrow}</span>\n              <div className=\"list-row\" style={{ padding: \'10px 0\', cursor: \'default\', flexWrap: \'wrap\', gap: \'10px\' }}>\n                <span>{t.profileChangeLang}</span>\n                <div style={{ display: \'flex\', gap: \'8px\' }}>\n                  <button\n                    type=\"button\"\n                    onClick={() => setLang(\'pt\')}\n                    style={{\n                      padding: \'8px 14px\',\n                      borderRadius: \'10px\',\n                      border: lang === \'pt\' ? \'1px solid var(--primary-dark)\' : \'1px solid var(--border-light)\',\n                      background: lang === \'pt\' ? \'var(--primary-dark)\' : \'#FFFFFF\',\n                      color: lang === \'pt\' ? \'#FFFFFF\' : \'var(--primary-dark)\',\n                      fontSize: \'0.8rem\',\n                      fontWeight: 600,\n                      cursor: \'pointer\'\n                    }}\n                  >\n                    {t.btnPortuguese}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setLang(\'es\')}\n                    style={{\n                      padding: \'8px 14px\',\n                      borderRadius: \'10px\',\n                      border: lang === \'es\' ? \'1px solid var(--primary-dark)\' : \'1px solid var(--border-light)\',\n                      background: lang === \'es\' ? \'var(--primary-dark)\' : \'#FFFFFF\',\n                      color: lang === \'es\' ? \'#FFFFFF\' : \'var(--primary-dark)\',\n                      fontSize: \'0.8rem\',\n                      fontWeight: 600,\n                      cursor: \'pointer\'\n                    }}\n                  >\n                    {t.btnSpanish}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n\n      {/* FOOTER */}\n      <footer className=\"app-footer\">\n        <h4>BRAPEX</h4>\n        <p>{t.footerText}</p>\n      </footer>\n\n    </div>\n  );\n}\n"
