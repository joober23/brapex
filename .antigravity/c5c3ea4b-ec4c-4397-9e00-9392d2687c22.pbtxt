              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    function calcularFrete() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const peso = parseFloat(document.getElementById(\'frete-peso\').value) || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const res = document.getElementById(\'frete-resultado\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (peso <= 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            alert(\'Informe o peso da encomenda.\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            return;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const estimativa = (peso * 1.45 + 320).toFixed(2).replace(\'.\', \',\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        res.classList.remove(\'hidden\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        res.innerHTML = `<strong>Estimativa de Frete Internacional:</strong> R$ ${estimativa} <br><span style=\"font-size:0.75rem; color:#5C6660;\">Prazo estimado: 5 a 7 dias \303\272teis (Modal Rodovi\303\241rio/Aduaneiro).</span>`;"
