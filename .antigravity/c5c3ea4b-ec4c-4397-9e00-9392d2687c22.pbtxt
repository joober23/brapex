 \'Use este checklist como apoio para estruturar a documenta\303\247\303\243o de uma opera\303\247\303\243o de exporta\303\247\303\243o ou importa\303\247\303\243o.\',\\n            \'Checklist da opera\303\247\303\243o\': \'Checklist da opera\303\247\303\243o\',\\n            \'Qual produto voc\303\252 deseja exportar/importar?\': \'Qual produto voc\303\252 deseja exportar/importar?\',\\n            \'Confirmar Produto\': \'Confirmar Produto\',\\n            \'FLUXO DOCUMENTAL DEMONSTRATIVO\': \'FLUXO DOCUMENTAL DEMONSTRATIVO\',\\n            \'Processo de Exporta\303\247\303\243o \342\200\224 Item: Ferro / Insumos\': \'Processo de Exporta\303\247\303\243o \342\200\224 Item: Ferro / Insumos\',\\n            \'C\303\263digo NCM Vinculado: 7200.00.00\': \'C\303\263digo NCM Vinculado: 7200.00.00\',\\n            \'Quantidade para Exporta\303\247\303\243o ou Importa\303\247\303\243o (kg)\': \'Quantidade para Exporta\303\247\303\243o ou Importa\303\247\303\243o (kg)\',\\n            \'Pa\303\255s de Origem do produto\': \'Pa\303\255s de Origem do produto\',\\n            \'Pa\303\255s de destino\': \'Pa\303\255s de destino\',\\n            \'Invoice Comercial\': \'Invoice Comercial\',\\n            \'Certificado de Origem\': \'Certificado de Origem\',\\n            \'Certificado de Qualidade\': \'Certificado de Qualidade\',\\n            \'Pendente\': \'Pendente\',\\n            \'Anexado\': \'Anexado\',\\n            \'Nenhum arquivo selecionado\': \'Nenhum arquivo selecionado\',\\n            \'Anexar arquivo\': \'Anexar arquivo\',\\n            \'Conclu\303\255do\': \'Conclu\303\255do\',\\n            \'IR PARA PAGAMENTO (GOV.BR)\': \'IR PARA PAGAMENTO (GOV.BR)\',\\n            \'Pagamento\': \'Pagamento\',\\n            \'Resumo do valor\': \'Resumo do valor\',\\n            \'Taxa de Exporta\303\247\303\243o\': \'Taxa de Exporta\303\247\303\243o\',\\n            \'Taxa de Servi\303\247o\': \'Taxa de Servi\303\247o\',\\n            \'Boleto Banc\303\241rio\': \'Bole