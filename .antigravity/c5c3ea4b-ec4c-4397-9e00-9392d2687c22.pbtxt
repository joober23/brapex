            }
            lines {
              text: "        {/* Currency Converter Inputs Grid */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <div className=\"grid grid-cols-1 md:grid-cols-11 gap-4 items-center\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          {/* Input 1 (BRL or PEN) */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <div className=\"md:col-span-5 bg-[#FBFBF9] border border-[#E2DFD8] rounded-xl p-4 focus-within:border-[#1A3026] focus-within:ring-1 focus-within:ring-[#1A3026] transition-all\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div className=\"flex items-center justify-between text-xs text-[#697E72] mb-1\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <span>{direction === \'BRL_TO_PEN\' ? \'Voc\303\252 envia / Converte (Real)\' : \'Voc\303\252 envia / Converte (Sol Peruano)\'}</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <span className=\"font-semibold\">{direction === \'BRL_TO_PEN\' ? \'BRL (R$)\' : \'PEN (S/)\'}</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div className=\"flex items-center gap-2\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <span className=\"font-display text-xl text-[#1A3026] font-bold\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                {direction === \'BRL_TO_PEN\' ? \'R$\' : \'S/\'}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <input"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                type=\"number\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                value={direction === \'BRL_TO_PEN\' ? brlAmount : solAmount}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                onChange={(e) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  const val = e.target.value;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  if (direction === \'BRL_TO_PEN\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    setBrlAmount(val);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    const n = parseFloat(val) || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    setSolAmount((n * exchangeRate).toFixed(2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    setSolAmount(val);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    const n = parseFloat(val) || 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    setBrlAmount((n / exchangeRate).toFixed(2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                }}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                className=\"w-full bg-transparent text-2xl font-mono-num font-bold text-[#1A3026] outline-none\""
