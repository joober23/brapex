      thinking_signature: "\022\332\005\n\327\005\001i\024}\023\347\303*\327DI\346\034\360\001\264\366T}\374\016\225)\202T\363S\200\220@N_\324\275\211\227\214\024\202n\004HB\306$\243\300\202\v\346\215v\033u\347\225\203H\251\307\365Z^\375]*Fx\373k!\025u-K\263\v\235u|Bh\304\b\365\3240\364\025\275j\272;\256\217\b^\326\202\276\251k\361*\335\306\031!%9\210\3271Vdo\301\016\343\026\367$7\325\f\355\357\206A\242\300\346Z,\346\226;\001:\230\203\255a\223Q\254\2306`!\350\222\304\364\241F\000\310p\340\201\307\207|\376g\322+\030\270\003\243\333\224\265\031\316\310\025\035\00177\375,2s\225\200\253\265\350\023\352\314\361\302\215lPM\354#f\325\031t\300\303j\215e\220\b\320-\204\265\223\275\350;\360U}a\263\277\351@bG\221\302v\231\277C\246Y9O]Zf\300\231\331\372\t\365x\027\3551\317\nR\310rt&\376/A\230\205,\212N\a6\252\275\301y\027+\334\273;\r\375\273\302\303bM\202\341Qo\023\255\211\203[\271\243\314k\317\020\335e*d\216\032\274\375\266{\200\225\261\302\244v\253?\237r0\333u7\245\036\201\343\2168\361O\275\306=\205\037|pY\323\374\333\250\035\221MY_2\220\201\336p*\206O\254\254\b \317\306\2327\313\374@z\373u\356L\006M\316\306\v\234u\257\356\362\274\b\336Uq\305P.8\265\206\315.\311v~\304m\\Y]4\324\a\370\253E\335\344\234\r\316\025\263\357\006\273z\266\017M\321\036\367\021\034\020\020\020rH>\302\261\036\t\370\245\375\a\326\004\343\326\312\365\026@\n\345\316\250\321\244\201\225_\235\362y(Hnk\006lrBG\267\352\352\330\2029\343\341!\"\'T\"\212R\252K\344@;\267\035V\317\217\252#\216k[\024aE\315\213\357b6)\271\330\227^\330%\301N@\242\304\360\202\353\312G\272\360Z\202\024\003D\224\341g\265\026\025\263-8\000 \276\216?=\357\264\321\216\332\212k\346-\362\225\232Q\353\347>\244m\242\016\256\340I \302\034\363\227\315T\256\226\273N0\271{\333\000y\260\251C[\337\352X\3349it\\\tf\252\305\241\230}36\r\232\205\346\"\016T\031\336\221\315\3541\364^9\363\330\246\324\342\305\265\325\027\334\333}\360\365T\005\353\302\355F!\255i\265\347LB\362l\351&?\331,\242\341I6X1\356wr\350\021\245h\027 \276\212\243\312\366cwhl\365\374\231\343\027\rz\327\373B\331\266W\302\341\350j0+\vo\b\vg\236~\215 \032\370J\255\347}\'S\030}H\253"
