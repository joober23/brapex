  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { HeaderNav } from \'./components/HeaderNav\';\nimport { HeroLogin } from \'./components/HeroLogin\';\nimport { DashboardView } from \'./components/DashboardView\';\nimport { ProductsQuotationsView } from \'./components/ProductsQuotationsView\';\nimport { DocumentExportWorkflow, ExportWorkflowData } from \'./components/DocumentExportWorkflow\';\nimport { PaymentPixView } from \'./components/PaymentPixView\';\nimport { TrackingLogisticsView } from \'./components/TrackingLogisticsView\';\nimport { ChatbotWidget } from \'./components/ChatbotWidget\';\nimport { NcmLookupModal } from \'./components/NcmLookupModal\';\nimport { FreightSimulatorModal } from \'./components/FreightSimulatorModal\';\nimport { HelpModal, ContactModal, ExportHtmlModal } from \'./components/HelpContactModals\';\nimport { PRODUCTS_CATALOG, ProductItem } from \'./data/mockData\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<string>(\'login\');\n  const [isLoggedIn, setIsLoggedIn] = useState<boolean>(false);\n  const [userName, setUserName] = useState<string>(\'Larissa Ferreira\');\n  const [selectedProduct, setSelectedProduct] = useState<ProductItem>(PRODUCTS_CATALOG[0]);\n  const [workflowData, setWorkflowData] = useState<ExportWorkflowData | undefined>(undefined);\n  const [activeTrackingCode, setActiveTrackingCode] = useState<string>(\'BRAPEX2026\');\n\n  // Modals\n  const [isNcmModalOpen, setIsNcmModalOpen] = useState(false);\n  const [ncmInitialQuery, setNcmInitialQuery] = useState(\'\');\n  const [isFreightModalOpen, setIsFreightModalOpen] = useState(false);\n  const [isHelpModalOpen, setIsHelpModalOpen] = useState(false);\n  const [isContactModalOpen, setIsContactModalOpen] = useState(false);\n  const [isExportHtmlModalOpen, setIsExportHtmlModalOpen] = useState(false);\n\n  // Toast banner\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  const showToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => setToastMessage(null), 3500);\n  };\n\n  const handleLoginSuccess = (name: string) => {\n    setIsLoggedIn(true);\n    setUserName(name);\n    setActiveTab(\'dashboard\');\n    showToast(`Autenticado com sucesso via Gov.br como ${name}!`);\n  };\n\n  const handleLogout = () => {\n    setIsLoggedIn(false);\n    setActiveTab(\'login\');\n    showToast(\'Sess\303\243o encerrada com seguran\303\247a.\');\n  };\n\n  const handleSelectProductForWorkflow = (product: ProductItem) => {\n    setSelectedProduct(product);\n    setActiveTab(\'workflow\');\n    showToast(`Item \"${product.name}\" vinculado ao fluxo de exporta\303\247\303\243o.`);\n  };\n\n  const handleProceedToPayment = (data: ExportWorkflowData) => {\n    setWorkflowData(data);\n    setActiveTab(\'payment\');\n    showToast(\'Guia de taxas aduaneiras Gov.br gerada com sucesso.\');\n  };\n\n  const handlePaymentSuccess = (trackingCode: string) => {\n    setActiveTrackingCode(trackingCode);\n    setActiveTab(\'tracking\');\n    showToast(`Pagamento de R$ 245,00 confirmado! Despacho alfandeg\303\241rio autorizado (${trackingCode}).`);\n  };\n\n  const handleOpenNcmDetails = (ncm: string) => {\n    setNcmInitialQuery(ncm);\n    setIsNcmModalOpen(true);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#F9F8F6] text-[#1A3026] flex flex-col selection:bg-[#1A3026] selection:text-white\">\n      \n      {/* Toast Notification */}\n      {toastMessage && (\n        <div className=\"fixed top-20 right-4 z-50 bg-[#1A3026] text-white py-2.5 px-4 rounded-xl shadow-2xl border border-emerald-500/40 text-xs font-semibold flex items-center gap-2 animate-in fade-in slide-in-from-top-3 duration-200\">\n          <div className=\"w-2 h-2 rounded-full bg-emerald-400\" />\n          <span>{toastMessage}</span>\n        </div>\n      )}\n\n      {/* Top Header Navigation */}\n      <HeaderNav\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        isLoggedIn={isLoggedIn}\n        userName={userName}\n        onLoginClick={() => setActiveTab(\'login\')}\n        onLogoutClick={handleLogout}\n        onOpenHelp={() => setIsHelpModalOpen(true)}\n        onOpenContact={() => setIsContactModalOpen(true)}\n        onOpenExportHtml={() => setIsExportHtmlModalOpen(true)}\n      />\n\n      {/* Main Viewport Content */}\n      <main className=\"flex-1\">\n        {/* Tela 1: Entrada / Login */}\n        {activeTab === \'login\' && (\n          <HeroLogin\n            onLoginSuccess={handleLoginSuccess}\n            onOpenHelp={() => setIsHelpModalOpen(true)}\n            onOpenContact={() => setIsContactModalOpen(true)}\n          />\n        )}\n\n        {/* Telas Autenticadas / Painel */}\n        {activeTab !== \'login\' && (\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n            \n            {/* Tela 2: Painel Principal / Dashboard */}\n            {activeTab === \'dashboard\' && (\n              <DashboardView\n                userName={userName}\n                onNavigate={(tab) => setActiveTab(tab)}\n                onOpenNcmModal={() => setIsNcmModalOpen(true)}\n                onOpenFreightModal={() => setIsFreightModalOpen(true)}\n                onSelectItemForExport={(id) => {\n                  const p = PRODUCTS_CATALOG.find((item) => item.id === id);\n                  if (p) handleSelectProductForWorkflow(p);\n                }}\n              />\n            )}\n\n            {/* Tela 3: Se\303\247\303\243o de Produtos de Exporta\303\247\303\243o e Cota\303\247\303\265es */}\n            {activeTab === \'products\' && (\n              <ProductsQuotationsView\n                onSelectProductForWorkflow={handleSelectProductForWorkflow}\n                onOpenNcmDetails={handleOpenNcmDetails}\n              />\n            )}\n\n            {/* Tela 4: Fluxo Documental e Processo de Exporta\303\247\303\243o */}\n            {activeTab === \'workflow\' && (\n              <DocumentExportWorkflow\n                selectedProduct={selectedProduct}\n                onProceedToPayment={handleProceedToPayment}\n                onOpenNcmDetails={handleOpenNcmDetails}\n              />\n            )}\n\n            {/* Tela 5: Se\303\247\303\243o de Pagamento e Simula\303\247\303\243o Pix */}\n            {activeTab === \'payment\' && (\n              <PaymentPixView\n                workflowData={workflowData}\n                onPaymentSuccess={handlePaymentSuccess}\n                onBackToWorkflow={() => setActiveTab(\'workflow\')}\n              />\n            )}\n\n            {/* Tela 6: Rastreamento e Log\303\255stica em Tempo Real */}\n            {activeTab === \'tracking\' && (\n              <TrackingLogisticsView\n                initialCode={activeTrackingCode}\n                onOpenHelp={() => setIsHelpModalOpen(true)}\n              />\n            )}\n          </div>\n        )}\n      </main>\n\n      {/* Institutional Footer */}\n      {activeTab !== \'login\' && (\n        <footer className=\"bg-[#14261E] text-[#B5C9BD] border-t border-[#234233] py-8 mt-12 text-xs\">\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4\">\n            <div className=\"flex items-center gap-3\">\n              <span className=\"font-display font-bold text-white text-base\">BRAPEX</span>\n              <span>\302\267</span>\n              <span>Portal de Opera\303\247\303\265es de Com\303\251rcio Exterior</span>\n              <span>\302\267</span>\n              <span>Sudoeste Paulista & Peru</span>\n            </div>\n\n            <div className=\"flex items-center gap-6\">\n              <button\n                onClick={() => setIsExportHtmlModalOpen(true)}\n                className=\"hover:text-white transition-colors underline\"\n              >\n                Baixar C\303\263digo em Arquivo \303\232nico (HTML)\n              </button>\n              <button\n                onClick={() => setIsHelpModalOpen(true)}\n                className=\"hover:text-white transition-colors\"\n              >\n                Central de Ajuda\n              </button>\n              <button\n                onClick={() => setIsContactModalOpen(true)}\n                className=\"hover:text-white transition-colors\"\n              >\n                Distrito Industrial Itapetininga/SP\n              </button>\n            </div>\n          </div>\n        </footer>\n      )}\n\n      {/* Floating Chatbot Widget (Always available) */}\n      <ChatbotWidget />\n\n      {/* Modals */}\n      <NcmLookupModal\n        isOpen={isNcmModalOpen}\n        onClose={() => setIsNcmModalOpen(false)}\n        initialQuery={ncmInitialQuery}\n        onSelectNcm={(ncm) => {\n          showToast(`NCM ${ncm} selecionado.`);\n        }}\n      />\n\n      <FreightSimulatorModal\n        isOpen={isFreightModalOpen}\n        onClose={() => setIsFreightModalOpen(false)}\n      />\n\n      <HelpModal\n        isOpen={isHelpModalOpen}\n        onClose={() => setIsHelpModalOpen(false)}\n      />\n\n      <ContactModal\n        isOpen={isContactModalOpen}\n        onClose={() => setIsContactModalOpen(false)}\n      />\n\n      <ExportHtmlModal\n        isOpen={isExportHtmlModalOpen}\n        onClose={() => setIsExportHtmlModalOpen(false)}\n      />\n\n    </div>\n  );\n}\n"
