        use_fast_apply: true
        replacement_chunks {
          target_content: "  // Conversor de Moedas\n  const [brlVal, setBrlVal] = useState<string>(\'100\');\n  const [penVal, setPenVal] = useState<string>(\'68,00 S/.\');\n  const [brlParaPen, setBrlParaPen] = useState<boolean>(true);"
          replacement_content: "  // Conversor de Moedas\n  const [fxRate, setFxRate] = useState<number>(0.68);\n  const [isLiveRate, setIsLiveRate] = useState<boolean>(false);\n  const [brlVal, setBrlVal] = useState<string>(\'100\');\n  const [penVal, setPenVal] = useState<string>(\'68,00 S/.\');\n  const [brlParaPen, setBrlParaPen] = useState<boolean>(true);\n  const [fxConvertedResult, setFxConvertedResult] = useState<{ from: string; to: string; valid: boolean } | null>(null);"
          start_line: 11
          end_line: 16
        }
        replacement_chunks {
          target_content: "  // Fun\303\247\303\265es de C\303\242mbio\n  const handleBrlChange = (valStr: string) => {\n    setBrlVal(valStr);\n    const val = parseFloat(valStr) || 0;\n    if (brlParaPen) {\n      setPenVal((val * 0.68).toFixed(2).replace(\'.\', \',\') + \' S/.\');\n    } else {\n      setPenVal(\'R$ \' + (val / 0.68).toFixed(2).replace(\'.\', \',\'));\n    }\n  };\n\n  const inverterMoeda = () => {\n    const nextMode = !brlParaPen;\n    setBrlParaPen(nextMode);\n    const val = parseFloat(brlVal) || 0;\n    if (nextMode) {\n      setPenVal((val * 0.68).toFixed(2).replace(\'.\', \',\') + \' S/.\');\n    } else {\n      setPenVal(\'R$ \' + (val / 0.68).toFixed(2).replace(\'.\', \',\'));\n    }\n  };\n\n  const converterMoeda = () => {\n    const val = parseFloat(brlVal) || 0;\n    if (brlParaPen) {\n      setPenVal((val * 0.68).toFixed(2).replace(\'.\', \',\') + \' S/.\');\n    } else {\n      setPenVal(\'R$ \' + (val / 0.68).toFixed(2).replace(\'.\', \',\'));\n    }\n  };"
          replacement_content: "  const parseCurrencyAmount = (raw: string): number => {\n    const cleaned = raw.trim().replace(/[^\\d.,]/g, \'\');\n    if (!cleaned) return 0;\n    if (cleaned.includes(\',\') && cleaned.includes(\'.\')) {\n      if (cleaned.lastIndexOf(\',\') > cleaned.lastIndexOf(\'.\')) {\n        return parseFloat(cleaned.replace(/\\./g, \'\').replace(\',\', \'.\')) || 0;\n      }\n      return parseFloat(cleaned.replace(/,/g, \'\')) || 0;\n    }\n    if (cleaned.includes(\',\')) {\n      return parseFloat(cleaned.replace(\',\', \'.\')) || 0;\n    }\n    return parseFloat(cleaned) || 0;\n  };\n\n  const formatBrNumber = (num: number, decimals = 2): string =>\n    num.toLocaleString(\'pt-BR\', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });\n\n  const formatConvertedOutput = (val: number, isBrlToPen: boolean, rate: number): string => {\n    if (isBrlToPen) {\n      return `${formatBrNumber(val * rate)} S/.`;\n    }\n    return `R$ ${formatBrNumber(val / rate)}`;\n  };\n\n  useEffect(() => {\n    let active = true;\n    const loadRate = async () => {\n      try {\n        const res = await fetch(\'https://open.er-api.com/v6/latest/BRL\');\n        if (res.ok) {\n          const data = await res.json();\n          const pen = Number(data?.rates?.PEN);\n          if (active && Number.isFinite(pen) && pen > 0) {\n            setFxRate(pen);\n            setIsLiveRate(true);\n            setPenVal(formatConvertedOutput(parseCurrencyAmount(brlVal), brlParaPen, pen));\n            return;\n          }\n        }\n      } catch {\n        // fallback below\n      }\n      try {\n        const res2 = await fetch(\'https://economia.awesomeapi.com.br/json/last/BRL-PEN\');\n        if (res2.ok) {\n          const data2 = await res2.json();\n          const pen2 = Number(data2?.BRLPEN?.bid);\n          if (active && Number.isFinite(pen2) && pen2 > 0) {\n            setFxRate(pen2);\n            setIsLiveRate(true);\n            setPenVal(formatConvertedOutput(parseCurrencyAmount(brlVal), brlParaPen, pen2));\n          }\n        }\n      } catch {\n        // keep reference rate 0.68\n      }\n    };\n    loadRate();\n    return () => { active = false; };\n  }, []);\n\n  // Fun\303\247\303\265es de C\303\242mbio\n  const handleBrlChange = (valStr: string) => {\n    setBrlVal(valStr);\n    const val = parseCurrencyAmount(valStr);\n    setPenVal(formatConvertedOutput(val, brlParaPen, fxRate));\n    if (fxConvertedResult) {\n      if (val > 0) {\n        const fromText = brlParaPen ? `R$ ${formatBrNumber(val)}` : `S/. ${formatBrNumber(val)}`;\n        const toText = formatConvertedOutput(val, brlParaPen, fxRate);\n        setFxConvertedResult({ from: fromText, to: toText, valid: true });\n      } else {\n        setFxConvertedResult({ from: \'\', to: \'\', valid: false });\n      }\n    }\n  };\n\n  const inverterMoeda = () => {\n    const nextMode = !brlParaPen;\n    setBrlParaPen(nextMode);\n    const val = parseCurrencyAmount(brlVal);\n    const nextOut = formatConvertedOutput(val, nextMode, fxRate);\n    setPenVal(nextOut);\n    if (fxConvertedResult && val > 0) {\n      const fromText = nextMode ? `R$ ${formatBrNumber(val)}` : `S/. ${formatBrNumber(val)}`;\n      setFxConvertedResult({ from: fromText, to: nextOut, valid: true });\n    }\n  };\n\n  const converterMoeda = () => {\n    const val = parseCurrencyAmount(brlVal);\n    if (val <= 0) {\n      setPenVal(brlParaPen ? \'0,00 S/.\' : \'R$ 0,00\');\n      setFxConvertedResult({ from: \'\', to: \'\', valid: false });\n      return;\n    }\n    const converted = formatConvertedOutput(val, brlParaPen, fxRate);\n    setPenVal(converted);\n    const fromText = brlParaPen ? `R$ ${formatBrNumber(val)}` : `S/. ${formatBrNumber(val)}`;\n    setFxConvertedResult({ from: fromText, to: converted, valid: true });\n  };"
          start_line: 73
          end_line: 104
        }
        replacement_chunks {
          target_content: "          <div className=\"card-dark\">\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', marginBottom: \'6px\' }}>\n              <span className=\"eyebrow\" style={{ color: \'#A8BDB2\', margin: 0 }}>{t.fxTag}</span>\n              <span style={{ background: \'#FFFFFF\', color: \'var(--primary-dark)\', fontSize: \'0.65rem\', fontWeight: 800, padding: \'4px 10px\', borderRadius: \'20px\' }}>{t.fxBadge}</span>\n            </div>\n            <h3 style={{ fontSize: \'1.1rem\', marginBottom: \'4px\' }}>{t.fxTitle}</h3>\n            <p style={{ fontSize: \'0.8rem\', color: \'#D4DFD9\', marginBottom: \'14px\' }}>{t.fxSub}</p>\n            <div style={{ display: \'flex\', alignItems: \'center\', gap: \'8px\', marginBottom: \'12px\' }}>\n              <input type=\"number\" id=\"input-brl\" value={brlVal} onChange={(e) => handleBrlChange(e.target.value)} placeholder=\"0,00\" />\n              <button onClick={inverterMoeda} style={{ background: \'#EAE7DF\', border: \'none\', borderRadius: \'10px\', padding: \'10px\', cursor: \'pointer\', fontWeight: \'bold\' }}>\342\207\204</button>\n              <input type=\"text\" id=\"output-pen\" value={penVal} readOnly style={{ background: \'#F4F4F4\' }} />\n            </div>\n            <button className=\"btn-outline\" style={{ width: \'100%\', border: \'none\' }} onClick={converterMoeda}>{t.fxBtn}</button>\n            <p style={{ fontSize: \'0.7rem\', color: \'#A8BDB2\', marginTop: \'10px\' }}>{t.fxNote}</p>\n          </div>"
          replacement_content: "          <div className=\"card-dark\">\n            <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', marginBottom: \'6px\' }}>\n              <span className=\"eyebrow\" style={{ color: \'#A8BDB2\', margin: 0 }}>{t.fxTag}</span>\n              <span style={{ background: \'#FFFFFF\', color: \'var(--primary-dark)\', fontSize: \'0.65rem\', fontWeight: 800, padding: \'4px 10px\', borderRadius: \'20px\' }}>\n                {isLiveRate ? t.fxBadgeLive : t.fxBadge}\n              </span>\n            </div>\n            <h3 style={{ fontSize: \'1.1rem\', marginBottom: \'4px\' }}>{t.fxTitle}</h3>\n            <p style={{ fontSize: \'0.8rem\', color: \'#D4DFD9\', marginBottom: \'14px\' }}>\n              {brlParaPen\n                ? `1 R$ = ${formatBrNumber(fxRate, isLiveRate ? 4 : 2)} S/.`\n                : `1 S/. = R$ ${formatBrNumber(1 / fxRate, isLiveRate ? 4 : 2)}`}\n              {\' \302\267 \'}\n              {isLiveRate ? t.fxSubLive : t.fxSub}\n            </p>\n            <div style={{ display: \'grid\', gridTemplateColumns: \'1fr auto 1fr\', gap: \'8px\', alignItems: \'end\', marginBottom: \'12px\' }}>\n              <div>\n                <span style={{ display: \'block\', fontSize: \'0.7rem\', color: \'#A8BDB2\', marginBottom: \'4px\', fontWeight: 600 }}>\n                  {brlParaPen ? t.fxFromReal : t.fxFromSol}\n                </span>\n                <input\n                  type=\"text\"\n                  inputMode=\"decimal\"\n                  id=\"input-brl\"\n                  value={brlVal}\n                  onChange={(e) => handleBrlChange(e.target.value)}\n                  onKeyDown={(e) => { if (e.key === \'Enter\') converterMoeda(); }}\n                  placeholder=\"0,00\"\n                />\n              </div>\n              <button\n                type=\"button\"\n                onClick={inverterMoeda}\n                title=\"Inverter moedas\"\n                style={{ background: \'#EAE7DF\', border: \'none\', borderRadius: \'10px\', padding: \'12px 10px\', cursor: \'pointer\', fontWeight: \'bold\', height: \'44px\' }}\n              >\n                \342\207\204\n              </button>\n              <div>\n                <span style={{ display: \'block\', fontSize: \'0.7rem\', color: \'#A8BDB2\', marginBottom: \'4px\', fontWeight: 600 }}>\n                  {brlParaPen ? t.fxToSol : t.fxToReal}\n                </span>\n                <input type=\"text\" id=\"output-pen\" value={penVal} readOnly style={{ background: \'#F4F4F4\', fontWeight: 700 }} />\n              </div>\n            </div>\n            <button type=\"button\" className=\"btn-outline\" style={{ width: \'100%\', border: \'none\' }} onClick={converterMoeda}>\n              {t.fxBtn}\n            </button>\n            {fxConvertedResult && (\n              <div\n                style={{\n                  marginTop: \'12px\',\n                  padding: \'12px 14px\',\n                  borderRadius: \'12px\',\n                  background: fxConvertedResult.valid ? \'rgba(230, 236, 231, 0.14)\' : \'rgba(253, 240, 230, 0.14)\',\n                  border: fxConvertedResult.valid ? \'1px solid rgba(168, 189, 178, 0.45)\' : \'1px solid rgba(255, 190, 140, 0.45)\',\n                  fontSize: \'0.84rem\',\n                  color: \'#FFFFFF\'\n                }}\n              >\n                {fxConvertedResult.valid ? (\n                  <div style={{ display: \'flex\', justifyContent: \'space-between\', alignItems: \'center\', gap: \'8px\', flexWrap: \'wrap\' }}>\n                    <span style={{ color: \'#D4DFD9\', fontSize: \'0.76rem\' }}>\n                      {brlParaPen ? t.fxResultLabel : t.fxResultLabelBrl}\n                    </span>\n                    <strong style={{ fontSize: \'0.96rem\', color: \'#FFFFFF\' }}>\n                      {fxConvertedResult.from} = {fxConvertedResult.to}\n                    </strong>\n                  </div>\n                ) : (\n                  <span style={{ color: \'#FFD8B8\', fontSize: \'0.78rem\', fontWeight: 600 }}>{t.fxEnterValid}</span>\n                )}\n              </div>\n            )}\n            <p style={{ fontSize: \'0.7rem\', color: \'#A8BDB2\', marginTop: \'10px\' }}>\n              {isLiveRate ? t.fxNoteLive : t.fxNote}\n            </p>\n          </div>"
