            }
            lines {
              text: "            if (trimmed && dict[trimmed]) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                node.nodeValue = raw.replace(trimmed, dict[trimmed]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
