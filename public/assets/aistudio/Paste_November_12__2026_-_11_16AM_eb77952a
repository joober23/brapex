<script>
    let docsAnexados = 0;
    let brlParaPen = true;

    function navigate(screenId) {
        document.querySelectorAll('.app-shell > section').forEach(sec => sec.classList.add('hidden'));
        document.getElementById(screenId).classList.remove('hidden');
        document.getElementById('nav-menu').classList.add('hidden');

        const navbar = document.getElementById('main-navbar');
        if (screenId === 'screen-login') {
            navbar.classList.add('hidden');
        } else {
            navbar.classList.remove('hidden');
        }
        window.scrollTo(0, 0);
    }

    function toggleMenu() {
        document.getElementById('nav-menu').classList.toggle('hidden');
    }

    function converterMoeda() {
        const val = parseFloat(document.getElementById('input-brl').value) || 0;
        const result = brlParaPen ? (val * 0.68).toFixed(2) + ' S/.' : 'R$ ' + (val / 0.68).toFixed(2);
        document.getElementById('output-pen').value = result.replace('.', ',');
    }

    function inverterMoeda() {
        brlParaPen = !brlParaPen;
        converterMoeda();
    }

    function setFluxo(btn) {
        btn.parentElement.querySelectorAll('.pill-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    function anexarDoc(num, nomeArquivo) {
        const fileEl = document.getElementById('file-' + num);
        const badgeEl = document.getElementById('badge-' + num);
        if (fileEl.innerText === 'Nenhum arquivo selecionado') {
            fileEl.innerText = nomeArquivo;
            badgeEl.innerText = 'Anexado';
            badgeEl.style.background = '#E6F2EB';
            badgeEl.style.color = '#2B4C3B';
            docsAnexados++;
            document.getElementById('doc-counter').innerText = docsAnexados + ' de 3 documentos anexados';
            if (docsAnexados === 3) {
                const glob = document.getElementById('doc-global-status');
                glob.innerText = 'Concluído';
                glob.style.background = '#E6F2EB';
                glob.style.color = '#2B4C3B';
            }
        }
    }

    function calcularFrete() {
        const peso = parseFloat(document.getElementById('frete-peso').value) || 0;
        const res = document.getElementById('frete-resultado');
        if (peso <= 0) {
            alert('Informe o peso da encomenda.');
            return;
        }
        const estimativa = (peso * 1.45 + 320).toFixed(2).replace('.', ',');
        res.classList.remove('hidden');
        res.innerHTML = `<strong>Estimativa de Frete Internacional:</strong> R$ ${estimativa} <br><span style="font-size:0.75rem; color:#5C6660;">Prazo estimado: 5 a 7 dias úteis (Modal Rodoviário/Aduaneiro).</span>`;
    }

    function animarRota() {
        const truck = document.getElementById('truck-el');
        const status = document.getElementById('route-status');
        truck.style.left = '55px';
        truck.style.bottom = '45px';
        status.innerText = '● Em trânsito...';
        setTimeout(() => {
            truck.style.left = '215px';
            truck.style.bottom = '135px';
        }, 150);
        setTimeout(() => {
            status.innerText = '● Chegada ao destino (Peru)';
        }, 2300);
    }

    function enviarChat() {
        const input = document.getElementById('chat-msg-input');
        const history = document.getElementById('chat-history');
        if (!input.value.trim()) return;

        const userBubble = document.createElement('div');
        userBubble.style.cssText = 'background:#1A3026; color:white; padding:10px 12px; border-radius:12px; font-size:0.8rem; align-self:flex-end; max-width:85%;';
        userBubble.innerText = input.value;
        history.appendChild(userBubble);

        input.value = '';
        history.scrollTop = history.scrollHeight;

        setTimeout(() => {
            const botBubble = document.createElement('div');
            botBubble.style.cssText = 'background:#FFFFFF; padding:10px 12px; border-radius:12px; font-size:0.8rem; max-width:85%;';
            botBubble.innerText = 'Para operações entre o Sudoeste Paulista e o Peru, certifique-se de anexar a Invoice Comercial e o Certificado de Origem na aba Documentação.';
            history.appendChild(botBubble);
            history.scrollTop = history.scrollHeight;
        }, 600);
    }
